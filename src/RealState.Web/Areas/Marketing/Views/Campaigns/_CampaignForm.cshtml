@model CampaignFormModel
@{
    var isEdit = Model.Id != Guid.Empty;
}
<form id="modalForm" asp-area="Marketing" asp-controller="Campaigns" asp-action="Form" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="Id" />

    <div class="form-grid">
        <div class="full">
            <label asp-for="Name" class="form-label"></label> <span style="color:var(--critical)">*</span>
            <input asp-for="Name" class="form-control" placeholder="أدخل اسم الحملة" />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="Platform" class="form-label"></label> <span style="color:var(--critical)">*</span>
            <select asp-for="Platform" class="form-control" asp-items="RealState.Web.ArabicLabels.PlatformOptions(Model.Platform)"></select>
        </div>
        <div>
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" class="form-control" asp-items="RealState.Web.ArabicLabels.CampaignTypeOptions(Model.Type)"></select>
        </div>
        <div>
            <label asp-for="Objective" class="form-label"></label> <span style="color:var(--critical)">*</span>
            <select asp-for="Objective" class="form-control" asp-items="RealState.Web.ArabicLabels.ObjectiveOptions(Model.Objective)"></select>
        </div>
        <div>
            <label asp-for="Status" class="form-label"></label> <span style="color:var(--critical)">*</span>
            <select asp-for="Status" class="form-control" asp-items="RealState.Web.ArabicLabels.CampaignStatusOptions(Model.Status)"></select>
        </div>
        <div>
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" class="form-control" type="date" dir="ltr" />
        </div>
        <div>
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" class="form-control" type="date" dir="ltr" />
        </div>
        <div class="full">
            <label asp-for="Budget" class="form-label"></label>
            <input asp-for="Budget" class="form-control" type="number" step="0.01" min="0" dir="ltr" placeholder="أدخل الميزانية" />
            <span asp-validation-for="Budget" class="field-validation-error"></span>
        </div>
        <div class="full">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <button type="submit" class="btn-primary" style="margin-top:12px;">💾 @(isEdit ? "حفظ التعديلات" : "حفظ الحملة")</button>
</form>
