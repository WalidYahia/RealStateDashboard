@model List<Warehouse>
@{
    ViewData["Title"] = "المخازن";
    var canManage = User.Can(PermissionNames.InventoryManage);
}
<div class="page-head">
    <h1>المخازن</h1>
    <span style="display:flex;gap:8px;">
        <a class="btn-sm" asp-action="Print" target="_blank">🖨 طباعة (PDF)</a>
        <a class="btn-sm" asp-action="Excel">⬇ Excel</a>
        @if (canManage)
        {
            <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'مخزن جديد')">➕ مخزن جديد</button>
        }
    </span>
</div>

@if (TempData["StatusMessage"] is string status) { <div class="status-message">@status</div> }
@if (TempData["ErrorMessage"] is string err) { <div class="status-message" style="background:rgba(208,59,59,.12);border-color:var(--critical);color:var(--critical);">@err</div> }

<div class="card-tile">
    <table class="rs-table">
        <thead><tr><th>الكود</th><th>الاسم</th><th>افتراضي</th><th>الحالة</th><th></th></tr></thead>
        <tbody>
        @foreach (var w in Model)
        {
            <tr>
                <td dir="ltr" style="text-align:right;">@w.Code</td>
                <td>@w.Name</td>
                <td>@(w.IsDefault ? "✔" : "")</td>
                <td>@(w.IsActive ? "مفعّل" : "متوقف")</td>
                <td style="white-space:nowrap;">
                    @if (canManage)
                    {
                        <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = w.Id })', 'تعديل المخزن')">✏️ تعديل</button>
                        <form asp-action="Delete" asp-route-id="@w.Id" method="post" style="display:inline;" data-confirm="حذف المخزن «@w.Name»؟" data-danger>
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-sm btn-danger">حذف</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="5" style="color:var(--muted)">لا توجد مخازن بعد.</td></tr> }
        </tbody>
    </table>
</div>
