@model DocListVm
@{
    ViewData["Title"] = "أذون الاستلام";
    var canDoc = User.Can(PermissionNames.InventoryDocuments);
    var canViewInvoices = User.Can(PermissionNames.PurchaseInvoicesView);
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="page-head">
    <h1>أذون الاستلام (IN)
        <button type="button" title="شرح إذن الاستلام" onclick="appOpenModal('@Url.Action("Help")', 'شرح إذن الاستلام')" style="border:none;background:none;cursor:pointer;font-size:18px;vertical-align:middle;">❓</button>
    </h1>
    <span style="display:flex;gap:8px;">
        <a class="btn-sm" asp-action="Print" asp-route-from="@F(Model.From)" asp-route-to="@F(Model.To)" target="_blank">🖨 طباعة (PDF)</a>
        <a class="btn-sm" asp-action="Excel" asp-route-from="@F(Model.From)" asp-route-to="@F(Model.To)">⬇ Excel</a>
        @if (canDoc)
        {
            <a class="btn-new-tenant" asp-action="Create">➕ إذن استلام جديد</a>
        }
    </span>
</div>

<partial name="_DateFilter" model="Model" />

@if (TempData["StatusMessage"] is string status) { <div class="status-message">@status</div> }
@if (TempData["ErrorMessage"] is string err) { <div class="status-message" style="background:rgba(208,59,59,.12);border-color:var(--critical);color:var(--critical);">@err</div> }

<div class="card-tile">
    <table class="rs-table" id="grnTable">
        <thead><tr><th>الرقم</th><th>التاريخ</th><th>المخزن</th><th>الأسطر</th><th>الحالة</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td dir="ltr" style="text-align:right;">@r.Number</td>
                <td dir="ltr" style="text-align:right;">@r.Date.ToString("yyyy/MM/dd")</td>
                <td>@r.Warehouse</td>
                <td>@r.LineCount</td>
                <td><partial name="_StatusBadge" model="r.Status" /></td>
                <td style="white-space:nowrap;">
                    <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Details", new { id = r.Id })', 'تفاصيل إذن الاستلام')">📄</button>
                    <a class="btn-sm" asp-action="PrintOne" asp-route-id="@r.Id" target="_blank" title="طباعة إذن الاستلام">🖨</a>
                    @if (r.ReturnId is not null)
                    {
                        @* Generated by a sales return — reversed only by deleting the return. *@
                        <span title="إذن استلام تلقائي — يُدار من مرتجع المبيعات" style="font-size:12.5px;color:var(--muted);">
                            ↩ من المرتجع
                            @if (User.Can(PermissionNames.SalesReturnsView) && r.SourceLabel?.StartsWith("SR-") == true)
                            {
                                <a asp-area="Sales" asp-controller="SalesReturns" asp-action="Details" asp-route-id="@r.ReturnId" dir="ltr" style="color:var(--series-1);">@r.SourceLabel</a>
                            }
                            else
                            {
                                <span dir="ltr">@r.SourceLabel</span>
                            }
                        </span>
                    }
                    else if (r.PurchaseInvoiceId is not null)
                    {
                        @* Generated by a purchase invoice — edited/reversed only through the invoice. *@
                        <span title="إذن استلام تلقائي — يُدار من فاتورة المشتريات" style="font-size:12.5px;color:var(--muted);">
                            🧾 من الفاتورة
                            @if (canViewInvoices && r.SourceLabel?.StartsWith("PI-") == true)
                            {
                                <a asp-area="Suppliers" asp-controller="PurchaseInvoices" asp-action="Details" asp-route-id="@r.PurchaseInvoiceId" dir="ltr" style="color:var(--series-1);">@r.SourceLabel</a>
                            }
                            else
                            {
                                <span dir="ltr">@r.SourceLabel</span>
                            }
                        </span>
                    }
                    else if (canDoc && r.Status == InventoryDocStatus.Draft)
                    {
                        <a class="btn-sm" asp-action="Edit" asp-route-id="@r.Id">✏️</a>
                        <form asp-action="Post" asp-route-id="@r.Id" method="post" style="display:inline;" data-confirm="ترحيل إذن الاستلام @r.Number؟">
                            @Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-primary">ترحيل</button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" style="display:inline;" data-confirm="حذف المسودة؟" data-danger>
                            @Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">🗑</button>
                        </form>
                    }
                    else if (canDoc && r.Status == InventoryDocStatus.Posted)
                    {
                        <form asp-action="Reverse" asp-route-id="@r.Id" method="post" style="display:inline;" data-confirm="عكس إذن الاستلام @r.Number؟" data-danger>
                            @Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">عكس</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="7" style="color:var(--muted)">لا توجد أذون استلام بعد.</td></tr> }
        </tbody>
    </table>
</div>
