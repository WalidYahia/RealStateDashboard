@model InventoryDashboardVm
@using System.Text.Json
@{
    ViewData["Title"] = "لوحة المخزون";
    var ar = RealState.Web.AppCulture.Ar;
    string N0(decimal v) => v.ToString("N0", ar);
    var whLabels = Model.ByWarehouse.Select(w => w.Warehouse).ToList();
    var whValues = Model.ByWarehouse.Select(w => Math.Round(w.Value, 2)).ToList();
    var whQty = Model.ByWarehouse.Select(w => N0(w.Quantity)).ToList();
}
<div class="page-head">
    <h1>لوحة المخزون</h1>
    <span style="color:var(--muted);font-size:13px;">الأرصدة كما في @Model.AsOf.ToString("yyyy/MM/dd")</span>
</div>

@* ---------------- KPI tiles ---------------- *@
<div class="kpi-grid">
    <div class="kpi" style="--kpi: var(--series-1);">
        <div class="kpi-label">قيمة المخزون</div>
        <div class="kpi-value">@N0(Model.TotalValue) <span class="kpi-unit">ج.م</span></div>
        <div class="kpi-foot">إجمالي التكلفة الدفترية</div>
    </div>
    <div class="kpi" style="--kpi: var(--aqua);">
        <div class="kpi-label">إجمالي الأصناف</div>
        <div class="kpi-value">@Model.TotalProducts</div>
        <div class="kpi-foot">أصناف مفعّلة ومتتبَّعة</div>
    </div>
    <div class="kpi" style="--kpi: var(--violet);">
        <div class="kpi-label">المخازن النشطة</div>
        <div class="kpi-value">@Model.ActiveWarehouses</div>
        <div class="kpi-foot">مخازن مفعّلة</div>
    </div>
    <div class="kpi" style="--kpi: var(--gold);">
        <div class="kpi-label">مخزون منخفض</div>
        <div class="kpi-value" style="color:var(--gold);">@Model.LowStock</div>
        <div class="kpi-foot">⚠ وصل إلى حد إعادة الطلب</div>
    </div>
    <div class="kpi" style="--kpi: var(--critical);">
        <div class="kpi-label">نفد من المخزون</div>
        <div class="kpi-value" style="color:var(--critical);">@Model.OutOfStock</div>
        <div class="kpi-foot">رصيد صفر</div>
    </div>
    <div class="kpi" style="--kpi: @(Model.NegativeStock > 0 ? "var(--critical)" : "var(--good)");">
        <div class="kpi-label">أرصدة سالبة</div>
        <div class="kpi-value" style="color:@(Model.NegativeStock > 0 ? "var(--critical)" : "var(--good)");">@Model.NegativeStock</div>
        <div class="kpi-foot">@(Model.NegativeStock > 0 ? "يلزم المراجعة" : "لا توجد أرصدة سالبة")</div>
    </div>
</div>

<div class="grid-row inv-dash-row">
    @* ---------------- value by warehouse (bar chart) ---------------- *@
    <div class="card-tile inv-dash-card">
        <div class="card-head">
            <h3>قيمة المخزون حسب المخزن</h3>
            <a class="btn-sm" asp-controller="InventoryReports" asp-action="Index" asp-route-tab="balance">تفاصيل الأرصدة</a>
        </div>
        @if (Model.ByWarehouse.Count == 0)
        {
            <p class="inv-dash-empty">لا توجد أرصدة لعرضها.</p>
        }
        else
        {
            <div class="inv-dash-chart"><canvas id="whChart" aria-label="قيمة المخزون حسب المخزن"></canvas></div>
        }
    </div>

    @* ---------------- products that need attention ---------------- *@
    <div class="card-tile inv-dash-card">
        <div class="card-head">
            <h3>أصناف تحتاج انتباه @if (Model.Alerts.Count > 0) { <span class="pill">@Model.Alerts.Count</span> }</h3>
            <a class="btn-sm" asp-controller="InventoryReports" asp-action="Index" asp-route-tab="balance">كل الأرصدة</a>
        </div>
        @if (Model.Alerts.Count > 7)
        {
            <div class="list-search-bar"><input class="form-control list-search" data-target="#alertsTable" placeholder="🔍 بحث بالكود أو الصنف أو الحالة..." /></div>
        }
        <div class="inv-dash-scroll">
            <table class="rs-table inv-alerts" id="alertsTable" data-no-grid>
                <thead><tr><th>الكود</th><th>الصنف</th><th>الرصيد</th><th>حد إعادة الطلب</th><th>الحالة</th></tr></thead>
                <tbody>
                @foreach (var a in Model.Alerts)
                {
                    var color = a.State == "سالب" || a.State == "نفد" ? "var(--critical)" : "var(--gold)";
                    <tr data-alert>
                        <td dir="ltr" style="text-align:right;" class="al-sku">@a.Sku</td>
                        <td class="al-name">@a.Product</td>
                        <td style="font-weight:600;" class="al-qty" data-label="الرصيد">@a.QuantityText</td>
                        <td class="al-reorder" data-label="حد إعادة الطلب">@a.ReorderText</td>
                        <td class="al-state"><span class="badge-role" style="color:@color;">@a.State</span></td>
                    </tr>
                }
                @if (Model.Alerts.Count == 0)
                {
                    <tr data-skip-search><td colspan="5" style="color:var(--good,#199e70);">✔ كل الأصناف ضمن الحدود الآمنة.</td></tr>
                }
                <tr data-no-results data-skip-search style="display:none;"><td colspan="5" style="color:var(--muted)">لا توجد نتائج.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Value per warehouse — one bar each; the tooltip adds the quantity held (in smallest units).
        (function () {
            var el = document.getElementById('whChart');
            if (!el || !window.Chart) return;
            var css = function (v, fb) { return (window.appThemeColor && window.appThemeColor(v)) || fb; };
            var palette = [css('--series-1', '#3987e5'), css('--aqua', '#199e70'), css('--violet', '#9085e9'), css('--gold', '#c98500'), '#e5484d', '#14b8a6', '#f472b6', '#64748b'];
            var values = @Html.Raw(JsonSerializer.Serialize(whValues)), qty = @Html.Raw(JsonSerializer.Serialize(whQty));
            var money = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 });
            var tick = function (v) { return Math.abs(v) >= 1000000 ? (v / 1000000) + 'M' : Math.abs(v) >= 1000 ? (v / 1000) + 'k' : v; };
            Chart.defaults.color = css('--text-secondary', '#c3c2b7');
            new Chart(el, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(JsonSerializer.Serialize(whLabels)),
                    datasets: [{ data: values, backgroundColor: values.map(function (_, i) { return palette[i % palette.length]; }), borderRadius: 6, maxBarThickness: 64 }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { rtl: true, callbacks: {
                            label: function (c) { return ' ' + money.format(c.parsed.y) + ' ج.م'; },
                            afterLabel: function (c) { return ' ' + qty[c.dataIndex] + ' وحدة صغرى'; }
                        } }
                    },
                    scales: {
                        y: { position: 'right', beginAtZero: true, ticks: { callback: tick }, grid: { color: css('--chart-grid', 'rgba(255,255,255,.06)') } },
                        x: { reverse: true, grid: { display: false } }
                    }
                }
            });
        })();
    </script>
}
