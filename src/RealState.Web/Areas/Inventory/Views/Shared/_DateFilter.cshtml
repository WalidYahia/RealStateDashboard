@model DocListVm
@* Date filter of the inventory document lists (receipts / issues / transfers / adjustments / counts) — the shared filter bar. *@
@{
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var filter = FilterBarVm.For(Url.Action())
        .DateRange(F(Model.From), F(Model.To), "تاريخ المستند",
            presets: FilterPresets.Standard().Append(FilterPresets.All()));
}
<partial name="_FilterBar" model="filter" />
