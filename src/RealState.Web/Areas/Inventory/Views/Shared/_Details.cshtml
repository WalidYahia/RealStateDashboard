@model DocDetailsVm
@{
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string Q(decimal v) => v.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="card-head" style="margin-bottom:8px;">
    <h3>@Model.Title @Model.Number</h3>
    <span style="display:flex;gap:8px;align-items:center;">
        <span class="badge-role">@Model.Status</span>
        @if (Model.PrintUrl is not null)
        {
            <a class="btn-sm" href="@Model.PrintUrl" target="_blank">🖨 طباعة</a>
        }
    </span>
</div>
<div style="color:var(--muted);font-size:13px;margin-bottom:10px;">
    التاريخ: @Model.Date.ToString("yyyy/MM/dd") · المخزن: @Model.Warehouse
    @foreach (var (label, value) in Model.Extra) { <text> · @label: @value</text> }
    @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <text> · @Model.Notes</text> }
</div>
<table class="rs-table" data-no-grid>
    <thead><tr><th>الصنف</th><th>الوحدة</th><th>الكمية</th><th>تكلفة الوحدة</th><th>الإجمالي</th></tr></thead>
    <tbody>
    @foreach (var l in Model.Lines)
    {
        <tr>
            <td>@l.Product</td>
            <td>@(l.Unit ?? "—")</td>
            <td dir="ltr" style="text-align:right;">@Q(l.Quantity)</td>
            <td>@(l.UnitCost == 0 ? "" : N(l.UnitCost))</td>
            <td>@(l.TotalCost == 0 ? "" : N(l.TotalCost))</td>
        </tr>
    }
    @if (Model.Lines.Count == 0) { <tr><td colspan="5" style="color:var(--muted)">لا توجد أسطر.</td></tr> }
    </tbody>
    <tfoot>
        <tr><th colspan="4" style="text-align:start;">الإجمالي</th><th>@N(Model.Lines.Sum(l => l.TotalCost))</th></tr>
    </tfoot>
</table>
