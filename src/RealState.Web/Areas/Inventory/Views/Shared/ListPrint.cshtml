@model ListPrintVm
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, sans-serif; padding: 24px; color: #111; }
        h1 { font-size: 18px; text-align: center; margin: 4px 0; }
        .sub { text-align: center; color: #666; font-size: 12px; margin-bottom: 14px; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th, td { border: 1px solid #bbb; padding: 5px 7px; text-align: start; unicode-bidi: plaintext; }
        thead th { background: #eef4fb; font-weight: 700; }
        tfoot th, tfoot td { font-weight: 800; background: #f2f2f2; }
        .no-print { margin-bottom: 12px; } @@media print { .no-print { display: none; } body { padding: 0; } }
    </style>
</head>
<body>
    @await Component.InvokeAsync("ReportBackground", new { part = "open" })
    <div class="no-print"><button onclick="window.print()">🖨 طباعة / حفظ PDF</button></div>
    <h1>@Model.Title</h1>
    <div class="sub">@(string.IsNullOrWhiteSpace(Model.Subtitle) ? "" : Model.Subtitle + " · ")العدد: @Model.Rows.Count · طُبع @DateTime.Now.ToString("yyyy/MM/dd HH:mm")</div>

    <table>
        <thead>
            <tr>@foreach (var h in Model.Headers) { <th>@h</th> }</tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>@foreach (var c in r) { <td>@c</td> }</tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="@Model.Headers.Count">لا توجد بيانات.</td></tr> }
        </tbody>
        @if (Model.Totals is { Count: > 0 })
        {
            <tfoot><tr>@foreach (var c in Model.Totals) { <th>@c</th> }</tr></tfoot>
        }
    </table>

    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
    @await Component.InvokeAsync("ReportBackground", new { part = "close" })
</body>
</html>
