@model RealState.Web.Areas.Inventory.Models.CostUpdateDetailsVm
@{
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string Q(decimal v) => v.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
}
<div style="color:var(--muted);font-size:13px;margin-bottom:10px;">
    التاريخ: @Model.Date.ToString("yyyy/MM/dd") · بواسطة: @(Model.By ?? "—")
    @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <text> · @Model.Notes</text> }
</div>
<table class="rs-table" data-no-grid>
    <thead><tr><th>الصنف</th><th>الوحدة</th><th>الرصيد</th><th>التكلفة السابقة</th><th>التكلفة الجديدة</th><th>فرق القيمة</th></tr></thead>
    <tbody>
    @foreach (var l in Model.Lines)
    {
        <tr>
            <td>@l.Product</td>
            <td>@l.Unit</td>
            <td dir="ltr" style="text-align:right;">@Q(l.Quantity)</td>
            <td>@(l.OldCost > 0 ? N(l.OldCost) : "—")</td>
            <td>@N(l.NewCost)</td>
            <td style="color:@(l.ValueChange > 0 ? "var(--good)" : l.ValueChange < 0 ? "var(--critical)" : "inherit");">@N(l.ValueChange)</td>
        </tr>
    }
    </tbody>
    <tfoot><tr><th colspan="5" style="text-align:start;">إجمالي فرق القيمة</th><th>@N(Model.Lines.Sum(l => l.ValueChange)) ج.م</th></tr></tfoot>
</table>
