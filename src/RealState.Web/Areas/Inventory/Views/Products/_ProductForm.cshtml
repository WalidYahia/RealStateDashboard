@model ProductFormModel
<form id="appModalForm" asp-area="Inventory" asp-controller="Products" asp-action="Form" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="Id" />
    <div class="form-grid">
        <div>
            <label asp-for="Sku" class="form-label"></label>
            <input asp-for="Sku" class="form-control" dir="ltr" />
            <span asp-validation-for="Sku" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" class="form-control" data-searchable asp-items="Model.Categories">
                <option value="">— بدون —</option>
            </select>
        </div>
        <div class="full">
            @* Up to 3 units. Stock and cost are always counted in the smallest one; documents may use any. *@
            <label class="form-label">الوحدات</label>
            <table class="rs-table" data-no-grid style="margin:0;">
                <thead><tr><th style="width:90px;">المستوى</th><th>الوحدة</th><th>تساوي</th><th style="width:130px;">سعر البيع</th><th style="width:86px;text-align:center;">الافتراضية</th></tr></thead>
                <tbody>
                    <tr>
                        <td>الصغرى</td>
                        <td>
                            <select asp-for="UnitOfMeasureId" class="form-control" style="margin:0" data-searchable asp-items="Model.Units"><option value="">— بدون —</option></select>
                            <span asp-validation-for="UnitOfMeasureId" class="field-validation-error"></span>
                        </td>
                        <td style="color:var(--muted);font-size:12.5px;">الوحدة الأساسية — بها يُحسب المخزون والتكلفة</td>
                        <td><input asp-for="SalePrice" class="form-control" style="margin:0;" type="number" step="any" min="0" dir="ltr" placeholder="—" /></td>
                        <td style="text-align:center;"><input type="radio" name="DefaultUnitLevel" value="1" checked="@(Model.DefaultUnitLevel != 2 && Model.DefaultUnitLevel != 3)" /></td>
                    </tr>
                    <tr>
                        <td>الأكبر</td>
                        <td>
                            <select asp-for="Unit2Id" class="form-control" style="margin:0" data-searchable asp-items="Model.Units"><option value="">— بدون —</option></select>
                            <span asp-validation-for="Unit2Id" class="field-validation-error"></span>
                        </td>
                        <td>
                            <div style="display:flex;align-items:center;gap:6px;">
                                <input asp-for="Unit2Factor" class="form-control" style="margin:0;width:120px;" type="number" step="any" min="0" dir="ltr" placeholder="مثال: 100" />
                                <span style="color:var(--muted);font-size:12.5px;white-space:nowrap;">× الوحدة الصغرى</span>
                            </div>
                            <span asp-validation-for="Unit2Factor" class="field-validation-error"></span>
                        </td>
                        <td><input asp-for="SalePrice2" class="form-control" style="margin:0;" type="number" step="any" min="0" dir="ltr" placeholder="—" /></td>
                        <td style="text-align:center;"><input type="radio" name="DefaultUnitLevel" value="2" checked="@(Model.DefaultUnitLevel == 2)" /></td>
                    </tr>
                    <tr>
                        <td>الأكبر منها</td>
                        <td>
                            <select asp-for="Unit3Id" class="form-control" style="margin:0" data-searchable asp-items="Model.Units"><option value="">— بدون —</option></select>
                            <span asp-validation-for="Unit3Id" class="field-validation-error"></span>
                        </td>
                        <td>
                            <div style="display:flex;align-items:center;gap:6px;">
                                <input asp-for="Unit3Factor" class="form-control" style="margin:0;width:120px;" type="number" step="any" min="0" dir="ltr" placeholder="مثال: 1000" />
                                <span style="color:var(--muted);font-size:12.5px;white-space:nowrap;">× الوحدة الأكبر</span>
                            </div>
                            <span asp-validation-for="Unit3Factor" class="field-validation-error"></span>
                        </td>
                        <td><input asp-for="SalePrice3" class="form-control" style="margin:0;" type="number" step="any" min="0" dir="ltr" placeholder="—" /></td>
                        <td style="text-align:center;"><input type="radio" name="DefaultUnitLevel" value="3" checked="@(Model.DefaultUnitLevel == 3)" /></td>
                    </tr>
                </tbody>
            </table>
            <span style="color:var(--muted);font-size:12px;">مثال: الصغرى «سم»، الأكبر «متر» = 100، الأكبر منها «كيلو» = 1000 (أي 1000 متر). الافتراضية تُختار تلقائيًا في الفواتير والأوامر وأذون المخزون ويمكن تغييرها في كل سطر. سعر البيع (اختياري) لكل وحدة يظهر تلقائيًا في فاتورة المبيعات عند اختيار الوحدة، ويمكن تعديله في الفاتورة.</span>
        </div>
        <div>
            <label asp-for="ReorderLevel" class="form-label"></label>
            <input asp-for="ReorderLevel" class="form-control" type="number" step="0.01" min="0" dir="ltr" />
            <span style="color:var(--muted);font-size:12px;">تنبيه «مخزون منخفض» عند النزول إلى هذا الحد. صفر = بدون تنبيه.</span>
        </div>
        <div class="full">
            <label asp-for="Notes" class="form-label"></label>
            <input asp-for="Notes" class="form-control" />
        </div>
        <div>
            <label class="form-check"><input asp-for="TrackInventory" type="checkbox" /> تتبّع المخزون</label>
        </div>
        <div>
            <label class="form-check"><input asp-for="TrackCost" type="checkbox" /> تتبّع التكلفة</label>
        </div>
        <div class="full">
            <label class="form-check"><input asp-for="IsActive" type="checkbox" /> مفعّل</label>
        </div>
    </div>
    <button type="submit" class="btn-primary" style="margin-top:12px;">💾 حفظ</button>
</form>
