@model List<ProductRow>
@{
    ViewData["Title"] = "الأصناف";
    var canManage = User.Can(PermissionNames.InventoryManage);
}
<div class="page-head">
    <h1>الأصناف</h1>
    <span style="display:flex;gap:8px;">
        <a class="btn-sm" asp-action="Print" target="_blank">🖨 طباعة (PDF)</a>
        <a class="btn-sm" asp-action="Excel">⬇ Excel</a>
        @if (canManage)
        {
            <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'صنف جديد')">➕ صنف جديد</button>
        }
    </span>
</div>

@if (TempData["StatusMessage"] is string status) { <div class="status-message">@status</div> }
@if (TempData["ErrorMessage"] is string err) { <div class="status-message" style="background:rgba(208,59,59,.12);border-color:var(--critical);color:var(--critical);">@err</div> }

<div class="card-tile">
    <div class="list-search-bar"><input class="form-control list-search" data-target="#prodTable" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="prodTable">
        <thead><tr><th>الكود</th><th>الاسم</th><th>التصنيف</th><th>الوحدة</th><th>الحالة</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td dir="ltr" style="text-align:right;">@p.Sku</td>
                <td>@p.Name</td>
                <td>@p.CategoryName</td>
                <td>@p.UnitName</td>
                <td>@(p.IsActive ? "مفعّل" : "متوقف")</td>
                <td style="white-space:nowrap;">
                    @if (canManage)
                    {
                        <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = p.Id })', 'تعديل الصنف')">✏️ تعديل</button>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" style="display:inline;" data-confirm="حذف الصنف «@p.Name»؟" data-danger>
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-sm btn-danger">حذف</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr data-skip-search><td colspan="6" style="color:var(--muted)">لا توجد أصناف بعد.</td></tr> }
        <tr data-no-results data-skip-search style="display:none;"><td colspan="6" style="color:var(--muted)">لا توجد نتائج مطابقة.</td></tr>
        </tbody>
    </table>
</div>
