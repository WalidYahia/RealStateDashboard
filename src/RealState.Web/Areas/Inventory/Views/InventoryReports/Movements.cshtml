@model MovementsVm
@{
    ViewData["Title"] = "حركة المخزون";
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="page-head">
    <h1>حركة المخزون</h1>
</div>

<partial name="_ReportTabs" />

@{
    // The report never had quick presets — kept that way (dates only).
    var filter = FilterBarVm.For(Url.Action("Movements"))
        .DateRange(F(Model.From), F(Model.To), presets: Array.Empty<FilterPreset>())
        .Select("productId", "الصنف", Model.Products, Model.ProductId, "— الكل —")
        .Select("warehouseId", "المخزن", Model.Warehouses, Model.WarehouseId, "— الكل —")
        .Print(Url.Action("MovementsPrint", new { productId = Model.ProductId, warehouseId = Model.WarehouseId, from = F(Model.From), to = F(Model.To) }))
        .Excel(Url.Action("MovementsExcel", new { productId = Model.ProductId, warehouseId = Model.WarehouseId, from = F(Model.From), to = F(Model.To) }));
}
<partial name="_FilterBar" model="filter" />

<div class="card-tile">
    <table class="rs-table" data-no-grid>
        <thead><tr><th>التاريخ</th><th>النوع</th><th>المرجع</th><th>الصنف</th><th>المخزن</th><th>وارد</th><th>منصرف</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td dir="ltr" style="text-align:right;">@r.Date.ToString("yyyy/MM/dd")</td>
                <td>@r.TypeAr</td>
                <td>@r.Reference</td>
                <td>@r.Product</td>
                <td>@r.Warehouse</td>
                <td>@(r.In == 0 ? "" : N(r.In))</td>
                <td>@(r.Out == 0 ? "" : N(r.Out))</td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="7" style="color:var(--muted)">لا توجد حركات في هذه الفترة.</td></tr> }
        </tbody>
        <tfoot>
            <tr><th colspan="5" style="text-align:start;">الإجمالي</th><th>@N(Model.TotalIn)</th><th>@N(Model.TotalOut)</th></tr>
        </tfoot>
    </table>
</div>
