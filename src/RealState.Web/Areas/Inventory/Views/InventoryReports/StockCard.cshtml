@model MovementsVm
@{
    ViewData["Title"] = "بطاقة الصنف";
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var ready = Model.ProductId is not null && Model.WarehouseId is not null;
}
<div class="page-head">
    <h1>بطاقة الصنف</h1>
</div>

<partial name="_ReportTabs" />

@{
    // Product + warehouse are required for the card; print / Excel appear once both are chosen (as before).
    var filter = FilterBarVm.For(Url.Action("StockCard"))
        .SubmitLabel("عرض")
        .Select("productId", "الصنف", Model.Products, Model.ProductId, "— اختر —")
        .Select("warehouseId", "المخزن", Model.Warehouses, Model.WarehouseId, "— اختر —")
        .DateRange(F(Model.From), F(Model.To), presets: Array.Empty<FilterPreset>());
    if (ready)
        filter.Print(Url.Action("StockCardPrint", new { productId = Model.ProductId, warehouseId = Model.WarehouseId, from = F(Model.From), to = F(Model.To) }))
              .Excel(Url.Action("StockCardExcel", new { productId = Model.ProductId, warehouseId = Model.WarehouseId, from = F(Model.From), to = F(Model.To) }));
}
<partial name="_FilterBar" model="filter" />

@if (!ready)
{
    <div class="card-tile" style="color:var(--muted)">اختر الصنف والمخزن لعرض البطاقة.</div>
}
else
{
    <div class="card-tile">
        <table class="rs-table" data-no-grid>
            <thead><tr><th>التاريخ</th><th>النوع</th><th>المرجع</th><th>وارد</th><th>منصرف</th><th>الرصيد</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td dir="ltr" style="text-align:right;">@r.Date.ToString("yyyy/MM/dd")</td>
                    <td>@r.TypeAr</td>
                    <td>@r.Reference</td>
                    <td>@(r.In == 0 ? "" : N(r.In))</td>
                    <td>@(r.Out == 0 ? "" : N(r.Out))</td>
                    <td style="font-weight:600;">@N(r.Balance)</td>
                </tr>
            }
            @if (Model.Rows.Count == 0) { <tr><td colspan="6" style="color:var(--muted)">لا توجد حركات في هذه الفترة.</td></tr> }
            </tbody>
            <tfoot>
                <tr><th colspan="3" style="text-align:start;">الإجمالي</th><th>@N(Model.TotalIn)</th><th>@N(Model.TotalOut)</th><th></th></tr>
            </tfoot>
        </table>
    </div>
}
