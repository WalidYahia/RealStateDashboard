@model StockBalanceVm
@* Tab «أرصدة المخزون» / «تقييم المخزون» of the inventory reports page (Index). *@
@{
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    var tableId = Model.ByProductOnly ? "valTable" : "balTable";   // both tabs can be loaded at once
}
<div class="rep-toolbar">
    <span style="display:flex;gap:8px;">
        @if (Model.ByProductOnly)
        {
            <a class="btn-sm" asp-action="ValuationPrint" target="_blank">🖨 طباعة (PDF)</a>
            <a class="btn-sm" asp-action="ValuationExcel">⬇ Excel</a>
        }
        else
        {
            <a class="btn-sm" asp-action="StockBalancePrint" target="_blank">🖨 طباعة (PDF)</a>
            <a class="btn-sm" asp-action="StockBalanceExcel">⬇ Excel</a>
        }
    </span>
</div>

@{ string Q(decimal v) => v.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture); }
<p style="color:var(--muted);font-size:12.5px;margin:0 0 8px;">الكمية ومتوسط التكلفة بالوحدة الصغرى لكل صنف، و«بالوحدات» تعرض الرصيد موزّعًا على وحدات الصنف (الأكبر أولًا).</p>
<div class="card-tile">
    <div class="list-search-bar"><input class="form-control list-search" data-target="#@tableId" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="@tableId">
        <thead><tr><th>الكود</th><th>الصنف</th><th>المخزن</th><th>الكمية</th><th>بالوحدات</th><th title="متوسط تكلفة الوحدة الصغرى">متوسط التكلفة</th><th>القيمة</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td dir="ltr" style="text-align:right;">@r.Sku</td>
                <td>@r.Product</td>
                <td>@r.Warehouse</td>
                <td dir="ltr" style="text-align:right;white-space:nowrap;">@Q(r.Quantity) <span style="color:var(--muted);">@r.Unit</span></td>
                <td style="color:var(--text-secondary);">@r.Breakdown</td>
                <td title="لكل @r.Unit">@r.AvgCost.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)</td>
                <td>@N(r.Value)</td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr data-skip-search><td colspan="7" style="color:var(--muted)">لا توجد أرصدة.</td></tr> }
        <tr data-no-results data-skip-search style="display:none;"><td colspan="7" style="color:var(--muted)">لا توجد نتائج مطابقة.</td></tr>
        </tbody>
        <tfoot>
            <tr><th colspan="6" style="text-align:start;">إجمالي قيمة المخزون</th><th>@N(Model.TotalValue)</th></tr>
        </tfoot>
    </table>
</div>
