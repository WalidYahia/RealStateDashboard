@model MovementsVm
@* Tab «بطاقة الصنف» of the inventory reports page (Index). *@
@{
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var ready = Model.ProductId is not null && Model.WarehouseId is not null;
}
@{
    // Product + warehouse are required for the card; print / Excel appear once both are chosen. Standard quick ranges
    // (اليوم / آخر أسبوع / آخر شهر); a fresh open defaults to today.
    var filter = FilterBarVm.For(Url.Action("StockCard"))
        .SubmitLabel("عرض")
        .Select("productId", "الصنف", Model.Products, Model.ProductId, "— اختر —")
        .Select("warehouseId", "المخزن", Model.Warehouses, Model.WarehouseId, "— اختر —")
        .DateRange(F(Model.From), F(Model.To));
    if (ready)
        filter.Print(Url.Action("StockCardPrint", new { productId = Model.ProductId, warehouseId = Model.WarehouseId, from = F(Model.From), to = F(Model.To) }))
              .Excel(Url.Action("StockCardExcel", new { productId = Model.ProductId, warehouseId = Model.WarehouseId, from = F(Model.From), to = F(Model.To) }));
}
<partial name="_FilterBar" model="filter" />

@if (!ready)
{
    <div class="card-tile" style="color:var(--muted)">اختر الصنف والمخزن لعرض البطاقة.</div>
}
else
{
    var unit = Model.Rows.FirstOrDefault()?.Unit ?? "";
    string Q(decimal v) => v.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
    <div class="card-tile">
        <table class="rs-table" data-no-grid>
            <thead><tr><th>التاريخ</th><th>النوع</th><th>المرجع</th><th>وارد (@unit)</th><th>منصرف (@unit)</th><th>الرصيد (@unit)</th><th>الرصيد بالوحدات</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td dir="ltr" style="text-align:right;">@r.Date.ToString("yyyy/MM/dd")</td>
                    <td>@r.TypeAr</td>
                    <td>@r.Reference</td>
                    <td dir="ltr" style="text-align:right;">@(r.In == 0 ? "" : Q(r.In))</td>
                    <td dir="ltr" style="text-align:right;">@(r.Out == 0 ? "" : Q(r.Out))</td>
                    <td dir="ltr" style="text-align:right;font-weight:600;">@Q(r.Balance)</td>
                    <td style="color:var(--text-secondary);">@r.BalanceBreakdown</td>
                </tr>
            }
            @if (Model.Rows.Count == 0) { <tr><td colspan="7" style="color:var(--muted)">لا توجد حركات في هذه الفترة.</td></tr> }
            </tbody>
            <tfoot>
                <tr><th colspan="3" style="text-align:start;">الإجمالي</th><th>@Q(Model.TotalIn)</th><th>@Q(Model.TotalOut)</th><th></th><th></th></tr>
            </tfoot>
        </table>
    </div>
}
