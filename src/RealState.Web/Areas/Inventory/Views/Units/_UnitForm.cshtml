@model UnitFormModel
<form id="appModalForm" asp-area="Inventory" asp-controller="Units" asp-action="Form" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="Id" />
    <div class="form-grid">
        <div>
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" dir="ltr" />
            <span asp-validation-for="Code" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>
        <div class="full">
            <label class="form-check"><input asp-for="IsActive" type="checkbox" /> مفعّل</label>
        </div>
    </div>
    <button type="submit" class="btn-primary" style="margin-top:12px;">💾 حفظ</button>
</form>
