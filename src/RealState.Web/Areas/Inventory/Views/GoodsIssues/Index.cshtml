@model DocListVm
@{
    ViewData["Title"] = "أذون الصرف";
    var canDoc = User.Can(PermissionNames.InventoryDocuments);
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
}
<div class="page-head">
    <h1>أذون الصرف (OUT)
        <button type="button" title="شرح إذن الصرف" onclick="appOpenModal('@Url.Action("Help")', 'شرح إذن الصرف')" style="border:none;background:none;cursor:pointer;font-size:18px;vertical-align:middle;">❓</button>
    </h1>
    <span style="display:flex;gap:8px;">
        <a class="btn-sm" asp-action="Print" asp-route-from="@F(Model.From)" asp-route-to="@F(Model.To)" target="_blank">🖨 طباعة (PDF)</a>
        <a class="btn-sm" asp-action="Excel" asp-route-from="@F(Model.From)" asp-route-to="@F(Model.To)">⬇ Excel</a>
        @if (canDoc) { <a class="btn-new-tenant" asp-action="Create">➕ إذن صرف جديد</a> }
    </span>
</div>

@if (TempData["StatusMessage"] is string status) { <div class="status-message">@status</div> }
@if (TempData["ErrorMessage"] is string err) { <div class="status-message" style="background:rgba(208,59,59,.12);border-color:var(--critical);color:var(--critical);">@err</div> }
n<partial name="_DateFilter" model="Model" />

<div class="card-tile">
    <table class="rs-table">
        <thead><tr><th>الرقم</th><th>التاريخ</th><th>المخزن</th><th>الأسطر</th><th>التكلفة</th><th>الحالة</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td dir="ltr" style="text-align:right;">@r.Number</td>
                <td dir="ltr" style="text-align:right;">@r.Date.ToString("yyyy/MM/dd")</td>
                <td>@r.Warehouse</td>
                <td>@r.LineCount</td>
                <td>@N(r.TotalCost)</td>
                <td><partial name="_StatusBadge" model="r.Status" /></td>
                <td style="white-space:nowrap;">
                    <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Details", new { id = r.Id })', 'تفاصيل إذن الصرف')">📄</button>
                    @if (canDoc && r.Status == InventoryDocStatus.Draft)
                    {
                        <a class="btn-sm" asp-action="Edit" asp-route-id="@r.Id">✏️</a>
                        <form asp-action="Post" asp-route-id="@r.Id" method="post" style="display:inline;" data-confirm="ترحيل إذن الصرف @r.Number؟">@Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-primary">ترحيل</button></form>
                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" style="display:inline;" data-confirm="حذف المسودة؟" data-danger>@Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">🗑</button></form>
                    }
                    else if (canDoc && r.Status == InventoryDocStatus.Posted)
                    {
                        <form asp-action="Reverse" asp-route-id="@r.Id" method="post" style="display:inline;" data-confirm="عكس إذن الصرف @r.Number؟" data-danger>@Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">عكس</button></form>
                    }
                </td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="7" style="color:var(--muted)">لا توجد أذون صرف بعد.</td></tr> }
        </tbody>
    </table>
</div>
