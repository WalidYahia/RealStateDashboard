@model List<CollectionRow>
@{
    string N(decimal v) => v.ToString("N0", new System.Globalization.CultureInfo("ar-EG"));
    var payable = (bool?)ViewData["Payable"] ?? false;
    var canEdit = User.Can(PermissionNames.CollectionsCollect);
}
<div class="card-tile">
    <table class="rs-table">
        <thead><tr><th>العميل</th><th>الوحدة</th><th>المشروع</th><th>العقد</th><th>القسط</th><th>الاستحقاق</th><th>القيمة</th><th>الحالة</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.CustomerName</td>
                <td>@r.UnitLabel</td>
                <td>@r.ProjectName</td>
                <td dir="ltr" style="text-align:right;">@r.ContractCode</td>
                <td>@ArabicLabels.InstNo(r.Number)</td>
                <td dir="ltr" style="text-align:right;">@r.DueDate.ToString("yyyy/MM/dd")</td>
                <td>@N(r.Amount)</td>
                <td><span class="badge-state @r.Status.BadgeClass()">@r.Status.Ar() @(r.Status == InstallmentStatus.Overdue ? "⚠" : "")</span></td>
                <td>
                    @if (payable && canEdit)
                    {
                        <form class="pay-form" asp-action="Pay" asp-route-id="@r.InstallmentId" method="post" style="display:inline;"
                              data-msg="تحصيل @ArabicLabels.InstPhrase(r.Number) من «@r.CustomerName» بقيمة @N(r.Amount) ج.م؟">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="safeId" class="pay-safe" />
                            <button type="submit" class="btn-sm" style="background:var(--aqua);color:#fff;border-color:var(--aqua);">💳 تحصيل</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="9" style="color:var(--muted)">لا توجد أقساط في هذا التبويب. 🎉</td></tr>
        }
        </tbody>
    </table>
</div>
