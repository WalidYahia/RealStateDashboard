@model SalesListVm
@using System.Globalization
@{
    Layout = null;
    var tenantId = (Guid)ViewBag.TenantId;
    string N(decimal v) => v.ToString("N0", new CultureInfo("ar-EG"));
    string D(DateTime d) => d.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture);
    var range = (Model.From.HasValue || Model.To.HasValue)
        ? $"من {(Model.From.HasValue ? D(Model.From.Value) : "…")} إلى {(Model.To.HasValue ? D(Model.To.Value) : "…")}"
        : "كل الفترات";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>تقرير المبيعات</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, sans-serif; padding: 24px; color: #111; }
        .brand { text-align: center; margin-bottom: 6px; } .brand img { max-height: 60px; }
        h1 { font-size: 19px; text-align: center; margin: 4px 0; }
        .sub { text-align: center; color: #666; font-size: 12px; margin-bottom: 14px; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th, td { border: 1px solid #ccc; padding: 6px 8px; text-align: start; unicode-bidi: plaintext; }
        th { background: #f2f2f2; }
        .totals td { font-weight: 700; background: #f7f7f7; }
        .no-print { margin-bottom: 12px; } @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="no-print"><button onclick="window.print()">🖨 طباعة / حفظ PDF</button></div>
    <div class="brand"><img src="@Url.Action("Logo", "Branding", new { area = "", id = tenantId })" alt="logo" onerror="this.style.display='none'" /></div>
    <h1>تقرير المبيعات (عقود البيع)</h1>
    <div class="sub">@range · @DateTime.Now.ToString("yyyy/MM/dd HH:mm")</div>
    <table>
        <thead>
            <tr><th>الكود</th><th>العميل</th><th>المشروع</th><th>الوحدة</th><th>تاريخ العقد</th><th>الإجمالي</th><th>المدفوع</th><th>المتبقي</th></tr>
        </thead>
        <tbody>
        @foreach (var s in Model.Rows)
        {
            <tr>
                <td>@s.Code</td><td>@s.Customer</td><td>@s.Project</td><td>@s.Unit</td>
                <td>@D(s.ContractDate)</td><td>@N(s.TotalPrice)</td><td>@N(s.Paid)</td><td>@N(s.Remaining)</td>
            </tr>
        }
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="8" style="color:#888;">لا توجد عقود.</td></tr>
        }
        </tbody>
        <tfoot>
            <tr class="totals">
                <td colspan="5">الإجمالي (@Model.Rows.Count عقد)</td>
                <td>@N(Model.TotalValue)</td><td>@N(Model.TotalPaid)</td><td>@N(Model.TotalRemaining)</td>
            </tr>
        </tfoot>
    </table>
    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
</body>
</html>
