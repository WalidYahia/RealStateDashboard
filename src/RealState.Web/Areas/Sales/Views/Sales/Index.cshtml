@model SalesListVm
@using System.Text.Json
@using System.Globalization

@{
    ViewData["Title"] = "المبيعات (عقود البيع)";
    string N(decimal v) => v.ToString("N0", RealState.Web.AppCulture.Ar);
    string D(DateTime d) => RealState.Web.AppCulture.When(d);   // date + time when it has one
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var unitPrices = ViewBag.UnitPrices as Dictionary<string, decimal> ?? new();
}

<div class="page-head">
    <h1>المبيعات (عقود البيع)</h1>
    <div style="display:flex;gap:8px;">
        @if (User.Can(PermissionNames.SalesCreate))
        {
            <button type="button" class="btn-new-tenant" data-quick-new onclick="appOpenModal('@Url.Action("Form")', 'عقد بيع جديد', 'xl')">➕ عقد بيع جديد</button>
        }
    </div>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

@{
    var statusValues = Model.Status.Select(s => ((int)s).ToString()).ToList();
    var statusItems = new List<SelectListItem>
    {
        new("سارية", ((int)SaleContractState.Active).ToString()),
        new("مفسوخة", ((int)SaleContractState.Cancelled).ToString()),
    };
    // Multi-choice filters go on the query string as repeated name=value pairs.
    var printUrl = Url.Action("PrintList", new { from = F(Model.From), to = F(Model.To) }) ?? "";
    foreach (var v in statusValues) printUrl += (printUrl.Contains('?') ? "&" : "?") + "status=" + v;
    var filter = FilterBarVm.For(Url.Action("Index"))
        .DateRange(F(Model.From), F(Model.To), "تاريخ العقد")
        .Checks("status", "حالة العقد", statusItems, statusValues)
        .Print(printUrl)
        // Live count / total of the (searched) rows below — kept from the previous filter layout.
        .WithSummary(new Microsoft.AspNetCore.Html.HtmlString(
            $"العقود: <strong data-live-count=\"#saleTable\">{Model.Rows.Count}</strong> · الإجمالي: <strong data-live-sum=\"#saleTable:6\">{N(Model.TotalValue)}</strong> ج.م"));
}
<partial name="_FilterBar" model="filter" />

<div class="card-tile">
    <div class="list-search-bar"><input class="form-control list-search" data-target="#saleTable" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="saleTable">
        <thead>
            <tr>
                <th>الكود</th>
                <th>العميل</th>
                <th>المشروع</th>
                <th>الوحدة</th>
                <th>تاريخ العقد</th>
                <th>تاريخ الاستلام</th>
                <th>الإجمالي</th>
                <th>المدفوع</th>
                <th>المتبقي</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Rows)
            {
                <tr data-search="@((s.Code + " " + s.Customer + " " + s.Project + " " + s.Unit + (s.IsCancelled ? " مفسوخ" : "")).ToLower())" class="@(s.IsCancelled ? "row-cancelled" : null)">
                    <td style="text-align:right;white-space:nowrap;">
                        <a asp-action="Details" asp-route-id="@s.Id" asp-route-from="@F(Model.From)" asp-route-to="@F(Model.To)" dir="ltr" style="color:var(--series-1);text-decoration:none;font-weight:600;">@s.Code</a>
                        @if (s.IsCancelled) { <span class="badge-state state-off">مفسوخ</span> }
                    </td>
                    <td>@s.Customer</td>
                    <td>@s.Project</td>
                    <td>@s.Unit</td>
                    <td style="direction:ltr;text-align:right;white-space:nowrap;unicode-bidi:isolate;">@D(s.ContractDate)</td>
                    <td style="direction:ltr;text-align:right;white-space:nowrap;unicode-bidi:isolate;">@D(s.ReceiveDate)</td>
                    <td>@N(s.TotalPrice)</td>
                    <td class="tag-up">@N(s.Paid)</td>
                    <td>
                        @N(s.Remaining)
                        @if (s.IsCancelled && s.RefundRemaining > 0)
                        {
                            <div class="cancel-owed">مستحق للعميل: @N(s.RefundRemaining)</div>
                        }
                    </td>
                    <td style="white-space:nowrap;">
                        <a class="btn-sm" asp-action="Details" asp-route-id="@s.Id" asp-route-from="@F(Model.From)" asp-route-to="@F(Model.To)">التفاصيل</a>
                        @if (!s.IsCancelled && User.Can(PermissionNames.SalesEdit))
                        {
                            <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = s.Id })', 'تعديل عقد البيع @s.Code', 'xl')">✏️ تعديل</button>
                        }
                    </td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr data-skip-search><td colspan="10" style="color:var(--muted)">لا توجد عقود بيع مطابقة.</td></tr>
            }
            <tr data-no-results data-skip-search style="display:none;"><td colspan="10" style="color:var(--muted)">لا توجد نتائج مطابقة للبحث.</td></tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        var SALE_PRICES = @Html.Raw(JsonSerializer.Serialize(unitPrices));

        // Contract payment schedule (Sales/_SaleForm): hand-entered payments (type قسط/مقدم/صيانة, date, amount), and
        // «تلقائي للمتبقي» — whatever they leave of the total price, split into N auto «قسط» payments from the first
        // date, one period apart (the last takes the rounding, exactly like the server, which regenerates them).
        // Auto payments are a read-only preview in their own list; only the manual rows and the auto settings post.
        // Both lists are grids of .sched-item cells, two per line.
        window.saleFormInit = function () {
            var form = document.querySelector('#appModalBody #appModalForm');
            var body = form && form.querySelector('[data-sched-rows]');
            var autoBody = form && form.querySelector('[data-sched-auto]');
            if (!body || !autoBody) return;
            var locked = !form.querySelector('[data-sched-add]');
            var STEP_MONTHS = { '0': 1, '1': 3, '2': 6, '3': 12 };
            var TYPES = [['0', 'قسط'], ['1', 'مقدم'], ['2', 'صيانة']];

            function num(name) { var el = form.querySelector('[name="' + name + '"]'); return parseFloat((el && el.value) || '0') || 0; }
            function stepMonths() { var el = form.querySelector('[name="Step"]'); return STEP_MONTHS[(el && el.value) || '0'] || 1; }
            function fmt(v) { return v.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 }); }
            function r2(v) { return Math.round(v * 100) / 100; }
            function iso(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
            function addMonths(d, m) {   // like .NET AddMonths: clamp to the target month's last day
                var r = new Date(d.getFullYear(), d.getMonth() + m, 1);
                r.setDate(Math.min(d.getDate(), new Date(r.getFullYear(), r.getMonth() + 1, 0).getDate()));
                return r;
            }
            function typeSelect(value, named) {
                return '<select ' + (named ? 'name="ManualTypes" ' : 'disabled ') + 'class="form-control">'
                    + TYPES.map(function (t) { return '<option value="' + t[0] + '"' + (t[0] === value ? ' selected' : '') + '>' + t[1] + '</option>'; }).join('')
                    + '</select>';
            }
            function sumOf(list) {
                var s = 0;
                list.querySelectorAll('[data-amt]').forEach(function (i) { s += parseFloat(i.value) || 0; });
                return r2(s);
            }

            function addManualRow(type, date) {
                var item = document.createElement('div');
                item.className = 'sched-item';
                item.innerHTML = '<span class="sched-no"></span>'
                    + typeSelect(type, true)
                    + '<input type="date" name="ManualDates" class="form-control" dir="ltr" required />'
                    + '<input type="number" name="ManualAmounts" class="form-control" dir="ltr" step="any" min="0.01" inputmode="decimal" placeholder="القيمة (ج.م)" required data-amt />'
                    + '<button type="button" class="btn-sm btn-danger" data-sched-del title="حذف الصف" aria-label="حذف الصف">✕</button>';
                if (date) item.querySelector('[name="ManualDates"]').value = date;
                body.appendChild(item);
                return item;
            }

            // Rebuild the auto «قسط» list from (total − manual payments) ÷ count, then refresh numbers and totals.
            function regenerate() {
                var remaining = r2(num('TotalPrice') - sumOf(body));
                if (!locked) {
                    autoBody.innerHTML = '';
                    var cnt = parseInt(num('InstallmentsCount'), 10) || 0;
                    var first = (form.querySelector('[name="FirstInstallmentDate"]') || {}).value;
                    if (remaining > 0 && cnt > 0 && first) {
                        var per = r2(remaining / cnt);
                        var start = new Date(first + 'T00:00:00');
                        for (var i = 1; i <= cnt; i++) {
                            var amount = i === cnt ? r2(remaining - per * (cnt - 1)) : per;
                            var item = document.createElement('div');
                            item.className = 'sched-item';
                            item.innerHTML = '<span class="sched-no"></span>'
                                + typeSelect('0', false)
                                + '<input type="date" class="form-control" dir="ltr" disabled value="' + iso(addMonths(start, (i - 1) * stepMonths())) + '" />'
                                + '<input type="number" class="form-control" dir="ltr" disabled value="' + amount + '" data-amt />'
                                + '<span></span>';
                            autoBody.appendChild(item);
                        }
                    }
                }
                var out = form.querySelector('[data-sched-remaining]');
                if (out) {
                    out.textContent = fmt(Math.abs(remaining)) + (remaining < 0 ? ' (زيادة)' : '');
                    out.classList.toggle('off', remaining < 0);
                }
                refresh();
            }

            function refresh() {
                [[body, '[data-sched-empty]'], [autoBody, '[data-sched-auto-empty]']].forEach(function (p) {
                    p[0].querySelectorAll('.sched-no').forEach(function (s, i) { s.textContent = i + 1; });
                    var empty = form.querySelector(p[1]);
                    if (empty) empty.style.display = p[0].querySelector('.sched-item') ? 'none' : '';
                });
                var out = form.querySelector('[data-sched-total]');
                if (!out) return;
                var sum = r2(sumOf(body) + sumOf(autoBody));
                var need = num('TotalPrice');
                var diff = r2(need - sum);
                out.className = 'sched-total ' + (diff === 0 ? 'ok' : 'off');
                out.textContent = 'مجموع الدفعات ' + fmt(sum) + ' من ' + fmt(need) + ' ج.م'
                    + (diff === 0 ? ' ✓' : ' — ' + (diff > 0 ? 'غير موزّع ' : 'زيادة ') + fmt(Math.abs(diff)));
            }

            var add = form.querySelector('[data-sched-add]');
            if (add) add.addEventListener('click', function () {
                // The first payment defaults to a down payment on the contract date; later ones to an installment
                // one period after the last hand-entered date.
                var items = body.querySelectorAll('.sched-item');
                var type = items.length ? '0' : '1', date = form.getAttribute('data-contract-date') || '';
                var cd = form.querySelector('[name="ContractDate"]');
                if (!items.length && cd && cd.value) date = cd.value;
                if (items.length) {
                    var last = items[items.length - 1].querySelector('[name="ManualDates"]').value;
                    if (last) date = iso(addMonths(new Date(last + 'T00:00:00'), stepMonths()));
                }
                var item = addManualRow(type, date);
                regenerate();
                item.scrollIntoView({ block: 'nearest' });
                item.querySelector('[name="ManualAmounts"]').focus();
            });
            body.addEventListener('click', function (e) {
                var del = e.target.closest('[data-sched-del]');
                if (!del) return;
                del.closest('.sched-item').remove();
                regenerate();
            });
            form.addEventListener('input', function (e) {
                if (e.target.matches('[name="ManualAmounts"], [name="TotalPrice"], [name="InstallmentsCount"], [name="FirstInstallmentDate"]')) regenerate();
            });
            form.addEventListener('change', function (e) {
                if (e.target.matches('[name="Step"], [name="FirstInstallmentDate"]')) regenerate();
            });
            regenerate();
        };

        // Pre-fill the total price from the selected unit (only if empty or unchanged).
        window.saleSetPrice = function (unitId) {
            var price = SALE_PRICES[unitId];
            var tp = document.querySelector('#appModalBody [name="TotalPrice"]');
            if (tp && price != null && (!tp.value || tp.value === '0')) tp.value = price;
        };

        // Filter the units dropdown to the chosen project (empty = show all units).
        window.saleFilterUnits = function (projectId) {
            var sel = document.querySelector('#appModalBody [name="UnitId"]');
            if (!sel) return;
            var pid = (projectId || '').toLowerCase();
            var cur = sel.value;
            for (var i = 0; i < sel.options.length; i++) {
                var o = sel.options[i];
                if (!o.value) { o.hidden = false; continue; }
                o.hidden = !!pid && (o.getAttribute('data-project') || '').toLowerCase() !== pid;
            }
            var co = cur ? sel.querySelector('option[value="' + cur + '"]') : null;
            if (co && co.hidden) sel.value = '';
        };
    </script>
}
