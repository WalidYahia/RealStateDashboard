@model SalesInvoiceDetailsVm
@{
    var inv = Model.Invoice;
    ViewData["Title"] = $"فاتورة مبيعات SI-{inv.Number}";
    // Popup (loaded into a modal): no layout, and read-only — actions that open their own popups stay on the full page.
    var popup = ViewData["Popup"] as bool? ?? false;
    if (popup) Layout = null;
    var canDeleteCollection = !popup && User.Can(PermissionNames.SalesInvoicesDeleteCollection);
    var canViewCustomers = User.Can(PermissionNames.CustomersView);
    var canViewInventory = !popup && User.Can(PermissionNames.InventoryView);
    var canReturn = !popup && User.Can(PermissionNames.SalesReturnsCreate);
    var canViewReturns = User.Can(PermissionNames.SalesReturnsView);
    var hasReturns = Model.Returns.Count > 0;
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string Q(decimal v) => v.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
    string D(DateTime d) => RealState.Web.AppCulture.When(d);   // date + time when it has one
    string St(InventoryDocStatus s) => s switch { InventoryDocStatus.Posted => "مُرحَّل", InventoryDocStatus.Reversed => "معكوس", _ => "مسودة" };
    // Something left to return (exact per-line availability is shown on the return form).
    var returnable = Model.Returned < Model.Total;
}
<div class="page-head">
    <div>
        <h1>فاتورة مبيعات <span class="proj-code" dir="ltr">SI-@inv.Number</span>
            @if (!popup)
            {
                <button type="button" title="شرح فاتورة المبيعات" onclick="appOpenModal('@Url.Action("Help")', 'شرح فاتورة المبيعات')" style="border:none;background:none;cursor:pointer;font-size:18px;vertical-align:middle;">❓</button>
            }
        </h1>
        <p style="color:var(--muted);margin:2px 0 0;">
            @Model.Customer · @RealState.Web.AppCulture.When(inv.InvoiceDate)
            · <span class="badge-state @inv.PaymentType.BadgeClass()">@inv.PaymentType.Ar()</span>@if (Model.CashSafe is not null) { <text> (خزنة @Model.CashSafe)</text> }
            @if (Model.Warehouse is not null) { <text> · المخزن: @Model.Warehouse</text> }
        </p>
        <partial name="_AuditStamp" model="RealState.Web.Models.AuditStampVm.Of(inv)" />
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        @if (popup)
        {
            <a class="btn-sm" asp-action="Details" asp-route-id="@inv.Id">↗ فتح صفحة الفاتورة</a>
        }
        else
        {
            <a class="btn-sm" asp-action="Index" onclick="if (history.length > 1) { history.back(); return false; }">رجوع</a>
        }
        @if (canViewCustomers)
        {
            <a class="btn-sm" asp-area="CRM" asp-controller="Customers" asp-action="Details" asp-route-id="@inv.CustomerId">ملف العميل</a>
        }
        <a class="btn-new-tenant" asp-action="PrintInvoice" asp-route-id="@inv.Id" target="_blank">🖨 طباعة الفاتورة (PDF)</a>
        @if (canReturn && returnable)
        {
            <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", "SalesReturns", new { invoiceId = inv.Id })', 'مرتجع مبيعات جديد', 'xl')">↩ مرتجع</button>
        }
        @* An invoice with returns is locked: they're tied to its lines, quantities and prices. *@
        @if (!popup && User.Can(PermissionNames.SalesInvoicesEdit) && !hasReturns)
        {
            <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = inv.Id })', 'تعديل فاتورة المبيعات', 'xl')">✏️ تعديل</button>
        }
        @if (!popup && User.Can(PermissionNames.SalesInvoicesDelete) && !hasReturns)
        {
            <form asp-action="Delete" asp-route-id="@inv.Id" method="post" style="display:inline;" data-confirm="حذف فاتورة المبيعات SI-@inv.Number؟ سيتم عكس قيدها المحاسبي وعكس إذن الصرف (إرجاع الأصناف للمخزن)." data-danger>@Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">🗑 حذف الفاتورة</button></form>
        }
    </div>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

@* Payments are on the customer's account (كشف الحساب), not on the invoice — so the invoice shows its value only. *@
<div class="kpi-grid" style="grid-template-columns: repeat(3, 1fr);">
    <div class="kpi k-reserve"><div class="kpi-label">إجمالي الفاتورة</div><div class="kpi-value">@N(Model.Total) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@inv.Items.Count صنف</div></div>
    <div class="kpi k-collect"><div class="kpi-label">المرتجعات</div><div class="kpi-value">@N(Model.Returned) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@Model.Returns.Count مرتجع</div></div>
    <div class="kpi k-sales"><div class="kpi-label">الصافي</div><div class="kpi-value">@N(Model.NetTotal) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@(inv.PaymentType == InvoicePaymentType.Cash ? "نقدي — حُصِّل عند الإصدار" : "آجل — على حساب العميل")</div></div>
</div>

<div class="card-tile" style="margin-bottom:14px;">
    <div class="card-head"><h3>الأصناف</h3></div>
    <table class="rs-table">
        <thead><tr><th>الصنف</th><th>الوحدة</th><th>سعر البيع</th><th>الكمية</th><th>الإجمالي</th></tr></thead>
        <tbody>
        @foreach (var it in inv.Items)
        {
            <tr><td>@it.Name</td><td>@(it.Unit ?? "—")</td><td>@N(it.Price)</td><td dir="ltr" style="text-align:right;">@Q(it.Quantity)</td><td>@N(it.LineTotal)</td></tr>
        }
        </tbody>
        <tfoot>
            <tr><th colspan="4">الإجمالي</th><th>@N(Model.Total) ج.م</th></tr>
            @if (hasReturns)
            {
                <tr><th colspan="4">المرتجعات</th><th>− @N(Model.Returned) ج.م</th></tr>
                <tr><th colspan="4">الصافي بعد المرتجعات</th><th>@N(Model.NetTotal) ج.م</th></tr>
            }
        </tfoot>
    </table>
    @if (!string.IsNullOrWhiteSpace(inv.Notes))
    {
        <p style="color:var(--muted);margin-top:10px;">ملاحظات: @inv.Notes</p>
    }
</div>

<div class="card-tile" style="margin-bottom:14px;">
    <div class="card-head"><h3>صرف المخزون (إذن صرف تلقائي)</h3></div>
    <table class="rs-table">
        <thead><tr><th>رقم الإذن</th><th>التاريخ</th><th>تكلفة المبيعات</th><th>الحالة</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model.Issues)
        {
            <tr>
                <td dir="ltr" style="text-align:right;">@r.Number</td>
                <td dir="ltr" style="text-align:right;">@D(r.Date)</td>
                <td>@N(r.Cost)</td>
                <td><span style="color:@(r.Status == InventoryDocStatus.Posted ? "var(--good)" : "var(--muted)");">@St(r.Status)</span></td>
                <td>
                    @if (canViewInventory)
                    {
                        <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Details", "GoodsIssues", new { area = "Inventory", id = r.Id })', 'تفاصيل إذن الصرف')">📄 التفاصيل</button>
                    }
                </td>
            </tr>
        }
        @if (Model.Issues.Count == 0)
        {
            <tr><td colspan="5" style="color:var(--muted)">لا توجد أصناف مخزنية في هذه الفاتورة — لم يُنشأ إذن صرف.</td></tr>
        }
        </tbody>
    </table>
</div>

@if (hasReturns || (canReturn && returnable))
{
    <div class="card-tile" style="margin-bottom:14px;">
        <div class="card-head"><h3>المرتجعات</h3></div>
        <table class="rs-table">
            <thead><tr><th>رقم المرتجع</th><th>التاريخ</th><th>القيمة</th><th>رُدّ نقدًا</th><th>خُصم من الرصيد</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model.Returns)
            {
                <tr>
                    <td dir="ltr" style="text-align:right;">
                        @if (canViewReturns) { <a asp-controller="SalesReturns" asp-action="Details" asp-route-id="@r.Id" style="color:var(--series-1);">SR-@r.Number</a> } else { <text>SR-@r.Number</text> }
                    </td>
                    <td dir="ltr" style="text-align:right;">@D(r.Date)</td>
                    <td>@N(r.Total)</td>
                    <td class="tag-up">@N(r.Refund)</td>
                    <td>@N(r.Total - r.Refund)</td>
                    <td style="white-space:nowrap;">
                        @if (canViewReturns)
                        {
                            <a class="btn-sm" asp-controller="SalesReturns" asp-action="Print" asp-route-id="@r.Id" target="_blank">🖨 المرتجع</a>
                            @if (r.RefundVoucherNo.HasValue)
                            {
                                <a class="btn-sm" asp-controller="SalesReturns" asp-action="RefundVoucher" asp-route-id="@r.Id" target="_blank">🖨 إيصال صرف نقدية</a>
                            }
                        }
                    </td>
                </tr>
            }
            @if (!hasReturns)
            {
                <tr><td colspan="6" style="color:var(--muted)">لا توجد مرتجعات على هذه الفاتورة.</td></tr>
            }
            </tbody>
        </table>
    </div>
}

@* A cash invoice's automatic collection, and collections recorded on the invoice before payments moved to the account. *@
@if (inv.Collections.Count > 0)
{
<div class="card-tile">
    <div class="card-head"><h3>التحصيلات</h3></div>
    <table class="rs-table">
        <thead><tr><th>رقم الإيصال</th><th>التاريخ</th><th>المبلغ</th><th>ملاحظات</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in inv.Collections)
        {
            <tr>
                <td dir="ltr" style="text-align:right;">@c.ReceiptNo</td>
                <td dir="ltr" style="text-align:right;">@D(c.CollectedDate)</td>
                <td class="tag-up">@N(c.Amount)</td>
                <td>@(c.Description ?? "—")</td>
                <td style="white-space:nowrap;">
                    <a class="btn-sm" asp-action="CollectionReceipt" asp-route-id="@c.Id" target="_blank">🖨 إيصال استلام نقدية</a>
                    @if (c.IsInvoiceCash)
                    {
                        <span class="badge-state state-on" title="يتبع الفاتورة النقدية — يتعدّل ويُلغى معها">تحصيل الفاتورة النقدية</span>
                    }
                    else if (canDeleteCollection)
                    {
                        <form asp-action="CancelCollection" asp-route-id="@c.Id" method="post" style="display:inline;" data-confirm="إلغاء التحصيل رقم @c.ReceiptNo (@N(c.Amount) ج.م)؟ سيُحذف الإيراد من الخزنة ويعود المبلغ مستحقًا على العميل." data-danger>@Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">🗑 حذف</button></form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
}

@section Scripts {
    <script src="~/js/purchase-doc.js" asp-append-version="true"></script>
}
