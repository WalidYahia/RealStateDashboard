@model SalesCollectFormModel
@{
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
}
<form id="appModalForm" asp-area="Sales" asp-controller="SalesInvoices" asp-action="Collect" method="post" data-open-tab>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="InvoiceId" />

    <div class="status-message" style="background:var(--surface-2);border-color:var(--border);color:var(--text-secondary);">
        <div style="margin-bottom:6px;font-weight:600;">@Model.DocumentLabel</div>
        <div style="display:flex;gap:18px;flex-wrap:wrap;">
            <span>الإجمالي: <strong>@N(Model.Total)</strong> ج.م</span>
            <span>المحصَّل: <strong style="color:var(--good);">@N(Model.Collected)</strong> ج.م</span>
            <span>المتبقي: <strong style="color:var(--critical);">@N(Model.Remaining)</strong> ج.م</span>
        </div>
    </div>

    @if (Model.Safes.Count == 0)
    {
        <div class="status-message" style="background:rgba(250,178,25,.12);border-color:var(--warning);color:var(--warning);">
            لا توجد خزنة نشطة. أضف خزنة من صفحة الخزائن قبل التحصيل.
        </div>
    }

    <div class="form-grid">
        <div>
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" max="@Model.Remaining" dir="ltr" />
            <span asp-validation-for="Amount" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="SafeId" class="form-label"></label>
            <select asp-for="SafeId" class="form-control" asp-items="Model.Safes"><option value="">— اختر الخزنة —</option></select>
            <span asp-validation-for="SafeId" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="CollectedDate" class="form-label"></label>
            <input asp-for="CollectedDate" class="form-control" type="date" dir="ltr" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="CollectedDate" class="field-validation-error"></span>
        </div>
        <div class="full">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" />
        </div>
    </div>

    <button type="submit" class="btn-primary" style="margin-top:12px;" disabled="@(Model.Safes.Count == 0)">💵 تسجيل التحصيل وطباعة الإيصال</button>
</form>
