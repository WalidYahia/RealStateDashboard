@model List<StageDefinition>
@{
    ViewData["Title"] = "مراحل المشاريع";
}
<div class="page-head">
    <h1>تعريف مراحل المشاريع</h1>
    <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'مرحلة جديدة')">➕ مرحلة جديدة</button>
</div>

<p style="color:var(--muted);font-size:13px;margin-top:-6px;">قائمة موحّدة بأسماء المراحل تُستخدم عند إضافة المراحل للمشاريع.</p>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

<div class="card-tile">
    <table class="rs-table">
        <thead><tr><th>الترتيب</th><th>اسم المرحلة</th><th>الحالة</th><th></th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td dir="ltr" style="text-align:right;">@s.SortOrder</td>
                <td>@s.Name</td>
                <td><span class="badge-state @(s.IsActive ? "state-on" : "state-off")">@(s.IsActive ? "مفعّلة" : "متوقفة")</span></td>
                <td style="white-space:nowrap;">
                    <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = s.Id })', 'تعديل المرحلة')">تعديل</button>
                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline;" data-confirm="حذف المرحلة «@s.Name»؟" data-danger>
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-sm btn-danger">حذف</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="4" style="color:var(--muted)">لا توجد مراحل معرّفة بعد.</td></tr>
        }
        </tbody>
    </table>
</div>
