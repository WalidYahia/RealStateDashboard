@model List<ProjectAttachment>
@{
    Layout = null;
    var p = (Project)ViewBag.Project;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>مرفقات المشروع - @p.Name</title>
    <partial name="_PrintStyles" />
</head>
<body>
    <div class="no-print"><button onclick="window.print()">🖨 طباعة / حفظ PDF</button></div>
    <h1>مرفقات المشروع: @p.Name</h1>
    <div class="sub">الكود #@p.Code · عدد المرفقات @Model.Count · @DateTime.Now.ToString("yyyy/MM/dd HH:mm")</div>
    <table>
        <thead><tr><th>الملف</th><th>النوع</th><th>الحجم (KB)</th><th>التاريخ</th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr><td>@a.FileName</td><td>@a.ContentType</td><td>@((a.Size / 1024.0).ToString("N0"))</td><td>@a.CreatedAt.ToString("yyyy/MM/dd")</td></tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="4" class="muted">لا توجد مرفقات.</td></tr> }
        </tbody>
    </table>
    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
</body>
</html>
