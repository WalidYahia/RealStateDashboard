@model StageStateModel
<form id="appModalForm" asp-area="Projects" asp-controller="Stages" asp-action="StateForm" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="StageId" />
    <input type="hidden" asp-for="IsEnd" />

    <p style="color:var(--text-secondary);margin:0 0 12px;">
        @(Model.IsEnd ? "أدخل تاريخ إنهاء المرحلة الفعلي — سيُسجَّل كنشاط ويُحدِّث النهاية الفعلية." : "أدخل تاريخ بدء المرحلة الفعلي — سيُسجَّل كنشاط ويُحدِّث البداية الفعلية.")
    </p>

    <div class="form-grid">
        <div>
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" class="form-control" type="date" dir="ltr" />
            <span asp-validation-for="Date" class="field-validation-error"></span>
        </div>
    </div>

    <button type="submit" class="btn-primary" style="margin-top:12px;">@(Model.IsEnd ? "⏹ إنهاء المرحلة" : "▶ بدء المرحلة")</button>
</form>
