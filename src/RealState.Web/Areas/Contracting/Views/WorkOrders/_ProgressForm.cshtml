@model ProgressUpdateModel
@{
    var isPercent = Model.Field == WorkOrderField.Execution || Model.Field == WorkOrderField.Uplift;
    var label = Model.Field.Ar();
}
<form id="appModalForm" asp-area="Contracting" asp-controller="WorkOrders" asp-action="ProgressForm" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="WorkOrderId" />
    <input type="hidden" asp-for="Field" />
    <div class="form-grid">
        <div class="full">
            <label class="form-label">@label @(isPercent ? "(%)" : "(ج.م)")</label>
            <input asp-for="Value" class="form-control" type="number" step="0.01" min="0" dir="ltr" />
            <span asp-validation-for="Value" class="field-validation-error"></span>
        </div>
    </div>
    <p style="color:var(--muted);font-size:12px;margin-top:8px;">سيُسجَّل هذا التغيير في سجل الأمر بتاريخه الحالي.</p>
    <button type="submit" class="btn-primary" style="margin-top:8px;">💾 حفظ</button>
</form>
