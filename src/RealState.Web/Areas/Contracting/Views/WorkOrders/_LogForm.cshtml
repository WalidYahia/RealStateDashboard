@model WorkOrderLogEditModel
<form id="appModalForm" asp-area="Contracting" asp-controller="WorkOrders" asp-action="LogForm" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="WorkOrderId" />
    <input type="hidden" asp-for="Field" />
    <p style="color:var(--muted);font-size:13px;">الحقل: <strong>@Model.Field.Ar()</strong></p>
    <div class="form-grid">
        <div>
            <label asp-for="Value" class="form-label"></label>
            <input asp-for="Value" class="form-control" type="number" step="0.01" dir="ltr" />
            <span asp-validation-for="Value" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="At" class="form-label"></label>
            <input asp-for="At" class="form-control" type="datetime-local" dir="ltr" />
            <span asp-validation-for="At" class="field-validation-error"></span>
        </div>
    </div>
    <p style="color:var(--muted);font-size:12px;margin-top:8px;">تعديل السجل لا يغيّر القيمة الحالية للأمر — عدّل القيمة الحالية من زر التحديث في القائمة.</p>
    <button type="submit" class="btn-primary" style="margin-top:8px;">💾 حفظ</button>
</form>
