@model List<WorkOrderListItem>
@{
    Layout = null;
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string P(decimal v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    string D(DateTime d) => d.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture);
    var totalActual = Model.Sum(r => r.ActualTotal);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>أوامر الشغل</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, sans-serif; padding: 20px; color: #111; }
        h1 { font-size: 19px; text-align: center; margin: 4px 0; }
        .sub { text-align: center; color: #666; font-size: 12px; margin-bottom: 14px; }
        table { width: 100%; border-collapse: collapse; font-size: 11.5px; }
        th, td { border: 1px solid #ccc; padding: 5px 6px; text-align: start; unicode-bidi: plaintext; }
        th { background: #f2f2f2; }
        .no-print { margin-bottom: 12px; } @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    @await Component.InvokeAsync("ReportBackground", new { part = "open" })
    <div class="no-print"><button onclick="window.print()">🖨 طباعة / حفظ PDF</button></div>
    <h1>أوامر الشغل</h1>
    <div class="sub">العدد: @Model.Count · @DateTime.Now.ToString("yyyy/MM/dd HH:mm")</div>
    <table>
        <thead><tr><th>الرقم</th><th>التاريخ</th><th>المقاول</th><th>المشروع</th><th>البيان</th><th>الإجمالي</th><th>التنفيذ</th><th>التعلية</th><th>الخصومات</th><th>الإجمالي الفعلي</th><th>المدفوع</th><th>المتبقي</th></tr></thead>
        <tbody>
        @foreach (var o in Model)
        {
            <tr><td>WO-@o.Number</td><td>@D(o.OrderDate)</td><td>@o.Contractor</td><td>@o.Project</td><td>@o.ItemDescription</td><td>@N(o.Total)</td><td>@P(o.ExecutionPercent)</td><td>@P(o.UpliftPercent)</td><td>@N(o.Deductions)</td><td>@N(o.ActualTotal)</td><td>@N(o.Paid)</td><td>@N(o.Remaining)</td></tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="12">لا توجد أوامر شغل.</td></tr> }
        </tbody>
        <tfoot><tr><th colspan="9" style="text-align:start;">الإجمالي الفعلي</th><th>@N(totalActual)</th><th colspan="2"></th></tr></tfoot>
    </table>
    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
    @await Component.InvokeAsync("ReportBackground", new { part = "close" })
</body>
</html>
