                        { <option value="@((int)st)" selected="@(Model.Status == st)">@st.Ar()</option> }
                    </select>
                </div>
                <div class="fld">
                    <label class="form-label">الأهمية</label>
                    <select name="severity" class="form-control">
                        <option value="">الكل</option>
                        @foreach (var sv in Enum.GetValues<TaskSeverity>())
                        { <option value="@((int)sv)" selected="@(Model.Severity == sv)">@sv.Ar()</option> }
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn-primary">بحث</button>
                </div>
            </div>
        </form>
    </div>
    <div class="card-tile"><partial name="_MineTable" model="Model.Delegated" /></div>
</div>

<!-- Tab: assigned by me, to myself -->
<div id="mine-self" class="mine-tab" style="display:none;">
    <div class="card-tile" style="margin-bottom:12px;">
        <form asp-action="Mine" method="get" class="filter-form">
            <input type="hidden" name="tab" value="self" />
            <div class="filter-row">
                <div class="fld"><label class="form-label">من</label><input type="date" name="from" value="@F(Model.From)" class="form-control" dir="ltr" /></div>
                <div class="fld"><label class="form-label">إلى</label><input type="date" name="to" value="@F(Model.To)" class="form-control" dir="ltr" /></div>
                <div class="filter-presets">
                    <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today)" data-to="@F(DateTime.Today)">اليوم</button>
                    <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today.AddDays(-7))" data-to="@F(DateTime.Today)">آخر أسبوع</button>
                    <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today.AddMonths(-1))" data-to="@F(DateTime.Today)">آخر شهر</button>
                </div>
            </div>
            <div class="filter-row">
                <div class="fld">
                    <label class="form-label">الحالة</label>
                    <select name="status" class="form-control">
                        <option value="">الكل</option>
                        @foreach (var st in Enum.GetValues<WorkTaskStatus>())
                        { <option value="@((int)st)" selected="@(Model.Status == st)">@st.Ar()</option> }
                    </select>
                </div>
                <div class="fld">
                    <label class="form-label">الأهمية</label>
                    <select name="severity" class="form-control">
                        <option value="">الكل</option>
                        @foreach (var sv in Enum.GetValues<TaskSeverity>())
                        { <option value="@((int)sv)" selected="@(Model.Severity == sv)">@sv.Ar()</option> }
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn-primary">بحث</button>
                </div>
            </div>
        </form>
    </div>
    <div class="card-tile"><partial name="_MineTable" model="Model.SelfAssigned" /></div>
</div>

@section Scripts {
    <script src="~/js/tasks.js" asp-append-version="true"></script>
    <script>
        function showMineTab(name) {
            if (name !== 'delegated' && name !== 'self') name = 'assigned';
            ['assigned', 'delegated', 'self'].forEach(function (n) {
                var el = document.getElementById('mine-' + n);
                if (el) el.style.display = n === name ? '' : 'none';
            });
            document.querySelectorAll('.subtabs .subtab').forEach(function (a) {
                a.classList.toggle('active', a.getAttribute('data-tab') === name);
            });
            if (history.replaceState) history.replaceState(null, '', '#' + name);
        }
        function mineTab(e, name) { e.preventDefault(); showMineTab(name); }
        document.addEventListener('DOMContentLoaded', function () {
            var initial = (location.hash || '').replace('#', '') || '@Model.ActiveTab';
            showMineTab(initial);
        });
    </script>
}
