@model MyTasksVm
@{
    ViewData["Title"] = "مهامي";
    var canCreate = ViewData["CanCreate"] as bool? ?? false;
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    string? SInt(WorkTaskStatus? s) => s.HasValue ? ((int)s.Value).ToString() : null;
    string? VInt(TaskSeverity? v) => v.HasValue ? ((int)v.Value).ToString() : null;
    var statusItems = Enum.GetValues<WorkTaskStatus>().Select(st => new SelectListItem(st.Ar(), ((int)st).ToString())).ToList();
    var severityItems = Enum.GetValues<TaskSeverity>().Select(sv => new SelectListItem(sv.Ar(), ((int)sv).ToString())).ToList();
    // One shared filter bar per tab (the hidden «tab» keeps the user on the same tab after searching / resetting).
    FilterBarVm TabFilter(string tab) => FilterBarVm.For(Url.Action("Mine")).Hide("tab", tab).DateRange(F(Model.From), F(Model.To));
    var assignedFilter = TabFilter("assigned")
        .Select("assignedBy", "أسندها", Model.Assigners, Model.AssignedBy)
        .Select("status", "الحالة", statusItems, SInt(Model.Status))
        .Select("severity", "الأهمية", severityItems, VInt(Model.Severity));
    var delegatedFilter = TabFilter("delegated")
        .Select("assignedToId", "المُكلَّف", Model.Assignees, Model.AssignedToId)
        .Select("status", "الحالة", statusItems, SInt(Model.Status))
        .Select("severity", "الأهمية", severityItems, VInt(Model.Severity));
    var selfFilter = TabFilter("self")
        .Select("status", "الحالة", statusItems, SInt(Model.Status))
        .Select("severity", "الأهمية", severityItems, VInt(Model.Severity));
}
<div class="page-head">
    <h1>مهامي</h1>
    @if (canCreate) { <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'إسناد مهمة')">➕ إسناد مهمة</button> }
</div>

@if (TempData["StatusMessage"] is string status) { <div class="status-message">@status</div> }

<div class="subtabs" style="margin-top:6px;">
    <a class="subtab" data-tab="assigned" href="javascript:" onclick="mineTab(event,'assigned')">المُسندة إليّ (@Model.Assigned.Count)</a>
    <a class="subtab" data-tab="delegated" href="javascript:" onclick="mineTab(event,'delegated')">التي أسندتها (@Model.Delegated.Count)</a>
    <a class="subtab" data-tab="self" href="javascript:" onclick="mineTab(event,'self')">أسندتها لنفسي (@Model.SelfAssigned.Count)</a>
</div>

<!-- Tab: assigned to me -->
<div id="mine-assigned" class="mine-tab">
    <partial name="_FilterBar" model="assignedFilter" />
    <div class="card-tile"><partial name="_MineTable" model="Model.Assigned" /></div>
</div>

<!-- Tab: assigned by me -->
<div id="mine-delegated" class="mine-tab" style="display:none;">
    <partial name="_FilterBar" model="delegatedFilter" />
    <div class="card-tile"><partial name="_MineTable" model="Model.Delegated" /></div>
</div>

<!-- Tab: assigned by me, to myself -->
<div id="mine-self" class="mine-tab" style="display:none;">
    <partial name="_FilterBar" model="selfFilter" />
    <div class="card-tile"><partial name="_MineTable" model="Model.SelfAssigned" /></div>
</div>

@section Scripts {
    <script src="~/js/tasks.js" asp-append-version="true"></script>
    <script>
        function showMineTab(name) {
            if (name !== 'delegated' && name !== 'self') name = 'assigned';
            ['assigned', 'delegated', 'self'].forEach(function (n) {
                var el = document.getElementById('mine-' + n);
                if (el) el.style.display = n === name ? '' : 'none';
            });
            document.querySelectorAll('.subtabs .subtab').forEach(function (a) {
                a.classList.toggle('active', a.getAttribute('data-tab') === name);
            });
            if (history.replaceState) history.replaceState(null, '', '#' + name);
        }
        function mineTab(e, name) { e.preventDefault(); showMineTab(name); }
        document.addEventListener('DOMContentLoaded', function () {
            var initial = (location.hash || '').replace('#', '') || '@Model.ActiveTab';
            showMineTab(initial);
        });
    </script>
}
