@model MyTasksVm
@{
    ViewData["Title"] = "مهامي";
    var canCreate = ViewData["CanCreate"] as bool? ?? false;
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="page-head">
    <h1>مهامي</h1>
    @if (canCreate) { <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'إسناد مهمة')">➕ إسناد مهمة</button> }
</div>

@if (TempData["StatusMessage"] is string status) { <div class="status-message">@status</div> }

<div class="subtabs" style="margin-top:6px;">
    <a class="subtab" data-tab="assigned" href="javascript:" onclick="mineTab(event,'assigned')">المُسندة إليّ (@Model.Assigned.Count)</a>
    <a class="subtab" data-tab="delegated" href="javascript:" onclick="mineTab(event,'delegated')">التي أسندتها (@Model.Delegated.Count)</a>
    <a class="subtab" data-tab="self" href="javascript:" onclick="mineTab(event,'self')">أسندتها لنفسي (@Model.SelfAssigned.Count)</a>
</div>

<!-- Tab: assigned to me -->
<div id="mine-assigned" class="mine-tab">
    <div class="card-tile" style="margin-bottom:12px;">
        <form asp-action="Mine" method="get" class="filter-form">
            <input type="hidden" name="tab" value="assigned" />
            <div class="filter-row">
                <div class="fld"><label class="form-label">من</label><input type="date" name="from" value="@F(Model.From)" class="form-control" dir="ltr" /></div>
                <div class="fld"><label class="form-label">إلى</label><input type="date" name="to" value="@F(Model.To)" class="form-control" dir="ltr" /></div>
                <div class="filter-presets">
                    <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today)" data-to="@F(DateTime.Today)">اليوم</button>
                    <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today.AddDays(-7))" data-to="@F(DateTime.Today)">آخر أسبوع</button>
                    <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today.AddMonths(-1))" data-to="@F(DateTime.Today)">آخر شهر</button>
                </div>
            </div>
            <div class="filter-row">
                <div class="fld">
                    <label class="form-label">أسندها</label>
                    <select name="assignedBy" class="form-control">
                        <option value="">الكل</option>
                        @foreach (var a in Model.Assigners)
                        { <option value="@a.Value" selected="@(Model.AssignedBy == a.Value)">@a.Text</option> }
                    </select>
                </div>
                <div class="fld">
                    <label class="form-label">الحالة</label>
                    <select name="status" class="form-control">
                        <option value="">الكل</option>
                        @foreach (var st in Enum.GetValues<WorkTaskStatus>())
                        { <option value="@((int)st)" selected="@(Model.Status == st)">@st.Ar()</option> }
                    </select>
                </div>
                <div class="fld">
                    <label class="form-label">الأهمية</label>
                    <select name="severity" class="form-control">
                        <option value="">الكل</option>
                        @foreach (var sv in Enum.GetValues<TaskSeverity>())
                        { <option value="@((int)sv)" selected="@(Model.Severity == sv)">@sv.Ar()</option> }
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn-primary">بحث</button>
                </div>
            </div>
        </form>
    </div>
    <div class="card-tile"><partial name="_MineTable" model="Model.Assigned" /></div>
</div>

<!-- Tab: assigned by me -->
<div id="mine-delegated" class="mine-tab" style="display:none;">
    <div class="card-tile" style="margin-bottom:12px;">
        <form asp-action="Mine" method="get" class="filter-form">
            <input type="hidden" name="tab" value="delegated" />
            <div class="filter-row">
                <div class="fld"><label class="form-label">من</label><input type="date" name="from" value="@F(Model.From)" class="form-control" dir="ltr" /></div>
                <div class="fld"><label class="form-label">إلى</label><input type="date" name="to" value="@F(Model.To)" class="form-control" dir="ltr" /></div>
                <div class="filter-presets">
                    <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today)" data-to="@F(DateTime.Today)">اليوم</button>
                    <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today.AddDays(-7))" data-to="@F(DateTime.Today)">آخر أسبوع</button>
                    <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today.AddMonths(-1))" data-to="@F(DateTime.Today)">آخر شهر</button>
                </div>
            </div>
            <div class="filter-row">
                <div class="fld">
                    <label class="form-label">المُكلَّف</label>
                    <select name="assignedToId" class="form-control">
                        <option value="">الكل</option>
                        @foreach (var e in Model.Assignees)
                        { <option value="@e.Value" selected="@(Model.AssignedToId?.ToString() == e.Value)">@e.Text</option> }
                    </select>
                </div>
                <div class="fld">
                    <label class="form-label">الحالة</label>
                    <select name="status" class="form-control">
