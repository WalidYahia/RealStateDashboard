@model TaskListVm
@{
    ViewData["Title"] = "قائمة المهام";
    var canCreate = ViewData["CanCreate"] as bool? ?? false;
    var canEdit = ViewData["CanEdit"] as bool? ?? false;
    var canDelete = ViewData["CanDelete"] as bool? ?? false;
    string D(DateTime? d) => d?.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture) ?? "—";
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    string Trunc(string s) => s.Length > 60 ? s[..60] + "…" : s;
}
@{
    string? SInt(WorkTaskStatus? s) => s.HasValue ? ((int)s.Value).ToString() : null;
    string? VInt(TaskSeverity? v) => v.HasValue ? ((int)v.Value).ToString() : null;
}
<div class="page-head">
    <h1>قائمة المهام</h1>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        @if (canCreate) { <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'إسناد مهمة')">➕ إسناد مهمة</button> }
    </div>
</div>

@if (TempData["StatusMessage"] is string status) { <div class="status-message">@status</div> }

@{
    var filter = FilterBarVm.For(Url.Action("Index"))
        .DateRange(F(Model.From), F(Model.To))
        .Select("departmentId", "القسم", Model.Departments, Model.DepartmentId)
        .Select("assigneeId", "المُكلَّف", Model.Employees, Model.AssigneeId)
        .Select("assignedBy", "أسندها", Model.Assigners, Model.AssignedBy)
        .Select("status", "الحالة", Enum.GetValues<WorkTaskStatus>().Select(st => new SelectListItem(st.Ar(), ((int)st).ToString())), SInt(Model.Status))
        .Select("severity", "الأهمية", Enum.GetValues<TaskSeverity>().Select(sv => new SelectListItem(sv.Ar(), ((int)sv).ToString())), VInt(Model.Severity))
        .Print(Url.Action("PrintList", new { from = F(Model.From), to = F(Model.To), departmentId = Model.DepartmentId, assigneeId = Model.AssigneeId, assignedBy = Model.AssignedBy, status = SInt(Model.Status), severity = VInt(Model.Severity), withLog = "false" }), "طباعة القائمة")
        .Print(Url.Action("PrintList", new { from = F(Model.From), to = F(Model.To), departmentId = Model.DepartmentId, assigneeId = Model.AssigneeId, assignedBy = Model.AssignedBy, status = SInt(Model.Status), severity = VInt(Model.Severity), withLog = "true" }), "طباعة مع السجل");
}
<partial name="_FilterBar" model="filter" />

<div class="card-tile">
    <div class="list-search-bar"><input class="form-control list-search" id="taskSearch" data-target="#tasksTable" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="tasksTable" data-paginate="15" data-search-input="#taskSearch">
        <thead>
            <tr>
                <th>رقم المهمة</th><th>تاريخ الإسناد</th><th>أسندها</th><th>المُكلَّف</th><th>القسم</th>
                <th>الاستحقاق</th><th>الوصف</th><th>الأهمية</th><th>الحالة</th><th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td style="white-space:nowrap;"><span style="display:inline-flex;align-items:center;gap:6px;direction:rtl;"><a asp-action="Details" asp-route-id="@r.Id" style="color:var(--series-1);text-decoration:none;font-weight:700;">T-@r.Number</a>@if (r.HasAttachments) {<span title="يوجد مرفقات على هذه المهمة" style="font-size:18px;line-height:1;cursor:default;">📎</span>}</span></td>
                <td dir="ltr" style="text-align:right;">@D(r.AssignedOn)</td>
                <td>@r.AssignedBy</td>
                <td>@r.Assignee</td>
                <td>@r.Department</td>
                <td dir="ltr" style="text-align:right;">@D(r.DueAt)</td>
                <td title="@r.Description">@Trunc(r.Description)</td>
                <td><span class="badge-role" style="color:@r.Severity.Color()">@r.Severity.Ar()</span></td>
                <td><span class="badge-role" style="color:@r.Status.Color()">@r.Status.Ar()</span></td>
                <td style="white-space:nowrap;">
                    <a class="btn-sm" asp-action="Details" asp-route-id="@r.Id">التفاصيل</a>
                    @if (canEdit) { <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = r.Id })', 'تعديل المهمة T-@r.Number')">✏️ تعديل</button> }
                </td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr data-skip-page><td colspan="10" style="color:var(--muted)">لا توجد مهام مطابقة.</td></tr> }
        <tr data-no-results data-skip-search data-skip-page style="display:none;"><td colspan="10" style="color:var(--muted)">لا توجد نتائج مطابقة.</td></tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/tasks.js" asp-append-version="true"></script>
}
