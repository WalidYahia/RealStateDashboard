@model LeaveRequestListVm
@{
    ViewData["Title"] = "إذن تأخير/إنصراف";
    var canManage = ViewData["CanManage"] as bool? ?? false;
    string D(DateTime d) => d.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture);
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    string H(decimal v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="page-head">
    <h1>إذن تأخير/إنصراف</h1>
    <div style="display:flex;gap:8px;">
        <a class="btn-sm" asp-action="PrintList" asp-route-from="@F(Model.From)" asp-route-to="@F(Model.To)" asp-route-q="@Model.Q" target="_blank">🖨 طباعة القائمة</a>
        @if (canManage) { <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'طلب إذن جديد')">➕ طلب إذن</button> }
    </div>
</div>

@if (TempData["StatusMessage"] is string status) { <div class="status-message">@status</div> }

@{
    var filter = FilterBarVm.For(Url.Action("Index"))
        .DateRange(F(Model.From), F(Model.To), "التاريخ")
        .Text("q", "الموظف", Model.Q, "اسم الموظف");
}
<partial name="_FilterBar" model="filter" />

<div class="card-tile">
    <table class="rs-table">
        <thead><tr><th>الموظف</th><th>نوع الإذن</th><th>التاريخ</th><th>عدد الساعات</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.Employee</td>
                <td>@r.Type.Ar()</td>
                <td dir="ltr" style="text-align:right;">@D(r.Date)</td>
                <td dir="ltr" style="text-align:right;">@H(r.Hours)</td>
                <td style="white-space:nowrap;">
                    <a class="btn-sm" asp-action="PrintOne" asp-route-id="@r.Id" target="_blank">🖨</a>
                    @if (canManage) { <form asp-action="Delete" asp-route-id="@r.Id" method="post" style="display:inline;" data-confirm="حذف طلب الإذن؟" data-danger>@Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">🗑 حذف</button></form> }
                </td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="5" style="color:var(--muted)">لا توجد طلبات إذن في هذه الفترة.</td></tr> }
        </tbody>
    </table>
</div>
