@model AdvanceListVm
@{
    ViewData["Title"] = "السلف";
    var canManage = ViewData["CanManage"] as bool? ?? false;
    string N(decimal v) => v.ToString("N0", new System.Globalization.CultureInfo("ar-EG"));
    string D(DateTime d) => d.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture);
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    string ADV(int n) => "ADV-" + n.ToString("D4");
}
<div class="page-head">
    <h1>السلف</h1>
    @if (canManage) { <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'سلفة جديدة')">➕ سلفة</button> }
</div>

@if (TempData["StatusMessage"] is string status) { <div class="status-message">@status</div> }

<div class="card-tile" style="margin-bottom:12px;">
    <form asp-action="Index" method="get" class="filter-form">
        <div class="filter-row">
            <div class="fld"><label class="form-label">من</label><input type="date" name="from" value="@F(Model.From)" class="form-control" dir="ltr" /></div>
            <div class="fld"><label class="form-label">إلى</label><input type="date" name="to" value="@F(Model.To)" class="form-control" dir="ltr" /></div>
            <div class="filter-presets">
                <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today)" data-to="@F(DateTime.Today)">اليوم</button>
                <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today.AddDays(-7))" data-to="@F(DateTime.Today)">آخر أسبوع</button>
                <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today.AddMonths(-1))" data-to="@F(DateTime.Today)">آخر شهر</button>
            </div>
        </div>
        <div class="filter-row">
            <div class="fld"><label class="form-label">الموظف</label><input type="text" name="q" value="@Model.Q" class="form-control" placeholder="اسم الموظف" /></div>
            <div class="filter-actions">
                <button type="submit" class="btn-primary">بحث</button>
            </div>
        </div>
    </form>
</div>

<div class="card-tile">
    <table class="rs-table">
        <thead><tr><th>الرقم</th><th>الموظف</th><th>التاريخ</th><th>المبلغ</th><th>طريقة السداد</th><th>الحالة</th><th>المسدَّد</th><th>المتبقي</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td dir="ltr" style="text-align:right;"><a asp-action="Details" asp-route-id="@r.Id" style="color:var(--series-1);text-decoration:none;font-weight:600;">@ADV(r.Number)</a></td>
                <td>@r.Employee</td>
                <td dir="ltr" style="text-align:right;">@D(r.Date)</td>
                <td>@N(r.Amount)</td>
                <td>@r.RepaymentMethod.Ar()</td>
                <td><span class="badge-role" style="color:@(r.Status == RealState.Application.Enums.DisbursementStatus.Disbursed ? "var(--good)" : "var(--muted)")">@r.Status.Ar()</span></td>
                <td class="tag-up">@N(r.Repaid)</td>
                <td>@N(r.Remaining)</td>
                <td style="white-space:nowrap;">
                    <a class="btn-sm" asp-action="Details" asp-route-id="@r.Id">التفاصيل</a>
                    <a class="btn-sm" asp-action="Print" asp-route-id="@r.Id" target="_blank">🖨</a>
                    @if (canManage && r.Status == RealState.Application.Enums.DisbursementStatus.NotDisbursed)
                    {
                        <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = r.Id })', 'تعديل السلفة @ADV(r.Number)')">تعديل</button>
                    }
                    @* A disbursed advance can only be removed from the Expenses page (delete its disbursement expense there first). *@
                    @if (canManage && r.Status == RealState.Application.Enums.DisbursementStatus.NotDisbursed && r.Repaid == 0)
                    {
                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" style="display:inline;"
                              data-confirm="حذف السلفة @ADV(r.Number)؟" data-danger>
                            @Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">حذف</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="9" style="color:var(--muted)">لا توجد سلف في هذه الفترة.</td></tr> }
        </tbody>
    </table>
    <p style="color:var(--muted);font-size:12px;margin-top:8px;">💡 تُصرف السلفة من صفحة المصروفات (النوع: سلفة). سداد السلف النقدية يتم من صفحة الإيرادات (النوع: سلفة).</p>
</div>

@section Scripts {
    <script>
        // Show the from-salary fields only when repayment method = من الراتب (value 0).
        window.advMethodChange = function (form) {
            if (!form) return;
            var sel = form.querySelector('[name="RepaymentMethod"]');
            var show = sel && sel.value === '0';
            form.querySelectorAll('.adv-salary').forEach(function (el) { el.style.display = show ? '' : 'none'; });
        };
    </script>
}
