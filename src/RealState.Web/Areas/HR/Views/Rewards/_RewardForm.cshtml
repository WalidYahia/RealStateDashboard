@model RewardFormModel
<form id="appModalForm" asp-area="Hr" asp-controller="Rewards" asp-action="Form" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    @if (Model.Employees.Count == 0)
    {
        <div class="status-message" style="background:rgba(250,178,25,.12);border-color:var(--warning);color:var(--warning);">أضف موظفًا أولًا.</div>
    }
    <div class="form-grid">
        <div>
            <label asp-for="EmployeeId" class="form-label"></label>
            <select asp-for="EmployeeId" class="form-control" asp-items="Model.Employees"><option value="">— اختر الموظف —</option></select>
            <span asp-validation-for="EmployeeId" class="field-validation-error"></span>
        </div>
        <div><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" dir="ltr" /><span asp-validation-for="Amount" class="field-validation-error"></span></div>
        <div><label asp-for="Date" class="form-label"></label><input asp-for="Date" class="form-control" type="date" dir="ltr" /></div>
        <div><label asp-for="PayVia" class="form-label"></label><select asp-for="PayVia" class="form-control" asp-items="RealState.Web.ArabicLabels.RewardPayViaOptions(Model.PayVia)"></select></div>
        <div class="full"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
    </div>
    <button type="submit" class="btn-primary" style="margin-top:12px;" disabled="@(Model.Employees.Count == 0)">💾 حفظ المكافأة</button>
</form>
