@model BranchFormModel
<form id="appModalForm" asp-area="Hr" asp-controller="Hr" asp-action="BranchForm" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Code" />
    <div class="form-grid">
        <div>
            <label class="form-label">الكود</label>
            @* Assigned automatically on save (BR-001, BR-002, …). *@
            <input class="form-control" value="@(Model.Code ?? "تلقائي")" dir="ltr" readonly />
        </div>
        <div>
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" dir="ltr" />
            <span asp-validation-for="Phone" class="field-validation-error"></span>
        </div>
        <div class="full">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>
    </div>
    <button type="submit" class="btn-primary" style="margin-top:12px;">💾 حفظ</button>
</form>
