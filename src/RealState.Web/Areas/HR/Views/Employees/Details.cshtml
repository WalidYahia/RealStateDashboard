@model Employee
@{
    ViewData["Title"] = Model.FullName;
    var canManage = ViewData["CanManage"] as bool? ?? false;
    var attachments = ViewBag.Attachments as List<EmployeeAttachment> ?? new();
    string N(decimal v) => v.ToString("N0", RealState.Web.AppCulture.Ar);
    string D(DateTime? d) => RealState.Web.AppCulture.When(d);   // date + time when it has one
    string YN(bool b) => b ? "نعم" : "لا";
}
<div class="page-head">
    <div>
        <h1>@Model.FullName</h1>
        <p style="color:var(--muted);margin:2px 0 0;">@(Model.JobRole?.Name ?? "—") · @(Model.Department?.Name ?? "—") · @Model.EmploymentType.Ar()</p>
    </div>
    <div style="display:flex;gap:8px;">
        <a class="btn-sm" asp-action="Index" onclick="if (history.length > 1) { history.back(); return false; }">رجوع</a>
        @if (canManage) { <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = Model.Id })', 'تعديل الموظف')">✏️ تعديل</button> }
        @if (canManage)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;" data-confirm="حذف الموظف «@Model.FullName»؟ سيُحذف حساب الدخول المرتبط به (إن وجد) أيضًا." data-danger>@Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">🗑 حذف الموظف</button></form>
        }
    </div>
</div>

@if (TempData["StatusMessage"] is string status) { <div class="status-message">@status</div> }

<div class="grid-row" style="grid-template-columns: 1fr 1fr;">
    <div class="card-tile">
        <div class="card-head"><h3>البيانات الأساسية</h3></div>
        <table class="rs-table">
            <tr><th style="width:170px;">الهاتف</th><td dir="ltr" style="text-align:right;">@Model.Phone</td></tr>
            <tr><th>هاتف بديل</th><td dir="ltr" style="text-align:right;">@Model.AltPhone</td></tr>
            <tr><th>تاريخ الميلاد</th><td>@D(Model.BirthDate)</td></tr>
            <tr><th>الجنسية</th><td>@Model.Nationality</td></tr>
            <tr><th>الرقم القومي</th><td dir="ltr" style="text-align:right;">@Model.NationalId</td></tr>
            <tr><th>المؤهل الدراسي</th><td>@Model.AcademicQualification</td></tr>
            <tr><th>محل الإقامة</th><td>@Model.CurrentLocation</td></tr>
            <tr><th>البريد الإلكتروني</th><td dir="ltr" style="text-align:right;">@Model.Email</td></tr>
        </table>
    </div>
    <div class="card-tile">
        <div class="card-head"><h3>بيانات العمل</h3></div>
        <table class="rs-table">
            <tr><th style="width:170px;">القسم</th><td>@(Model.Department?.Name ?? "—")</td></tr>
            <tr><th>الوظيفة</th><td>@(Model.JobRole?.Name ?? "—")</td></tr>
            <tr><th>تاريخ بدء العمل</th><td>@D(Model.HireDate)</td></tr>
            <tr><th>نوع التعاقد</th><td>@Model.EmploymentType.Ar()</td></tr>
            <tr><th>تأمين اجتماعي</th><td>@YN(Model.SocialInsurance)</td></tr>
            <tr><th>تأمين طبي</th><td>@YN(Model.MedicalInsurance)</td></tr>
            <tr><th>الراتب الأساسي</th><td>@N(Model.BasicSalary) ج.م</td></tr>
            <tr><th>الحوافز والعمولات</th><td>@N(Model.IncentivesCommissions) ج.م</td></tr>
        </table>
    </div>
</div>

@{
    var linkedUser = ViewBag.LinkedUser as RealState.Application.Identity.ApplicationUser;
}
<div class="card-tile" style="margin-bottom:16px;">
    <div class="card-head">
        <h3>حساب الدخول المرتبط</h3>
        @if (canManage && linkedUser is null)
        {
            <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("LinkUserForm", new { id = Model.Id })', 'ربط بمستخدم')">🔗 ربط بمستخدم</button>
        }
    </div>
    @if (linkedUser is not null)
    {
        <table class="rs-table">
            <tr><th style="width:170px;">اسم الدخول</th><td dir="ltr" style="text-align:right;">@linkedUser.UserName</td></tr>
            <tr><th>الاسم</th><td>@linkedUser.FullName</td></tr>
            <tr><th>الحالة</th><td><span class="badge-state @(linkedUser.IsActive ? "state-on" : "state-off")">@(linkedUser.IsActive ? "مُفعّل" : "معطّل")</span></td></tr>
        </table>
        @if (canManage)
        {
            <div style="margin-top:12px;">
                <form asp-action="Unlink" asp-route-id="@Model.Id" method="post" style="display:inline;" data-confirm="إلغاء ربط الحساب بهذا الموظف؟ لن يُحذف المستخدم.">@Html.AntiForgeryToken()<button type="submit" class="btn-sm">إلغاء الربط</button></form>
            </div>
        }
    }
    else
    {
        <p style="color:var(--muted);">لا يوجد حساب دخول مرتبط بهذا الموظف.</p>
    }
</div>

@{
    var finCustodies = ViewBag.FinancialCustodies as List<RealState.Web.Areas.Accounting.Models.FinancialCustodyRow>;
    var matCustodies = ViewBag.MaterialCustodies as List<RealState.Web.Areas.Accounting.Models.MaterialCustodyRow>;
    string N2(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    const string Link = "color:var(--series-1);font-weight:600;text-decoration:none;";
}
@if (finCustodies is not null || matCustodies is not null)
{
    <div class="card-tile" style="margin-bottom:16px;">
        <div class="card-head">
            <h3>العُهد</h3>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                @if (finCustodies is not null)
                {
                    var openBalance = finCustodies.Where(c => c.Status == FinancialCustodyStatus.Open).Sum(c => c.Balance);
                    <span class="pill">رصيد العُهد المالية المفتوحة: @N2(openBalance) ج.م</span>
                }
                @if (matCustodies is not null)
                {
                    <span class="pill">عُهد عينية لدى الموظف: @matCustodies.Count(c => c.Status == MaterialCustodyStatus.HandedOver)</span>
                }
            </div>
        </div>

        @if (finCustodies is not null)
        {
            <h4 class="emp-custody-title">العُهد المالية</h4>
            <table class="rs-table">
                <thead><tr><th>الرقم</th><th>اسم العهدة</th><th>التاريخ</th><th>المصروف للموظف</th><th>المصروفات المعتمدة</th><th>المردود</th><th>الرصيد</th><th>الحالة</th></tr></thead>
                <tbody>
                @foreach (var c in finCustodies)
                {
                    <tr>
                        <td dir="ltr" style="text-align:right;white-space:nowrap;"><a asp-area="Accounting" asp-controller="FinancialCustody" asp-action="Details" asp-route-id="@c.Id" style="@Link">FC-@c.Number</a></td>
                        <td>@c.Purpose</td>
                        <td dir="ltr" style="text-align:right;">@D(c.Date)</td>
                        <td>@N2(c.Disbursed)</td>
                        <td>@N2(c.Spent)</td>
                        <td>@N2(c.Returned)</td>
                        <td style="font-weight:700;white-space:nowrap;color:@(c.Balance < 0 ? "var(--critical)" : c.Balance > 0 ? "var(--warning)" : "var(--good)");">@N2(c.Balance)</td>
                        <td><span class="badge-state @c.Status.BadgeClass()">@c.Status.Ar()</span></td>
                    </tr>
                }
                @if (finCustodies.Count == 0) { <tr><td colspan="8" style="color:var(--muted)">لا توجد عُهد مالية لهذا الموظف.</td></tr> }
                </tbody>
            </table>
        }

        @if (matCustodies is not null)
        {
            <h4 class="emp-custody-title">العُهد العينية</h4>
            <table class="rs-table">
                <thead><tr><th>الرقم</th><th>الصنف</th><th>النوع</th><th>الرقم التسلسلي</th><th>الكمية</th><th>التسليم</th><th>الإرجاع المتوقع</th><th>الاستلام</th><th>الحالة</th></tr></thead>
                <tbody>
                @foreach (var c in matCustodies)
                {
                    <tr>
                        <td dir="ltr" style="text-align:right;white-space:nowrap;"><a asp-area="Accounting" asp-controller="MaterialCustody" asp-action="Details" asp-route-id="@c.Id" style="@Link">MC-@c.Number</a></td>
                        <td>@c.ItemName</td>
                        <td>@(c.ItemType ?? "—")</td>
                        <td dir="ltr" style="text-align:right;">@(c.SerialNumber ?? "—")</td>
                        <td>@c.Quantity</td>
                        <td dir="ltr" style="text-align:right;">@D(c.HandoverDate)</td>
                        <td dir="ltr" style="text-align:right;@(c.IsOverdue ? "color:var(--critical);font-weight:700;" : "")">@D(c.ExpectedReturnDate)@(c.IsOverdue ? " ⚠" : "")</td>
                        <td dir="ltr" style="text-align:right;">@D(c.ReturnDate)</td>
                        <td><span class="badge-state @c.Status.BadgeClass()">@c.Status.Ar()</span></td>
                    </tr>
                }
                @if (matCustodies.Count == 0) { <tr><td colspan="9" style="color:var(--muted)">لا توجد عُهد عينية لهذا الموظف.</td></tr> }
                </tbody>
            </table>
        }
    </div>
}

<div class="card-tile">
    <div class="card-head"><h3>المرفقات</h3></div>
    @if (canManage)
    {
        <form asp-action="AttachmentUpload" method="post" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:end;flex-wrap:wrap;margin-bottom:14px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="employeeId" value="@Model.Id" />
            <div><label class="form-label">النوع</label><select name="kind" class="form-control" style="margin:0;" asp-items="RealState.Web.ArabicLabels.AttachmentKindOptions()"></select></div>
            <input type="file" name="file" class="form-control" style="margin:0;max-width:320px;" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt" />
            <button type="submit" class="btn-primary" style="width:auto;">⬆ رفع</button>
        </form>
    }
    <table class="rs-table">
        <thead><tr><th>النوع</th><th>الملف</th><th>الحجم</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in attachments)
        {
            <tr>
                <td>@a.Kind.Ar()</td>
                <td>@a.FileName</td>
                <td dir="ltr" style="text-align:right;">@((a.Size / 1024.0).ToString("N0")) KB</td>
                <td style="white-space:nowrap;">
                    <a class="btn-sm" asp-action="AttachmentPreview" asp-route-id="@a.Id" target="_blank">👁 معاينة</a>
                    <a class="btn-sm" asp-action="AttachmentDownload" asp-route-id="@a.Id" target="_blank">تنزيل</a>
                    @if (canManage)
                    {
                        <form asp-action="AttachmentDelete" asp-route-id="@a.Id" asp-route-employeeId="@Model.Id" method="post" style="display:inline;" data-confirm="حذف المرفق؟" data-danger>@Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">حذف</button></form>
                    }
                </td>
            </tr>
        }
        @if (attachments.Count == 0) { <tr><td colspan="4" style="color:var(--muted)">لا توجد مرفقات بعد.</td></tr> }
        </tbody>
    </table>
</div>
