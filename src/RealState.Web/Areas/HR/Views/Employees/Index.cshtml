@model List<EmployeeListItem>
@{
    ViewData["Title"] = "الموظفون";
    var canManage = ViewData["CanManage"] as bool? ?? false;
}
<div class="page-head"><h1>الموظفون</h1></div>

@if (TempData["StatusMessage"] is string status) { <div class="status-message">@status</div> }

<div class="card-tile">
    <div class="card-head">
        <h3>قائمة الموظفين</h3>
        <div style="display:flex;gap:12px;align-items:center;margin-inline-start:auto;flex-wrap:wrap;">
            <form asp-action="Print" method="get" target="_blank" style="display:flex;gap:12px;align-items:center;">
                <label style="font-size:13px;color:var(--text-secondary);display:flex;align-items:center;gap:6px;cursor:pointer;"><input type="checkbox" name="withSalary" value="true" /> طباعة مع الراتب</label>
                <label style="font-size:13px;color:var(--text-secondary);display:flex;align-items:center;gap:6px;cursor:pointer;"><input type="checkbox" name="withNationalId" value="true" /> طباعة مع الرقم القومي</label>
                <button type="submit" class="btn-sm">🖨 طباعة</button>
            </form>
            @if (canManage) { <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'موظف جديد')">➕ موظف جديد</button> }
        </div>
    </div>
    <div class="list-search-bar"><input class="form-control list-search" data-target="#empTable" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="empTable">
        <thead><tr><th>الاسم</th><th>الهاتف</th><th>القسم</th><th>الوظيفة</th><th>نوع التعاقد</th><th></th></tr></thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr data-search="@((e.Name + " " + e.Department + " " + e.Role).ToLower())">
                <td><a asp-action="Details" asp-route-id="@e.Id" style="color:var(--series-1);text-decoration:none;font-weight:600;">@e.Name</a></td>
                <td dir="ltr" style="text-align:right;">@e.Phone</td>
                <td>@e.Department</td>
                <td>@e.Role</td>
                <td>@e.EmploymentType</td>
                <td style="white-space:nowrap;">
                    <a class="btn-sm" asp-action="Details" asp-route-id="@e.Id">الملف</a>
                    @if (canManage)
                    {
                        <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = e.Id })', 'تعديل الموظف')">✏️ تعديل</button>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr data-skip-search><td colspan="6" style="color:var(--muted)">لا يوجد موظفون بعد.</td></tr> }
        <tr data-no-results data-skip-search style="display:none;"><td colspan="6" style="color:var(--muted)">لا توجد نتائج.</td></tr>
        </tbody>
    </table>
</div>
