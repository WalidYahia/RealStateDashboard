@model LinkUserFormModel
<form id="appModalForm" asp-area="Hr" asp-controller="Employees" asp-action="LinkUser" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="EmployeeId" />
    <p style="margin:0 0 12px;">ربط الموظف «<strong>@Model.EmployeeName</strong>» بحساب مستخدم قائم:</p>
    <div class="form-grid">
        <div class="full">
            <label asp-for="UserId" class="form-label"></label>
            <select asp-for="UserId" class="form-control" asp-items="Model.Users"><option value="">— اختر مستخدمًا —</option></select>
            <span asp-validation-for="UserId" class="field-validation-error"></span>
        </div>
    </div>
    @if (Model.Users.Count == 0)
    {
        <p style="color:var(--muted);font-size:12px;margin-top:8px;">لا يوجد مستخدمون غير مرتبطين بموظفين.</p>
    }
    <button type="submit" class="btn-primary" style="margin-top:12px;width:auto;">🔗 ربط</button>
</form>
