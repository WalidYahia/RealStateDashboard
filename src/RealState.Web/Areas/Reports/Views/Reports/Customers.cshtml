@model CustomerReportVm
@{
    ViewData["Title"] = "تقرير العملاء";
    string N(decimal v) => v.ToString("N0", RealState.Web.AppCulture.Ar);
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="page-head">
    <h1>تقرير العملاء</h1>
</div>

<div class="card-tile" style="margin-bottom:12px;">
    <form asp-action="Customers" method="get" class="filter-form">
        <div class="filter-row">
            <div class="fld"><label class="form-label">من (تاريخ العقد)</label><input type="date" name="from" value="@F(Model.From)" class="form-control" dir="ltr" /></div>
            <div class="fld"><label class="form-label">إلى</label><input type="date" name="to" value="@F(Model.To)" class="form-control" dir="ltr" /></div>
            <div class="filter-presets">
                <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today)" data-to="@F(DateTime.Today)">اليوم</button>
                <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today.AddDays(-7))" data-to="@F(DateTime.Today)">آخر أسبوع</button>
                <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today.AddMonths(-1))" data-to="@F(DateTime.Today)">آخر شهر</button>
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn-primary">بحث</button>
                <a class="btn-sm" asp-action="CustomersPrint" asp-route-from="@F(Model.From)" asp-route-to="@F(Model.To)" target="_blank">🖨 طباعة (PDF)</a>
                <a class="btn-sm" asp-action="CustomersCsv" asp-route-from="@F(Model.From)" asp-route-to="@F(Model.To)">⬇ Excel</a>
            </div>
        </div>
    </form>
</div>

<div class="card-tile">
    <div class="list-search-bar"><input class="form-control list-search" data-target="#custRepTable" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="custRepTable" data-live-totals>
        <thead>
            <tr><th>العميل</th><th>الهاتف</th><th>عدد العقود</th><th>قيمة العقود</th><th>أقساط متبقية</th><th>المحصَّل</th><th>المتبقي</th></tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.Name</td>
                <td dir="ltr" style="text-align:right;">@r.Phone</td>
                <td>@r.Contracts</td>
                <td>@N(r.ContractsValue)</td>
                <td>@r.RemainingInstallments</td>
                <td class="tag-up">@N(r.Collected)</td>
                <td>@N(r.Residual)</td>
            </tr>
        }
        @if (Model.Rows.Count == 0)
        {
            <tr data-skip-search><td colspan="7" style="color:var(--muted)">لا توجد بيانات في هذه الفترة.</td></tr>
        }
        <tr data-no-results data-skip-search style="display:none;"><td colspan="7" style="color:var(--muted)">لا توجد نتائج مطابقة للبحث.</td></tr>
        </tbody>
        <tfoot>
            <tr>
                <th colspan="2">الإجمالي</th>
                <th>@Model.TotContracts</th>
                <th>@N(Model.TotValue)</th>
                <th>@Model.TotRemInst</th>
                <th>@N(Model.TotCollected)</th>
                <th>@N(Model.TotResidual)</th>
            </tr>
        </tfoot>
    </table>
</div>
