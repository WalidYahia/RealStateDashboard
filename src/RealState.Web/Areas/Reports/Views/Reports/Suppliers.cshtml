@model SupplierReportVm
@{
    ViewData["Title"] = "تقرير الموردين";
    string N(decimal v) => v.ToString("N0", RealState.Web.AppCulture.Ar);
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="page-head">
    <h1>تقرير الموردين</h1>
</div>

@{
    // The report now aggregates purchase invoices (and legacy orders) by their date.
    var filter = FilterBarVm.For(Url.Action("Suppliers"))
        .DateRange(F(Model.From), F(Model.To), "تاريخ الفاتورة")
        .Print(Url.Action("SuppliersPrint", new { from = F(Model.From), to = F(Model.To) }))
        .Excel(Url.Action("SuppliersCsv", new { from = F(Model.From), to = F(Model.To) }));
}
<partial name="_FilterBar" model="filter" />

<div class="card-tile">
    <div class="list-search-bar"><input class="form-control list-search" data-target="#supRepTable" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="supRepTable" data-live-totals>
        <thead>
            <tr><th>المورد</th><th>الهاتف</th><th>عدد الفواتير</th><th>قيمة الفواتير</th><th>المسدَّد</th><th>المتبقي</th></tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.Name</td>
                <td dir="ltr" style="text-align:right;">@r.Phone</td>
                <td>@r.Orders</td>
                <td>@N(r.OrdersValue)</td>
                <td class="tag-up">@N(r.Paid)</td>
                <td>@N(r.Residual)</td>
            </tr>
        }
        @if (Model.Rows.Count == 0)
        {
            <tr data-skip-search><td colspan="6" style="color:var(--muted)">لا توجد بيانات في هذه الفترة.</td></tr>
        }
        <tr data-no-results data-skip-search style="display:none;"><td colspan="6" style="color:var(--muted)">لا توجد نتائج مطابقة للبحث.</td></tr>
        </tbody>
        <tfoot>
            <tr>
                <th colspan="2">الإجمالي</th>
                <th>@Model.TotOrders</th>
                <th>@N(Model.TotValue)</th>
                <th>@N(Model.TotPaid)</th>
                <th>@N(Model.TotResidual)</th>
            </tr>
        </tfoot>
    </table>
</div>
