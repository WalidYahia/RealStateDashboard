@model SupplierReportVm
@{
    Layout = null;
    var tenantId = (Guid)ViewBag.TenantId;
    string N(decimal v) => v.ToString("N0", RealState.Web.AppCulture.Ar);
    // A balance with its side: + = owed to the supplier (دائن), − = owed by them (مدين).
    string B(decimal v, string plus = "دائن", string minus = "مدين") => v == 0 ? N(0) : $"{N(Math.Abs(v))} {(v > 0 ? plus : minus)}";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>تقرير الموردين</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, sans-serif; padding: 24px; color: #111; }
        .brand { text-align: center; margin-bottom: 6px; } .brand img { max-height: 60px; }
        h1 { font-size: 19px; text-align: center; margin: 4px 0; }
        .sub { text-align: center; color: #666; font-size: 12px; margin-bottom: 14px; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th, td { border: 1px solid #ccc; padding: 5px 7px; text-align: start; unicode-bidi: plaintext; }
        th { background: #f2f2f2; }
        tfoot td, tfoot th { font-weight: 700; background: #fafafa; }
        .no-print { margin-bottom: 12px; } @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    @await Component.InvokeAsync("ReportBackground", new { part = "open" })
    <div class="no-print"><button onclick="window.print()">🖨 طباعة / حفظ PDF</button></div>
    <h1>تقرير الموردين</h1>
    <div class="sub">
        الرصيد الحالي لكل مورد كما في كشف حسابه · طُبع @ClientTime.Now.ToString("yyyy/MM/dd HH:mm")
    </div>

    <table>
        <thead><tr><th>المورد</th><th>الهاتف</th><th>دائن</th><th>مدين</th><th>الرصيد</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr><td>@r.Name@(r.IsLinked ? " (عميل ومورد)" : "")</td><td>@r.Phone</td><td>@N(r.Credit)</td><td>@N(r.Debit)</td><td>@B(r.Balance)</td></tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="5">لا يوجد موردون.</td></tr> }
        </tbody>
        <tfoot>
            <tr><th colspan="2">الإجمالي</th><th>@N(Model.TotCredit)</th><th>@N(Model.TotDebit)</th><th>@B(Model.TotBalance)</th></tr>
        </tfoot>
    </table>

    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
    @await Component.InvokeAsync("ReportBackground", new { part = "close" })
</body>
</html>
