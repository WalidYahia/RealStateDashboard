@model ProjectReportVm
@{
    Layout = null;
    string N(decimal v) => v.ToString("N0", new System.Globalization.CultureInfo("ar-EG"));
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>تقرير المشاريع</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, sans-serif; padding: 24px; color: #111; }
        h1 { font-size: 19px; text-align: center; margin: 4px 0; }
        .sub { text-align: center; color: #666; font-size: 12px; margin-bottom: 14px; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th, td { border: 1px solid #ccc; padding: 5px 7px; text-align: start; unicode-bidi: plaintext; }
        th { background: #f2f2f2; }
        tfoot td, tfoot th { font-weight: 700; background: #fafafa; }
        .no-print { margin-bottom: 12px; } @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    @await Component.InvokeAsync("ReportBackground", new { part = "open" })
    <div class="no-print"><button onclick="window.print()">🖨 طباعة / حفظ PDF</button></div>
    <h1>تقرير المشاريع</h1>
    <div class="sub">العدد: @Model.Rows.Count · طُبع @DateTime.Now.ToString("yyyy/MM/dd HH:mm")</div>

    <table>
        <thead>
            <tr>
                <th>المشروع</th><th>النوع</th><th>إجمالي الوحدات</th><th>مباعة</th><th>غير مباعة</th>
                <th>المصروفات</th><th>الإيرادات</th><th>قيمة المخزون</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>#@r.Code @r.Name</td>
                <td>@r.TypeName</td>
                <td>@r.UnitsTotal</td>
                <td>@r.UnitsSold</td>
                <td>@r.UnitsUnsold</td>
                <td>@N(r.Expenses)</td>
                <td>@N(r.Incomes)</td>
                <td>@N(r.InventoryValue)</td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="8">لا توجد مشاريع.</td></tr> }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="2">الإجمالي</th>
                <th>@Model.TotUnits</th><th>@Model.TotSold</th><th>@Model.TotUnsold</th>
                <th>@N(Model.TotExpenses)</th><th>@N(Model.TotIncomes)</th><th>@N(Model.TotInventory)</th>
            </tr>
        </tfoot>
    </table>

    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
    @await Component.InvokeAsync("ReportBackground", new { part = "close" })
</body>
</html>
