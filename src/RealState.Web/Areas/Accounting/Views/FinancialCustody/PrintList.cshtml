@model FinancialCustodyListVm
@{
    Layout = null;
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string D(DateTime? d) => RealState.Web.AppCulture.When(d);   // date + time when it has one
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>العُهد المالية</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, sans-serif; padding: 24px; color: #111; }
        h1 { font-size: 19px; text-align: center; margin: 4px 0; }
        .sub { text-align: center; color: #666; font-size: 12px; margin-bottom: 12px; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th, td { border: 1px solid #ccc; padding: 5px 7px; text-align: start; unicode-bidi: plaintext; }
        th { background: #f2f2f2; }
        tfoot td { font-weight: 700; background: #fafafa; }
        .no-print { margin-bottom: 12px; } @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    @await Component.InvokeAsync("ReportBackground", new { part = "open" })
    <div class="no-print"><button onclick="window.print()">🖨 طباعة / حفظ PDF</button></div>
    <h1>العُهد المالية</h1>
    <div class="sub">
        @if (Model.From.HasValue || Model.To.HasValue) { <text>الفترة @(Model.From.HasValue ? D(Model.From) : "البداية") — @(Model.To.HasValue ? D(Model.To) : "اليوم") · </text> }
        العدد @Model.Rows.Count · تاريخ الطباعة @ClientTime.Now.ToString("yyyy/MM/dd HH:mm")
    </div>
    <table>
        <thead><tr><th>الرقم</th><th>اسم العهدة</th><th>التاريخ</th><th>صاحب العهدة</th><th>المصروف للموظف</th><th>المصروفات المعتمدة</th><th>المردود</th><th>الرصيد</th><th>الحالة</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>FC-@r.Number</td><td>@r.Purpose</td><td>@D(r.Date)</td><td>@r.Employee</td>
                <td>@N(r.Disbursed)</td><td>@N(r.Spent)</td><td>@N(r.Returned)</td><td>@N(r.Balance)</td><td>@r.Status.Ar()</td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="9">لا توجد عُهد.</td></tr> }
        </tbody>
        <tfoot>
            <tr><td colspan="4">الإجمالي</td><td>@N(Model.Rows.Sum(r => r.Disbursed))</td><td>@N(Model.Rows.Sum(r => r.Spent))</td><td>@N(Model.Rows.Sum(r => r.Returned))</td><td>@N(Model.Rows.Sum(r => r.Balance))</td><td></td></tr>
        </tfoot>
    </table>
    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
    @await Component.InvokeAsync("ReportBackground", new { part = "close" })
</body>
</html>
