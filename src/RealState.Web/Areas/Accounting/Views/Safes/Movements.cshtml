@model SafeMovementsVm
@{
    ViewData["Title"] = $"حركات: {Model.SafeName}";
    string N(decimal v) => v.ToString("N0", RealState.Web.AppCulture.Ar);
    string DT(DateTime d) => d.ToString("yyyy/MM/dd HH:mm");
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd");
}
<div class="page-head">
    <div>
        <h1>حركات الخزنة: @Model.SafeName</h1>
        <p style="color:var(--muted);margin:2px 0 0;">الرصيد الحالي: <strong>@N(Model.Balance)</strong> ج.م</p>
    </div>
    <div style="display:flex;gap:8px;">
        <a class="btn-sm" asp-action="Index" onclick="if (history.length > 1) { history.back(); return false; }">رجوع للخزائن</a>
    </div>
</div>

@{
    var filter = FilterBarVm.For(Url.Action("Movements"))
        .Hide("id", Model.SafeId)
        .WithTitle("تصفية الحركات")
        .DateRange(F(Model.From), F(Model.To))
        .Print(Url.Action("PrintMovements", new { id = Model.SafeId, from = F(Model.From), to = F(Model.To) }), "طباعة")
        .Excel(Url.Action("CsvMovements", new { id = Model.SafeId, from = F(Model.From), to = F(Model.To), q = Model.Q }));
}
<partial name="_FilterBar" model="filter" />

<div class="card-tile">
    <div class="list-search-bar"><input class="form-control list-search" data-target="#movTable" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="movTable">
        <thead><tr><th>#</th><th>التاريخ/الوقت</th><th>النوع</th><th>المصدر</th><th>البيان</th><th>المبلغ</th><th>الرصيد</th></tr></thead>
        <tbody>
        @foreach (var t in Model.Transactions)
        {
            <tr>
                <td dir="ltr" style="text-align:right;">@(t.DocNo ?? t.Serial.ToString("D4"))</td>
                <td dir="ltr" style="text-align:right;">@DT(t.OccurredAt)</td>
                <td><span class="badge-state @(t.Type == TxnType.Income ? "state-on" : "state-off")">@(t.IsTransfer ? (t.Type == TxnType.Income ? "تحويل وارد" : "تحويل صادر") : t.Type.Ar())</span></td>
                <td>@t.Source.Ar()</td>
                <td>@t.Description</td>
                <td style="color:@(t.Type == TxnType.Income ? "var(--good)" : "var(--critical)")">@(t.Type == TxnType.Income ? "+" : "−")@N(t.Amount)</td>
                <td style="font-weight:600;white-space:nowrap;">@N(t.RunningBalance)</td>
            </tr>
        }
        @if (Model.Transactions.Count == 0)
        {
            <tr data-skip-search><td colspan="7" style="color:var(--muted)">لا توجد حركات.</td></tr>
        }
        <tr data-no-results data-skip-search style="display:none;"><td colspan="7" style="color:var(--muted)">لا توجد نتائج مطابقة للبحث.</td></tr>
        </tbody>
        @if (Model.Transactions.Count > 0)
        {
            <tfoot>
                <tr style="border-top:2px solid var(--border,rgba(255,255,255,.12));">
                    <td colspan="6" style="text-align:left;font-weight:700;">الرصيد الحالي</td>
                    <td style="font-weight:800;white-space:nowrap;color:var(--aqua);">@N(Model.Balance) <span style="color:var(--muted);font-weight:400;">ج.م</span></td>
                </tr>
            </tfoot>
        }
    </table>
</div>
