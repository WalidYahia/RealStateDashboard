@model SafeMovementsVm
@{
    Layout = null;
    var tenantId = (Guid)ViewBag.TenantId;
    string N(decimal v) => v.ToString("N0", new System.Globalization.CultureInfo("ar-EG"));
    string DT(DateTime d) => d.ToString("yyyy/MM/dd HH:mm");
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>حركات الخزنة - @Model.SafeName</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, sans-serif; padding: 24px; color: #111; }
        .brand { text-align: center; margin-bottom: 6px; } .brand img { max-height: 60px; }
        h1 { font-size: 19px; text-align: center; margin: 4px 0; }
        .sub { text-align: center; color: #666; font-size: 12px; margin-bottom: 14px; }
        table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
        th, td { border: 1px solid #ccc; padding: 6px 8px; text-align: start; unicode-bidi: plaintext; }
        th { background: #f2f2f2; }
        .no-print { margin-bottom: 12px; } @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="no-print"><button onclick="window.print()">🖨 طباعة / حفظ PDF</button></div>
    <div class="brand"><img src="@Url.Action("Logo", "Branding", new { area = "", id = tenantId })" alt="logo" onerror="this.style.display='none'" /></div>
    <h1>حركات الخزنة: @Model.SafeName</h1>
    <div class="sub">الرصيد الحالي @N(Model.Balance) ج.م · @DateTime.Now.ToString("yyyy/MM/dd HH:mm")</div>
    <table>
        <thead><tr><th>#</th><th>التاريخ/الوقت</th><th>النوع</th><th>المصدر</th><th>البيان</th><th>المبلغ</th><th>الرصيد</th></tr></thead>
        <tbody>
        @foreach (var t in Model.Transactions)
        {
            <tr><td>@t.Serial.ToString("D4")</td><td>@DT(t.OccurredAt)</td><td>@t.Type.Ar()</td><td>@t.Source.Ar()</td><td>@t.Description</td><td>@(t.Type == TxnType.Income ? "+" : "−")@N(t.Amount)</td><td>@N(t.RunningBalance)</td></tr>
        }
        </tbody>
        @if (Model.Transactions.Count > 0)
        {
            <tfoot>
                <tr><td colspan="6" style="text-align:left;font-weight:700;background:#f2f2f2;">الرصيد الحالي</td><td style="font-weight:700;background:#f2f2f2;white-space:nowrap;">@N(Model.Balance) ج.م</td></tr>
            </tfoot>
        }
    </table>
    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
</body>
</html>
