@model List<SafeRow>
@{
    ViewData["Title"] = "الخزائن";
    string N(decimal v) => v.ToString("N0", new System.Globalization.CultureInfo("ar-EG"));
    var canCreate = User.Can(PermissionNames.SafesCreate);
    var canEdit = User.Can(PermissionNames.SafesEdit);
    var canDelete = User.Can(PermissionNames.SafesDelete);
}
<div class="page-head">
    <h1>الخزائن</h1>
    @if (canCreate)
    {
        <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'خزنة جديدة')">➕ خزنة جديدة</button>
    }
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

<div class="card-tile">
    <table class="rs-table">
        <thead><tr><th>الاسم</th><th>الرصيد الافتتاحي</th><th>الإيرادات</th><th>المصروفات</th><th>الرصيد الحالي</th><th>الحركات</th><th></th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@N(s.InitialAmount)</td>
                <td class="tag-up">@N(s.Income)</td>
                <td>@N(s.Expense)</td>
                <td><strong>@N(s.Balance)</strong> ج.م</td>
                <td>@s.TxnCount</td>
                <td style="white-space:nowrap;">
                    <a class="btn-sm" asp-action="Movements" asp-route-id="@s.Id">📁 الحركات</a>
                    @if (canEdit)
                    {
                        <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = s.Id })', 'تعديل الخزنة')">تعديل</button>
                    }
                    @if (canDelete)
                    {
                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline;" data-confirm="حذف الخزنة «@s.Name»؟" data-danger>
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-sm btn-danger">حذف</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" style="color:var(--muted)">لا توجد خزائن بعد.</td></tr>
        }
        </tbody>
    </table>
</div>
