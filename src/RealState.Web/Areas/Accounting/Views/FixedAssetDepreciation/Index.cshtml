@model DepreciationVm
@{
    ViewData["Title"] = "إهلاك الأصول الثابتة";
    var canDepreciate = ViewData["CanDepreciate"] as bool? ?? false;
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string D(DateTime d) => RealState.Web.AppCulture.When(d);   // date + time when it has one
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="page-head">
    <div>
        <h1>إهلاك الأصول الثابتة</h1>
        <p style="color:var(--muted);margin:2px 0 0;">يُسجَّل الإهلاك يدويًا على الأصل عند الحاجة — لا يُحتسب ولا يُرحَّل تلقائيًا.</p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <a class="btn-sm" asp-controller="FixedAssets" asp-action="Index">📦 الأصول الثابتة</a>
        @if (canDepreciate)
        {
            <button type="button" class="btn-new-tenant" data-quick-new onclick="appOpenModal('@Url.Action("Form")', 'تسجيل إهلاك على أصل')">📉 تسجيل إهلاك</button>
        }
    </div>
</div>

@if (TempData["StatusMessage"] is string msg)
{
    <div class="status-message">@msg</div>
}

<div class="kpi-grid" style="grid-template-columns: repeat(3, 1fr);">
    <div class="kpi k-alerts"><div class="kpi-label">إجمالي الإهلاك</div><div class="kpi-value"><span data-live-sum="#depTable:3">@N(Model.Total)</span> <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">في الفترة المختارة</div></div>
    <div class="kpi k-reserve"><div class="kpi-label">قيود الإهلاك</div><div class="kpi-value" data-live-count="#depTable">@Model.Rows.Count</div><div class="kpi-foot">قيد</div></div>
    <div class="kpi k-tasks"><div class="kpi-label">أصول قابلة للإهلاك</div><div class="kpi-value">@Model.DepreciableCount</div><div class="kpi-foot">مُرحَّلة وغير مُستبعدة</div></div>
</div>

@{
    var filter = FilterBarVm.For(Url.Action("Index"))
        .WithTitle("تصفية سجل الإهلاك")
        .DateRange(F(Model.From), F(Model.To), "تاريخ الإهلاك", presets: FilterPresets.Standard().Append(FilterPresets.ThisYear()).Append(FilterPresets.All()))
        .Select("categoryId", "الفئة", Model.Categories, Model.CategoryId);
}
<partial name="_FilterBar" model="filter" />

<div class="card-tile">
    <div class="list-search-bar"><input class="form-control list-search" data-target="#depTable" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="depTable">
        <thead><tr><th>التاريخ</th><th>الأصل</th><th>الفئة</th><th>قيمة الإهلاك</th><th>البيان</th><th>بواسطة</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td dir="ltr" style="text-align:right;white-space:nowrap;">@D(r.Date)</td>
                <td><a asp-controller="FixedAssets" asp-action="Details" asp-route-id="@r.AssetId" style="color:var(--series-1);font-weight:600;text-decoration:none;" dir="ltr">FA-@r.Number</a> — @r.Name</td>
                <td>@(r.Category ?? "—")</td>
                <td style="font-weight:600;">@N(r.Amount)</td>
                <td>@(r.Notes ?? "—")</td>
                <td>@(r.CreatedBy ?? "—")</td>
                <td style="white-space:nowrap;">
                    @if (canDepreciate && !r.AssetDisposed)
                    {
                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" style="display:inline;" data-danger
                              data-confirm="حذف إهلاك @N(r.Amount) ج.م على الأصل FA-@r.Number وعكس قيده؟">@Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">🗑 حذف</button></form>
                    }
                    else if (r.AssetDisposed)
                    {
                        <span class="badge-state state-off" title="الأصل مُستبعد — الإهلاك مُقفَل في قيد استبعاده">مُقفَل</span>
                    }
                </td>
            </tr>
        }
        @if (Model.Rows.Count == 0)
        {
            <tr data-skip-search><td colspan="7" style="color:var(--muted)">لا يوجد إهلاك مسجَّل في هذه الفترة.@(canDepreciate ? " سجّل إهلاكًا على أصل من «📉 تسجيل إهلاك» أو من صفحة الأصل." : "")</td></tr>
        }
        <tr data-no-results data-skip-search style="display:none;"><td colspan="7" style="color:var(--muted)">لا توجد نتائج مطابقة.</td></tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/fixed-assets.js" asp-append-version="true"></script>
}
