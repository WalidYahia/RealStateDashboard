@model MaterialCustodyDetailsVm
@{
    var c = Model.Custody;
    ViewData["Title"] = $"عهدة عينية MC-{c.Number}";
    var canManage = ViewData["CanManage"] as bool? ?? false;
    var canDelete = ViewData["CanDelete"] as bool? ?? false;
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string D(DateTime? d) => RealState.Web.AppCulture.When(d);   // date + time when it has one
    string Size(long b) => b < 1024 ? $"{b} B" : b < 1048576 ? $"{b / 1024} KB" : $"{b / 1048576.0:0.#} MB";
}
<div class="page-head">
    <div>
        <h1>عهدة عينية <span class="proj-code">MC-@c.Number</span></h1>
        <p style="color:var(--muted);margin:2px 0 0;">
            @c.ItemName · <span class="badge-state @c.Status.BadgeClass()">@c.Status.Ar()</span>
            @if (Model.IsOverdue) { <span style="color:var(--critical);font-weight:700;"> · ⚠ تجاوزت موعد الإرجاع</span> }
        </p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <a class="btn-sm" asp-action="Index">رجوع لقائمة العُهد</a>
        <a class="btn-sm" asp-action="PrintHandover" asp-route-id="@c.Id" target="_blank">🖨 إقرار الاستلام</a>
        @if (canManage && c.Status == MaterialCustodyStatus.HandedOver)
        {
            <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("ReturnForm", new { id = c.Id })', 'استلام العهدة MC-@c.Number')">↩ استلام العهدة</button>
            <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("TransferForm", new { id = c.Id })', 'تحويل الأصل لموظف آخر')">🔁 تحويل لموظف آخر</button>
            <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = c.Id })', 'تعديل العهدة MC-@c.Number')">✏️ تعديل</button>
        }
        @if (canManage && c.Status is MaterialCustodyStatus.Returned or MaterialCustodyStatus.Damaged or MaterialCustodyStatus.Lost)
        {
            <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("ReturnForm", new { id = c.Id })', 'تصحيح بيانات الاستلام')">✏️ تصحيح الاستلام</button>
        }
        @if (canDelete && c.Status is not (MaterialCustodyStatus.Cancelled or MaterialCustodyStatus.Transferred))
        {
            <button type="button" class="btn-sm btn-danger" onclick="appOpenModal('@Url.Action("CancelForm", new { id = c.Id })', 'إلغاء العهدة MC-@c.Number')">✖ إلغاء العهدة</button>
        }
    </div>
</div>

@if (TempData["StatusMessage"] is string msg)
{
    <div class="status-message">@msg</div>
}

@if (c.Status == MaterialCustodyStatus.Cancelled)
{
    <div class="status-message" style="background:rgba(208,59,59,.08);border-color:var(--critical);color:var(--critical);">أُلغيت هذه العهدة — السبب: @c.CancellationReason</div>
}
@if (Model.TransferredFrom is not null || Model.TransferredTo is not null)
{
    <div class="status-message" style="background:var(--surface-2);border-color:var(--border);color:var(--text-secondary);">
        @if (Model.TransferredFrom is { } f) { <span>مُحوَّلة من العهدة <a asp-action="Details" asp-route-id="@f.Id" dir="ltr" style="color:var(--series-1);font-weight:600;text-decoration:none;">MC-@f.Number</a>.</span> }
        @if (Model.TransferredTo is { } t) { <span> حُوِّلت إلى @t.Employee — العهدة <a asp-action="Details" asp-route-id="@t.Id" dir="ltr" style="color:var(--series-1);font-weight:600;text-decoration:none;">MC-@t.Number</a>.</span> }
    </div>
}

<div class="grid-row" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start;">
    <div class="card-tile" style="margin:0;">
        <div class="card-head"><h3>بيانات العهدة</h3></div>
        <table class="rs-table">
            <tbody>
                <tr><td class="muted" style="width:150px;">الأصل الثابت</td><td>
                    @if (Model.Asset is { } asset)
                    {
                        @if (User.Can(PermissionNames.FixedAssetsView))
                        {
                            <a asp-controller="FixedAssets" asp-action="Details" asp-route-id="@asset.Id" style="color:var(--series-1);font-weight:600;text-decoration:none;" dir="ltr">FA-@asset.Number</a>
                        }
                        else { <span dir="ltr">FA-@asset.Number</span> }
                        <span> — @c.ItemName</span>
                        @if (!string.IsNullOrWhiteSpace(asset.Location)) { <div style="color:var(--muted);font-size:12px;">مكان الحفظ: @asset.Location</div> }
                    }
                    else { @c.ItemName }
                </td></tr>
                <tr><td class="muted">النوع</td><td>@(c.ItemType ?? "—")</td></tr>
                <tr><td class="muted">الرقم التسلسلي</td><td dir="ltr" style="text-align:right;">@(c.SerialNumber ?? "—")</td></tr>
                <tr><td class="muted">الكمية</td><td>@c.Quantity</td></tr>
                <tr><td class="muted">قيمة الوحدة</td><td>@(c.Value is decimal v ? N(v) + " ج.م" + (c.Quantity > 1 ? $" × {c.Quantity} = {N(v * c.Quantity)} ج.م" : "") : "—")</td></tr>
                <tr><td class="muted">الحالة عند التسليم</td><td>@(string.IsNullOrWhiteSpace(c.HandoverCondition) ? "—" : c.HandoverCondition)</td></tr>
                <tr><td class="muted">ملاحظات</td><td style="white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(c.Notes) ? "—" : c.Notes)</td></tr>
            </tbody>
        </table>
    </div>

    <div class="card-tile" style="margin:0;">
        <div class="card-head"><h3>التسليم والاستلام</h3></div>
        <table class="rs-table">
            <tbody>
                <tr><td class="muted" style="width:150px;">الموظف</td><td>@(Model.Employee?.FullName ?? "—") @if (Model.Employee?.Phone is string ph) { <span style="margin-inline-start:6px;">@ContactLinks.Buttons(ph)</span> }</td></tr>
                <tr><td class="muted">القسم</td><td>@(Model.Department ?? "—")</td></tr>
                <tr><td class="muted">تاريخ التسليم</td><td dir="ltr" style="text-align:right;">@D(c.HandoverDate)</td></tr>
                <tr><td class="muted">الإرجاع المتوقع</td><td dir="ltr" style="text-align:right;@(Model.IsOverdue ? "color:var(--critical);font-weight:700;" : "")">@D(c.ExpectedReturnDate)</td></tr>
                <tr><td class="muted">تاريخ الاستلام</td><td dir="ltr" style="text-align:right;">@D(c.ReturnDate)</td></tr>
                <tr><td class="muted">الحالة</td><td><span class="badge-state @c.Status.BadgeClass()">@c.Status.Ar()</span></td></tr>
                <tr><td class="muted">ملاحظات الاستلام</td><td style="white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(c.ReturnCondition) ? "—" : c.ReturnCondition)</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card-tile" style="margin-top:16px;">
    <div class="card-head"><h3>المرفقات</h3><span class="pill">@Model.Attachments.Count</span></div>
    @if (canManage)
    {
        <form asp-action="Upload" asp-route-id="@c.Id" method="post" enctype="multipart/form-data" class="mc-upload">
            @Html.AntiForgeryToken()
            <input type="file" name="files" class="form-control" multiple required />
            <button type="submit" class="btn-sm">📎 رفع المرفقات</button>
        </form>
    }
    <table class="rs-table">
        <thead><tr><th>الملف</th><th>الحجم</th><th>تاريخ الرفع</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in Model.Attachments)
        {
            <tr>
                <td><a asp-action="Attachment" asp-route-id="@a.Id" style="color:var(--series-1);text-decoration:none;">📎 @a.FileName</a></td>
                <td dir="ltr" style="text-align:right;">@Size(a.Size)</td>
                <td dir="ltr" style="text-align:right;">@RealState.Web.AppCulture.When(a.CreatedAt)</td>
                <td>
                    @if (canManage)
                    {
                        <form asp-action="DeleteAttachment" asp-route-id="@a.Id" method="post" style="display:inline;" data-confirm="حذف المرفق «@a.FileName»؟" data-danger>@Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">حذف</button></form>
                    }
                </td>
            </tr>
        }
        @if (Model.Attachments.Count == 0) { <tr><td colspan="4" style="color:var(--muted)">لا توجد مرفقات.</td></tr> }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/material-custody.js" asp-append-version="true"></script>
}
