@model TxnListVm
@using System.Globalization

@{
    var isIncome = Model.Type == TxnType.Income;
    ViewData["Title"] = isIncome ? "الإيرادات" : "المصروفات";

    var inv = CultureInfo.InvariantCulture;

    string N(decimal v) => v.ToString("N0", RealState.Web.AppCulture.Ar);

    // Display format
    string DT(DateTime d) => d.ToString("yyyy/MM/dd HH:mm", inv);

    // datetime-local format (seconds are not needed); null when no value so the input stays empty.
    string DTL(DateTime d) => d.ToString("yyyy-MM-ddTHH:mm", inv);
    string? DTLn(DateTime? d) => d.HasValue ? DTL(d.Value) : null;

    var canCreate = (bool?)ViewData["CanCreate"] ?? false;
    var canEdit = (bool?)ViewData["CanEdit"] ?? false;
    var canDelete = (bool?)ViewData["CanDelete"] ?? false;
}

@* Carries the page's current filter through a POST so the action redirects back to the same filtered view. *@
@{
    Func<object?, object> filterFields = @<text><input type="hidden" name="from" value="@DTLn(Model.From)" /><input type="hidden" name="to" value="@DTLn(Model.To)" /><input type="hidden" name="source" value="@Model.Source" /><input type="hidden" name="q" value="@Model.Q" /></text>;
}

<div class="page-head">
    <h1>@(isIncome ? "الإيرادات" : "المصروفات")</h1>

    <div style="display:flex;gap:8px;">
        @if (canCreate)
        {
            <button type="button"
                    class="btn-new-tenant"
                    onclick="appOpenModal('@Url.Action("Form")', '@(isIncome ? "إيراد جديد" : "مصروف جديد")')">
                ➕ @(isIncome ? "إيراد جديد" : "مصروف جديد")
            </button>
        }
    </div>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

@{
    var filter = FilterBarVm.For(Url.Action("Index"))
        .DateRange(DTLn(Model.From), DTLn(Model.To), withTime: true)
        .Select("source", "المصدر", Model.SourceOptions, Model.Source)
        .Print(Url.Action("PrintList", new { from = DTLn(Model.From), to = DTLn(Model.To), source = Model.Source, q = Model.Q }), "طباعة القائمة")
        .Excel(Url.Action("Csv", new { from = DTLn(Model.From), to = DTLn(Model.To), source = Model.Source, q = Model.Q }))
        // Live total of the (searched) rows below — kept from the previous filter layout.
        .WithSummary(new Microsoft.AspNetCore.Html.HtmlString(
            $"الإجمالي: <strong data-live-sum=\"#txnTable:5\">{N(Model.Total)}</strong> ج.م"));
}
<partial name="_FilterBar" model="filter" />

<div class="card-tile">
    <div class="list-search-bar"><input class="form-control list-search" data-target="#txnTable" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="txnTable">
        <thead>
            <tr>
                <th>#</th>
                <th>التاريخ/الوقت</th>
                <th>الخزنة</th>
                <th>المصدر</th>
                <th>البيان</th>
                <th>المبلغ</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var t in Model.Rows)
            {
                <tr>
                    <td style="text-align:right;">
                        <bdi dir="ltr">
                            @t.Serial.ToString("D4", inv)
                        </bdi>
                    </td>

                    <td style="text-align:right;white-space:nowrap;">
                        <bdi dir="ltr" lang="en">
                            @DT(t.OccurredAt)
                        </bdi>
                    </td>

                    <td>@t.SafeName</td>

                    <td>@(t.CategoryName ?? t.Source.Ar())</td>

                    <td>@t.Description</td>

                    <td>@N(t.Amount)</td>

                    <td style="white-space:nowrap;">
                        <a class="btn-sm" asp-action="PrintOne" asp-route-id="@t.Id" target="_blank">🖨</a>
                        @if (t.IsManual)
                        {
                            @if (canEdit)
                            {
                                <button type="button"
                                        class="btn-sm"
                                        onclick="appOpenModal('@Url.Action("Form", new { id = t.Id })', 'تعديل')">
                                    تعديل
                                </button>
                            }
                            @if (canDelete)
                            {
                                <form asp-action="Delete"
                                      asp-route-id="@t.Id"
                                      method="post"
                                      style="display:inline;"
                                      data-confirm="حذف الحركة؟" data-danger>
                                    @Html.AntiForgeryToken()
                                    @filterFields(null)
                                    <button type="submit" class="btn-sm btn-danger">
                                        حذف
                                    </button>
                                </form>
                            }
                        }
                        else if (t.IsAdvanceDisbursement && canDelete)
                        {
                            <form asp-action="Delete"
                                  asp-route-id="@t.Id"
                                  method="post"
                                  style="display:inline;"
                                  data-confirm="حذف مصروف صرف السلفة سيعيدها إلى حالة «لم يُصرف» ويعكس المبلغ من الخزنة. هل تريد المتابعة؟" data-danger>
                                @Html.AntiForgeryToken()
                                @filterFields(null)
                                <button type="submit" class="btn-sm btn-danger">
                                    حذف
                                </button>
                            </form>
                        }
                        else if (t.IsAdvanceRepayment && canDelete)
                        {
                            <form asp-action="Delete"
                                  asp-route-id="@t.Id"
                                  method="post"
                                  style="display:inline;"
                                  data-confirm="حذف سداد السلفة سيعكس المبلغ من الخزنة ويعيد المتبقي على السلفة. هل تريد المتابعة؟" data-danger>
                                @Html.AntiForgeryToken()
                                @filterFields(null)
                                <button type="submit" class="btn-sm btn-danger">
                                    حذف
                                </button>
                            </form>
                        }
                        else
                        {
                            <span style="color:var(--muted);font-size:12px;">
                                تلقائي
                            </span>
                        }
                    </td>
                </tr>
            }

            @if (Model.Rows.Count == 0)
            {
                <tr data-skip-search>
                    <td colspan="7" style="color:var(--muted)">
                        لا توجد حركات.
                    </td>
                </tr>
            }
            <tr data-no-results data-skip-search style="display:none;"><td colspan="7" style="color:var(--muted)">لا توجد نتائج مطابقة للبحث.</td></tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        // Income/Expense modal: toggle the advance/reward pickers by the chosen "النوع" and auto-fill amount.
        window.txnKindChange = function (form) {
            if (!form) return;
            // The chosen category (البند) carries data-kind: 0 general, 1 advance, 2 reward.
            var cat = form.querySelector('[name="CategoryId"]');
            var opt = cat ? cat.options[cat.selectedIndex] : null;
            var v = opt ? (opt.getAttribute('data-kind') || '0') : '0';
            var adv = form.querySelector('.txn-advance');
            var rew = form.querySelector('.txn-reward');
            var desc = form.querySelector('.txn-desc');
            var amt = form.querySelector('#txnAmount');
            if (adv) adv.style.display = v === '1' ? '' : 'none';
            if (rew) rew.style.display = v === '2' ? '' : 'none';
            // description is auto-generated for advance/reward
            if (desc) desc.style.display = v === '0' ? '' : 'none';
            var isExpense = form.getAttribute('data-txn-expense') === '1';
            if (v === '0') { if (amt) { amt.readOnly = false; } }
            else if (amt) { amt.readOnly = isExpense; if (isExpense) amt.value = 0; }
        };
        window.txnPickAmount = function (sel) {
            var form = sel.form; if (!form) return;
            var map = {};
            try { map = JSON.parse(form.getAttribute('data-txn-amounts') || '{}'); } catch (e) { }
            var amt = form.querySelector('#txnAmount');
            var val = map[sel.value];
            if (amt && val != null) amt.value = val;
        };
    </script>
}
