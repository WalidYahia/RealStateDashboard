@model TxnListVm
@using System.Globalization

@{
    Layout = null;

    var isIncome = Model.Type == TxnType.Income;
    var tenantId = (Guid)ViewBag.TenantId;

    string N(decimal v) => v.ToString("N0", new CultureInfo("ar-EG"));
    string DT(DateTime d) => d.ToString("yyyy/MM/dd HH:mm", CultureInfo.InvariantCulture);
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@(isIncome ? "الإيرادات" : "المصروفات")</title>

    <style>
        body {
            font-family: "Segoe UI", Tahoma, sans-serif;
            padding: 24px;
            color: #111;
        }

        .brand {
            text-align: center;
            margin-bottom: 6px;
        }

        .brand img {
            max-height: 60px;
        }

        h1 {
            font-size: 19px;
            text-align: center;
            margin: 4px 0;
        }

        .sub {
            text-align: center;
            color: #666;
            font-size: 12px;
            margin-bottom: 14px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12.5px;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 6px 8px;
            text-align: start;
            unicode-bidi: plaintext;
        }

        th {
            background: #f2f2f2;
        }

        .totals td {
            font-weight: 700;
            background: #f7f7f7;
        }

        .no-print {
            margin-bottom: 12px;
        }

        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>

<body>
    <div class="no-print">
        <button onclick="window.print()">🖨 طباعة / حفظ PDF</button>
    </div>

    <div class="brand">
        <img src="@Url.Action("Logo", "Branding", new { area = "", id = tenantId })"
             alt="logo"
             onerror="this.style.display='none'" />
    </div>

    <h1>@(isIncome ? "تقرير الإيرادات" : "تقرير المصروفات")</h1>

    <div class="sub">
        <span dir="ltr">@DT(DateTime.Now)</span>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>التاريخ/الوقت</th>
                <th>الخزنة</th>
                <th>المصدر</th>
                <th>البيان</th>
                <th>المبلغ</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var t in Model.Rows)
            {
                <tr>
                    <td dir="ltr">@t.Serial.ToString("D4")</td>

                    <td dir="ltr">
                        <span dir="ltr">@DT(t.OccurredAt)</span>
                    </td>

                    <td>@t.SafeName</td>

                    <td>@t.Source.Ar()</td>

                    <td>@t.Description</td>

                    <td>@N(t.Amount)</td>
                </tr>
            }

            <tr class="totals">
                <td colspan="5">الإجمالي</td>
                <td>@N(Model.Total) ج.م</td>
            </tr>
        </tbody>
    </table>

    <script>
        window.addEventListener('load', function () {
            setTimeout(function () {
                window.print();
            }, 400);
        });
    </script>
</body>
</html>
