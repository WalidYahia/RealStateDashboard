@model EntryVm
@* Printable journal entry (قيد يومية): header + debit/credit lines, with preparer / reviewer / approver signatures. *@
@{
    Layout = null;
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    var n = 0;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>قيد يومية رقم @Model.Number</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, sans-serif; padding: 28px; color: #111; }
        h1 { font-size: 20px; text-align: center; margin: 6px 0 2px; }
        .sub { text-align: center; color: #666; font-size: 12px; margin-bottom: 18px; }
        h2 { font-size: 14px; margin: 18px 0 8px; border-bottom: 1px solid #ddd; padding-bottom: 4px; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 8px; }
        th, td { border: 1px solid #ccc; padding: 7px 8px; text-align: start; unicode-bidi: plaintext; }
        th { background: #f2f2f2; }
        .kv th { width: 170px; background: #fafafa; }
        tfoot th { background: #eef4fb; }
        .num { white-space: nowrap; }
        .balanced { color: #0a7a0a; font-weight: 700; } .unbalanced { color: #c62f2f; font-weight: 700; }
        .sign { display: flex; justify-content: space-between; margin-top: 56px; font-size: 13px; }
        .sign div { width: 28%; border-top: 1px solid #333; padding-top: 6px; text-align: center; }
        .no-print { margin-bottom: 14px; } @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    @await Component.InvokeAsync("ReportBackground", new { part = "open" })
    <div class="no-print"><button onclick="window.print()">🖨 طباعة / حفظ PDF</button></div>
    <h1>قيد يومية رقم @Model.Number</h1>
    <div class="sub">تاريخ الطباعة: @DateTime.Now.ToString("yyyy/MM/dd HH:mm")</div>

    <table class="kv">
        <tr><th>تاريخ القيد</th><td>@Model.Date.ToString("yyyy/MM/dd")</td></tr>
        <tr><th>البيان</th><td>@Model.Description</td></tr>
        <tr><th>نوع القيد</th><td>@(Model.IsManual ? "يدوي" : "آلي (من حركة في النظام)")</td></tr>
        @if (!string.IsNullOrWhiteSpace(Model.CreatedBy)) { <tr><th>سُجّل بواسطة</th><td>@Model.CreatedBy</td></tr> }
    </table>

    <h2>أطراف القيد</h2>
    <table>
        <thead><tr><th>#</th><th>رقم الحساب</th><th>اسم الحساب</th><th>مدين</th><th>دائن</th><th>البيان</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Lines)
        {
            n++;
            <tr>
                <td>@n</td>
                <td class="num">@l.AccountCode</td>
                <td>@l.AccountName</td>
                <td class="num">@(l.Debit == 0 ? "" : N(l.Debit))</td>
                <td class="num">@(l.Credit == 0 ? "" : N(l.Credit))</td>
                <td>@l.Memo</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">الإجمالي
                    @if (Model.TotalDebit == Model.TotalCredit) { <span class="balanced">— متوازن ✓</span> }
                    else { <span class="unbalanced">— غير متوازن</span> }
                </th>
                <th class="num">@N(Model.TotalDebit)</th>
                <th class="num">@N(Model.TotalCredit)</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <div class="sign"><div>المُعِد</div><div>المراجع</div><div>المدير المالي</div></div>

    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 500); });</script>
    @await Component.InvokeAsync("ReportBackground", new { part = "close" })
</body>
</html>
