@model LedgerVm
@*
    Printable general ledger (دفتر الأستاذ) — same account + period as the screen:
    "الكل" → the general journal (one row per entry); an account → its lines with opening / running / closing balance.
*@
@{
    Layout = null;
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string D(DateTime d) => d.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture);
    var side = Model.IsDebitNormal ? "مدين" : "دائن";
    var title = Model.IsAll ? "دفتر اليومية — كل الحسابات" : $"دفتر الأستاذ — {Model.AccountCode} {Model.AccountName}";
    var preBalance = 5 + (Model.IsGroup ? 1 : 0);   // date, number, [account], statement, debit, credit
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, sans-serif; padding: 24px; color: #111; }
        h1 { font-size: 19px; text-align: center; margin: 4px 0; }
        .sub { text-align: center; color: #666; font-size: 12px; margin-bottom: 14px; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th, td { border: 1px solid #bbb; padding: 5px 7px; text-align: start; unicode-bidi: plaintext; }
        thead th { background: #eef4fb; font-weight: 700; }
        tfoot th, tfoot td, .opening td { font-weight: 800; background: #f2f2f2; }
        .num { white-space: nowrap; }
        .no-print { margin-bottom: 12px; } @@media print { .no-print { display: none; } body { padding: 0; } }
    </style>
</head>
<body>
    @await Component.InvokeAsync("ReportBackground", new { part = "open" })
    <div class="no-print"><button onclick="window.print()">🖨 طباعة / حفظ PDF</button></div>
    <h1>@title</h1>
    <div class="sub">
        @if (Model.From.HasValue || Model.To.HasValue) { <text>الفترة @D(Model.From ?? DateTime.MinValue) — @D(Model.To ?? DateTime.MaxValue) · </text> }
        @if (!Model.IsAll) { <text>الطبيعة: @side@(Model.IsGroup ? " · شامل الحسابات الفرعية" : "") · </text> }
        طُبع @DateTime.Now.ToString("yyyy/MM/dd HH:mm")
    </div>

    @if (Model.IsAll)
    {
        <table>
            <thead><tr><th>التاريخ</th><th>رقم القيد</th><th>البيان</th><th>القيمة</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr><td class="num">@D(r.Date)</td><td class="num">@r.Number</td><td>@r.Description</td><td class="num">@N(r.Value)</td></tr>
            }
            @if (Model.Rows.Count == 0) { <tr><td colspan="4">لا توجد قيود في هذه الفترة.</td></tr> }
            </tbody>
            <tfoot><tr><th colspan="3">الإجمالي (@Model.Rows.Count قيد)</th><th class="num">@N(Model.TotalValue)</th></tr></tfoot>
        </table>
    }
    else
    {
        <table>
            <thead>
                <tr><th>التاريخ</th><th>رقم القيد</th>@if (Model.IsGroup) { <th>الحساب</th> }<th>البيان</th><th>مدين</th><th>دائن</th><th>الرصيد (@side)</th></tr>
            </thead>
            <tbody>
                <tr class="opening"><td colspan="@preBalance">رصيد افتتاحي</td><td class="num">@N(Model.Opening)</td></tr>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="num">@D(r.Date)</td>
                        <td class="num">@r.Number</td>
                        @if (Model.IsGroup) { <td>@r.AccountName</td> }
                        <td>@r.Description @(string.IsNullOrEmpty(r.Memo) || r.Memo == r.Description ? "" : $"— {r.Memo}")</td>
                        <td class="num">@(r.Debit == 0 ? "" : N(r.Debit))</td>
                        <td class="num">@(r.Credit == 0 ? "" : N(r.Credit))</td>
                        <td class="num">@N(r.Balance)</td>
                    </tr>
                }
                @if (Model.Rows.Count == 0) { <tr><td colspan="@(preBalance + 1)">لا توجد حركات في هذه الفترة.</td></tr> }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="@(preBalance - 2)">إجمالي الحركة</th>
                    <th class="num">@N(Model.TotalDebit)</th>
                    <th class="num">@N(Model.TotalCredit)</th>
                    <th class="num">الرصيد الختامي: @N(Model.Closing)</th>
                </tr>
            </tfoot>
        </table>
    }

    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
    @await Component.InvokeAsync("ReportBackground", new { part = "close" })
</body>
</html>
