@model SafeTransferListVm
@{
    ViewData["Title"] = "التحويلات بين الخزائن";
    var canTransfer = ViewData["CanTransfer"] as bool? ?? false;
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string DT(DateTime d) => d.ToString("yyyy/MM/dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var safeId = Model.SafeId?.ToString();
}
<div class="page-head">
    <h1>التحويلات بين الخزائن</h1>
    <div style="display:flex;gap:8px;">
        <a class="btn-sm" asp-controller="Safes" asp-action="Index">🏦 الخزائن</a>
        @if (canTransfer)
        {
            <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'تحويل جديد بين الخزائن')">➕ تحويل جديد</button>
        }
    </div>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

<div class="card-tile" style="margin-bottom:12px;">
    <form asp-action="Index" method="get" class="filter-form">
        <div class="filter-row">
            <div class="fld"><label class="form-label">من (تاريخ التحويل)</label><input type="date" name="from" value="@F(Model.From)" class="form-control" dir="ltr" /></div>
            <div class="fld"><label class="form-label">إلى</label><input type="date" name="to" value="@F(Model.To)" class="form-control" dir="ltr" /></div>
            <div class="filter-presets">
                <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today)" data-to="@F(DateTime.Today)">اليوم</button>
                <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today.AddDays(-7))" data-to="@F(DateTime.Today)">آخر أسبوع</button>
                <button type="button" class="btn-sm date-preset" data-from="@F(DateTime.Today.AddMonths(-1))" data-to="@F(DateTime.Today)">آخر شهر</button>
            </div>
        </div>
        <div class="filter-row">
            <div class="fld">
                <label class="form-label">الخزنة (محوَّل منها أو إليها)</label>
                <select name="safeId" class="form-control" data-searchable><option value="">الكل</option>
                    @foreach (var s in Model.SafeOptions) { <option value="@s.Value" selected="@(safeId == s.Value)">@s.Text</option> }
                </select>
            </div>
            <div class="fld"><label class="form-label">بحث (الرقم / الملاحظات)</label><input name="q" value="@Model.Q" class="form-control" /></div>
            <div class="filter-actions">
                <button type="submit" class="btn-primary">بحث</button>
                <a class="btn-sm" asp-action="PrintList" asp-route-from="@F(Model.From)" asp-route-to="@F(Model.To)" asp-route-safeId="@safeId" asp-route-q="@Model.Q" target="_blank">🖨 طباعة (PDF)</a>
                <a class="btn-sm" asp-action="Excel" asp-route-from="@F(Model.From)" asp-route-to="@F(Model.To)" asp-route-safeId="@safeId" asp-route-q="@Model.Q">⬇ Excel</a>
            </div>
        </div>
    </form>
</div>

<div class="card-tile">
    <div class="card-head">
        <h3>التحويلات</h3>
        <span class="pill">العدد: <span data-live-count="#sfTable">@Model.Rows.Count</span> · الإجمالي: <span data-live-sum="#sfTable:4">@N(Model.Total)</span> ج.م</span>
    </div>
    <div class="list-search-bar"><input class="form-control list-search" data-target="#sfTable" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="sfTable">
        <thead><tr><th>الرقم</th><th>التاريخ/الوقت</th><th>من خزنة</th><th>إلى خزنة</th><th>المبلغ</th><th>ملاحظات</th><th>بواسطة</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td dir="ltr" style="text-align:right;font-weight:600;white-space:nowrap;">SF-@r.Number</td>
                <td dir="ltr" style="text-align:right;white-space:nowrap;">@DT(r.OccurredAt)</td>
                <td style="color:var(--critical);">@r.FromSafe</td>
                <td style="color:var(--good);">@r.ToSafe</td>
                <td>@N(r.Amount)</td>
                <td>@r.Notes</td>
                <td style="color:var(--muted);">@r.CreatedBy</td>
                <td style="white-space:nowrap;">
                    <a class="btn-sm" asp-action="Print" asp-route-id="@r.Id" target="_blank">🖨 إذن التحويل</a>
                    @if (canTransfer)
                    {
                        <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = r.Id })', 'تعديل التحويل')">✏️ تعديل</button>
                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" style="display:inline;" data-confirm="حذف التحويل SF-@r.Number؟ ستُلغى حركتاه من الخزنتين." data-danger>
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-sm btn-danger">🗑</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Rows.Count == 0)
        {
            <tr data-skip-search><td colspan="8" style="color:var(--muted)">لا توجد تحويلات في هذه الفترة.</td></tr>
        }
        <tr data-no-results data-skip-search style="display:none;"><td colspan="8" style="color:var(--muted)">لا توجد نتائج مطابقة للبحث.</td></tr>
        </tbody>
    </table>
</div>
