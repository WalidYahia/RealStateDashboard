@model FixedAssetCategoryFormModel
@{
    const string AutoExpense = "تلقائي — «مصروف الإهلاك» (5600)";
}
<form id="appModalForm" asp-area="Accounting" asp-controller="FixedAssetCategories" asp-action="Form" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="Id" />
    @if (Model.HasPostings)
    {
        <div class="status-message" style="background:rgba(250,178,25,.12);border-color:var(--warning);color:var(--warning);">
            لهذه الفئة أصول مُرحَّلة — تغيير حساب مصروف الإهلاك يؤثر على القيود الجديدة فقط، ولا يغيّر القيود السابقة.
        </div>
    }
    <div class="form-grid">
        <div>
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="أجهزة كمبيوتر، سيارات، أثاث…" autocomplete="off" />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="DefaultUsefulLifeMonths" class="form-label"></label>
            <input asp-for="DefaultUsefulLifeMonths" class="form-control" type="number" min="0" max="1200" inputmode="numeric" dir="ltr" />
            <span asp-validation-for="DefaultUsefulLifeMonths" class="field-validation-error"></span>
            <span style="color:var(--muted);font-size:12px;">يُقترح لأصول الفئة — للاسترشاد عند تسجيل الإهلاك.</span>
        </div>
        <div class="full fa-section">ملف الترحيل (حسابات شجرة الحسابات)</div>
        <div class="full">
            <div class="status-message" style="background:var(--surface-2);border-color:var(--border);color:var(--text-secondary);margin:0;">
                <div>الأصول › الأصول الثابتة › <strong>@(string.IsNullOrWhiteSpace(Model.Name) ? "الفئة" : Model.Name)</strong> › حساب لكل أصل
                    @if (Model.CostGroup is string cg) { <span dir="ltr" style="color:var(--muted);"> (@cg)</span> }</div>
                <div>الأصول › مجمع إهلاك الأصول الثابتة › <strong>مجمع إهلاك — @(string.IsNullOrWhiteSpace(Model.Name) ? "الفئة" : Model.Name)</strong> › حساب لكل أصل
                    @if (Model.AccumulatedGroup is string ag) { <span dir="ltr" style="color:var(--muted);"> (@ag)</span> }</div>
                <div style="font-size:12px;margin-top:4px;">تُنشأ حسابات الفئة تلقائيًا باسمها، وحسابا كل أصل تحتها عند ترحيل قيد اقتنائه.</div>
            </div>
        </div>
        <div class="full">
            <label asp-for="DepreciationExpenseAccountId" class="form-label"></label>
            <select asp-for="DepreciationExpenseAccountId" class="form-control" data-searchable data-search-placeholder="@AutoExpense" asp-items="Model.ExpenseAccounts">
                <option value="">@AutoExpense</option>
            </select>
            <span asp-validation-for="DepreciationExpenseAccountId" class="field-validation-error"></span>
        </div>
    </div>
    <button type="submit" class="btn-primary" style="margin-top:12px;">💾 حفظ الفئة</button>
</form>
