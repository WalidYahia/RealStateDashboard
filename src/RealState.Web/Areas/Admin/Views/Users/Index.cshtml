@model List<UserListItem>
@{
    ViewData["Title"] = "المستخدمون";
    var canCreate = User.Can(PermissionNames.UsersCreate);
    var canEdit = User.Can(PermissionNames.UsersEdit);
    var canToggle = User.Can(PermissionNames.UsersDelete);
}

<div class="page-head">
    <h1>المستخدمون</h1>
    @if (canCreate)
    {
        <a class="btn-new-tenant" asp-area="Admin" asp-controller="Users" asp-action="Create">➕ مستخدم جديد</a>
    }
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

<div class="card-tile">
    <table class="rs-table">
        <thead>
            <tr><th>الاسم (للعرض)</th><th>الهاتف</th><th>البريد الإلكتروني</th><th>المؤسسة</th><th>الصلاحيات</th><th>الحالة</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.DisplayName</td>
                <td dir="ltr" style="text-align:right;">@u.Phone</td>
                <td dir="ltr" style="text-align:right;">@u.Email</td>
                <td>@u.TenantName</td>
                <td>
                    @if (u.IsSuperAdmin)
                    {
                        <span class="badge-role">مدير عام — كل الصلاحيات</span>
                    }
                    else
                    {
                        <span class="badge-role">@u.PermissionCount صلاحية</span>
                    }
                </td>
                <td><span class="badge-state @(u.IsActive ? "state-on" : "state-off")">@(u.IsActive ? "مفعّل" : "معطّل")</span></td>
                <td style="white-space:nowrap;">
                    @if (canEdit)
                    {
                        <a class="btn-sm" asp-action="Edit" asp-route-id="@u.Id">تعديل</a>
                        <a class="btn-sm" asp-action="ResetPassword" asp-route-id="@u.Id">كلمة المرور</a>
                    }
                    @if (canToggle)
                    {
                        <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-sm @(u.IsActive ? "btn-danger" : "")">@(u.IsActive ? "تعطيل" : "تفعيل")</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" style="color:var(--muted)">لا يوجد مستخدمون.</td></tr>
        }
        </tbody>
    </table>
</div>
