@model EditUserViewModel
@{
    ViewData["Title"] = $"تعديل: {Model.DisplayName}";
}

<div class="page-head">
    <h1>تعديل المستخدم</h1>
    <a class="btn-sm" asp-action="Index">رجوع</a>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsSuperAdmin" />
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="subtabs" style="margin-bottom:14px;">
        <a class="subtab active" href="javascript:" data-tab="basic" onclick="uTab(event,'basic')">البيانات الأساسية</a>
        <a class="subtab" href="javascript:" data-tab="perms" onclick="uTab(event,'perms')">الصلاحيات</a>
    </div>

    <div id="utab-basic" class="utab-panel">
        <div class="card-tile" style="max-width:760px;">
            <div class="form-grid">
                <div>
                    <label asp-for="DisplayName" class="form-label"></label>
                    <input asp-for="DisplayName" class="form-control" />
                    <span asp-validation-for="DisplayName" class="field-validation-error"></span>
                </div>
                <div>
                    <label class="form-label">المؤسسة</label>
                    <input class="form-control" value="@Model.TenantName" disabled />
                </div>
                <div>
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" dir="ltr" />
                    <span asp-validation-for="Phone" class="field-validation-error"></span>
                </div>
                <div>
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" dir="ltr" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="full">
                    <label class="form-check">
                        <input asp-for="IsActive" type="checkbox" /> الحساب مفعّل
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div id="utab-perms" class="utab-panel" style="display:none;">
        @if (Model.IsSuperAdmin)
        {
            <div class="card-tile" style="color:var(--muted);">
                هذا المستخدم <strong>مدير عام (SuperAdmin)</strong> ويمتلك جميع الصلاحيات تلقائيًا؛ لا يمكن تعديل صلاحياته من هنا.
            </div>
        }
        else
        {
            <partial name="_PrivilegesGrid" model="Model.SelectedPermissions" />
        }
    </div>

    <button type="submit" class="btn-primary" style="margin-top:16px;">حفظ التغييرات</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function uTab(e, name) {
            document.querySelectorAll('.subtabs .subtab').forEach(function (a) { a.classList.remove('active'); });
            e.currentTarget.classList.add('active');
            document.querySelectorAll('.utab-panel').forEach(function (p) { p.style.display = 'none'; });
            document.getElementById('utab-' + name).style.display = '';
        }
    </script>
}
