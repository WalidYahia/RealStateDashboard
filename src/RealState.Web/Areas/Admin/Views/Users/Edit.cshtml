@model EditUserViewModel
@{
    ViewData["Title"] = $"تعديل: {Model.DisplayName}";
}

<div class="page-head">
    <h1>تعديل المستخدم</h1>
    <a class="btn-sm" asp-action="Index">رجوع</a>
</div>

<div class="card-tile" style="max-width:720px;">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-grid">
            <div>
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" />
                <span asp-validation-for="DisplayName" class="field-validation-error"></span>
            </div>
            <div>
                <label class="form-label">المؤسسة</label>
                <input class="form-control" value="@Model.TenantName" disabled />
            </div>
            <div>
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" dir="ltr" />
                <span asp-validation-for="Phone" class="field-validation-error"></span>
            </div>
            <div>
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" dir="ltr" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="full">
                <label class="form-check">
                    <input asp-for="IsActive" type="checkbox" /> الحساب مفعّل
                </label>
            </div>

            <div class="full">
                <label class="form-label">الأدوار</label>
                <div class="checks">
                    @foreach (var role in Model.AllRoles)
                    {
                        <label>
                            <input type="checkbox" name="SelectedRoles" value="@role"
                                   checked="@(Model.SelectedRoles.Contains(role))" /> @role
                        </label>
                    }
                </div>
            </div>
        </div>

        <button type="submit" class="btn-primary" style="margin-top:12px;">حفظ التغييرات</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
