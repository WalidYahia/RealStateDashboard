@model ResetPasswordViewModel
@{
    ViewData["Title"] = $"كلمة مرور: {Model.UserName}";
}

<div class="page-head">
    <h1>إعادة تعيين كلمة المرور</h1>
    <a class="btn-sm" asp-action="Index">رجوع</a>
</div>

<div class="card-tile" style="max-width:520px;">
    <p style="color:var(--text-secondary)">المستخدم: <strong>@Model.UserName</strong></p>
    <form asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UserName" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="field-validation-error"></span>

        <button type="submit" class="btn-primary">حفظ كلمة المرور</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
