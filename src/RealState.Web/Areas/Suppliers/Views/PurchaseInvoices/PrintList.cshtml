@model List<InvoiceListItem>
@{
    Layout = null;
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string D(DateTime d) => d.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture);
    var total = Model.Sum(r => r.Total);
    var paid = Model.Sum(r => r.Paid);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>فواتير المشتريات</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, sans-serif; padding: 24px; color: #111; }
        h1 { font-size: 19px; text-align: center; margin: 4px 0; }
        .sub { text-align: center; color: #666; font-size: 12px; margin-bottom: 16px; }
        table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
        th, td { border: 1px solid #ccc; padding: 6px 7px; text-align: start; unicode-bidi: plaintext; }
        th { background: #f2f2f2; }
        .no-print { margin-bottom: 12px; } @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    @await Component.InvokeAsync("ReportBackground", new { part = "open" })
    <div class="no-print"><button onclick="window.print()">🖨 طباعة / حفظ PDF</button></div>
    <h1>فواتير المشتريات</h1>
    <div class="sub">@DateTime.Now.ToString("yyyy/MM/dd HH:mm")</div>

    <table>
        <thead><tr><th>الرقم</th><th>التاريخ</th><th>المورد</th><th>المشروع</th><th>أمر التوريد</th><th>الإجمالي</th><th>المسدَّد</th><th>المتبقي</th></tr></thead>
        <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>PI-@i.Number</td><td>@D(i.InvoiceDate)</td><td>@i.Supplier</td><td>@i.Project</td>
                <td>@(i.OrderNumber.HasValue ? "PO-" + i.OrderNumber.Value.ToString("D4") : "—")</td>
                <td>@N(i.Total)</td><td>@N(i.Paid)</td><td>@N(i.Remaining)</td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="8">لا توجد فواتير مشتريات.</td></tr>
        }
        </tbody>
        <tfoot><tr><th colspan="5">الإجمالي</th><th>@N(total)</th><th>@N(paid)</th><th>@N(total - paid)</th></tr></tfoot>
    </table>

    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
    @await Component.InvokeAsync("ReportBackground", new { part = "close" })
</body>
</html>
