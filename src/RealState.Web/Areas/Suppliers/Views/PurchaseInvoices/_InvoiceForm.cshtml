@model InvoiceFormModel
<form id="appModalForm" asp-area="Suppliers" asp-controller="PurchaseInvoices" asp-action="Form" method="post"
      data-modal-init="pdInit" data-order-lines-url="@Url.Action("OrderLines", "PurchaseInvoices", new { area = "Suppliers" })">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Number" />

    @if (Model.Suppliers.Count == 0)
    {
        <div class="status-message" style="background:rgba(250,178,25,.12);border-color:var(--warning);color:var(--warning);">
            أضف موردًا واحدًا على الأقل قبل إنشاء فاتورة مشتريات.
        </div>
    }

    @* Row 1: number · date · payment type — Row 2: warehouse · supplier · safe — Row 3: project · order — then help and one-line notes. *@
    <div class="form-grid form-grid-3">
        <div>
            <label class="form-label">رقم الفاتورة</label>
            <input class="form-control" value="PI-@Model.Number" dir="ltr" readonly
                   title="@(Model.Id == Guid.Empty ? "الرقم المتوقع — يُثبَّت عند الحفظ" : "")" />
        </div>
        <div>
            <label asp-for="InvoiceDate" class="form-label"></label>
            <input asp-for="InvoiceDate" class="form-control" type="datetime-local" dir="ltr" asp-format="{0:yyyy-MM-ddTHH:mm}" max="@(ClientTime.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))T23:59" />
            <span asp-validation-for="InvoiceDate" class="field-validation-error"></span>
        </div>
        <div>
            <label class="form-label">طريقة الدفع</label>
            <div class="sched-mode">
                <label><input type="radio" name="PaymentType" value="Credit" checked="@(Model.PaymentType == InvoicePaymentType.Credit)" data-pay-type /> آجل</label>
                @if (Model.CanCash || Model.PaymentType == InvoicePaymentType.Cash)
                {
                    <label><input type="radio" name="PaymentType" value="Cash" checked="@(Model.PaymentType == InvoicePaymentType.Cash)" data-pay-type /> نقدي</label>
                }
            </div>
            <span asp-validation-for="PaymentType" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="WarehouseId" class="form-label"></label>
            <select asp-for="WarehouseId" class="form-control" data-searchable asp-items="Model.Warehouses"><option value="">— اختر المخزن —</option></select>
            <span asp-validation-for="WarehouseId" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="SupplierId" class="form-label"></label>
            <select asp-for="SupplierId" class="form-control" data-searchable asp-items="Model.Suppliers" data-pay-party data-cash-id="@Model.CashSupplierId"><option value="">— اختر المورد —</option></select>
            <span asp-validation-for="SupplierId" class="field-validation-error"></span>
        </div>
        @* Always shown; enabled for نقدي only (a disabled select isn't posted — آجل has no safe). *@
        <div data-pay-safe>
            <label asp-for="CashSafeId" class="form-label"></label>
            <select asp-for="CashSafeId" class="form-control" asp-items="Model.Safes" disabled="@(Model.PaymentType != InvoicePaymentType.Cash)"
                    title="يُدفع إجمالي الفاتورة النقدية من هذه الخزنة عند الحفظ (سند صرف تلقائي)"><option value="">— اختر الخزنة —</option></select>
            <span asp-validation-for="CashSafeId" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="ProjectId" class="form-label"></label>
            <select asp-for="ProjectId" class="form-control" data-searchable asp-items="Model.Projects"><option value="">— بدون مشروع —</option></select>
            <span asp-validation-for="ProjectId" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="PurchaseOrderId" class="form-label"></label>
            <select asp-for="PurchaseOrderId" class="form-control" data-searchable asp-items="Model.Orders" onchange="pdOrderPicked(this)"><option value="">— بدون أمر توريد —</option></select>
            <span asp-validation-for="PurchaseOrderId" class="field-validation-error"></span>
        </div>
        <div class="full">
            @* Inline (collapsible) so reading it doesn't replace the form in the shared modal. *@
            <details style="border:1px solid var(--border);border-radius:8px;padding:6px 10px;background:var(--surface-2);">
                <summary style="cursor:pointer;color:var(--text-secondary);font-size:13px;">
                    ❓ عند الحفظ تُستلم الأصناف المخزنية في المخزن المختار بإذن استلام تلقائي بتكلفة الوحدة المُدخلة، فتتحدّث تكلفة الصنف حسب طريقة التكلفة — اضغط للشرح
                </summary>
                <div style="margin-top:8px;"><partial name="_Help" /></div>
            </details>
        </div>
        <div class="full">
            <label asp-for="Notes" class="form-label"></label>
            <input asp-for="Notes" class="form-control" autocomplete="off" />
        </div>
    </div>

    <partial name="_DocItems" model="new DocItemsVm(Model.Items, Model.Products, true)" />

    <button type="submit" class="btn-primary" style="margin-top:12px;" disabled="@(Model.Suppliers.Count == 0 || Model.Products.Count == 0)">💾 حفظ فاتورة المشتريات</button>
</form>
