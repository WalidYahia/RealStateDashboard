@model DocItemsVm
@*
    Product-lines (الأصناف) editor shared by the purchase order and invoice forms. Behaviour lives in
    wwwroot/js/purchase-doc.js (picking a product shows المخزون الحالي; تكلفة الوحدة is entered manually; totals recalc).
    ShowCost=false (purchase orders) → product + quantity only, no unit cost / totals.
*@
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Q(decimal v) => v.ToString("0.####", inv);
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    // A zero cost (e.g. lines copied from a quantity-only order) renders empty so the user types it.
    string C(decimal v) => v == 0 ? "" : Q(v);
}
<style>
    /* Lines list: pinned header, scrolls after a few rows. The product picker menu is position:fixed, so it isn't clipped. */
    .pd-scroll { max-height: 330px; overflow-y: auto; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 8px; }
    .pd-scroll table { margin-bottom: 0; }
    .pd-scroll thead th { position: sticky; top: 0; z-index: 1; background: var(--surface-2); }
    .pd-scroll td { vertical-align: middle; }
</style>
<h4 style="font-size:14px;margin:14px 0 6px;">الأصناف</h4>
@if (Model.Products.Count == 0)
{
    <div class="status-message" style="background:rgba(250,178,25,.12);border-color:var(--warning);color:var(--warning);">
        لا توجد أصناف مفعّلة. أضف الأصناف من صفحة «الأصناف» في المخزون أولًا.
    </div>
}
<div class="pd-scroll">
    <table class="rs-table" data-no-grid>
        <thead>
            <tr>
                <th style="min-width:240px;">الصنف</th>
                @if (Model.ShowCost) { <th style="width:130px;">تكلفة الوحدة</th> }
                @if (Model.ShowStock) { <th style="width:110px;">المخزون الحالي</th> }
                <th style="width:110px;">الكمية</th>
                @if (Model.ShowCost) { <th style="width:120px;">الإجمالي</th> }
                <th style="width:40px;"></th>
            </tr>
        </thead>
        <tbody id="pdBody">
        @for (var i = 0; i < Model.Items.Count; i++)
        {
            var it = Model.Items[i];
            <tr>
                <td>
                    <input type="hidden" name="Items.Index" value="@i" />
                    @if (it.ProductId is null && !string.IsNullOrWhiteSpace(it.LegacyName))
                    {
                        @* Legacy free-text line from before orders used products — kept as-is. *@
                        <input type="hidden" name="Items[@i].LegacyName" value="@it.LegacyName" />
                        <span title="بند قديم بدون صنف">@it.LegacyName</span>
                    }
                    else
                    {
                        <select class="form-control" style="margin:0" name="Items[@i].ProductId" data-searchable data-pd-product data-search-placeholder="🔍 ابحث بالكود أو الاسم...">
                            <option value="">— اختر الصنف —</option>
                            @foreach (var p in Model.Products)
                            {
                                <option value="@p.Id" data-stock="@(p.Tracked ? Q(p.Stock) : "")" selected="@(p.Id == it.ProductId)">@p.Label</option>
                            }
                        </select>
                    }
                </td>
                @if (Model.ShowCost) { <td><input class="form-control" style="margin:0" type="number" step="0.0001" min="0" dir="ltr" name="Items[@i].Cost" value="@C(it.Cost)" data-pd-cost /></td> }
                @if (Model.ShowStock) { <td class="pd-stock" dir="ltr" style="text-align:right;">—</td> }
                <td><input class="form-control" style="margin:0" type="number" step="0.0001" min="0" dir="ltr" name="Items[@i].Quantity" value="@Q(it.Quantity)" data-pd-qty /></td>
                @if (Model.ShowCost) { <td dir="ltr" style="text-align:right;"><span class="pd-line">@N(it.LineTotal)</span></td> }
                <td><button type="button" class="btn-sm btn-danger" onclick="pdRemoveRow(this)">✕</button></td>
            </tr>
        }
        </tbody>
    </table>
</div>
<template id="pdRowTpl">
    <tr>
        <td>
            <input type="hidden" name="Items.Index" value="__k__" />
            <select class="form-control" style="margin:0" name="Items[__k__].ProductId" data-searchable data-pd-product data-search-placeholder="🔍 ابحث بالكود أو الاسم...">
                <option value="">— اختر الصنف —</option>
                @foreach (var p in Model.Products)
                {
                    <option value="@p.Id" data-stock="@(p.Tracked ? Q(p.Stock) : "")">@p.Label</option>
                }
            </select>
        </td>
        @if (Model.ShowCost) { <td><input class="form-control" style="margin:0" type="number" step="0.0001" min="0" dir="ltr" name="Items[__k__].Cost" data-pd-cost /></td> }
        @if (Model.ShowStock) { <td class="pd-stock" dir="ltr" style="text-align:right;">—</td> }
        <td><input class="form-control" style="margin:0" type="number" step="0.0001" min="0" dir="ltr" name="Items[__k__].Quantity" value="1" data-pd-qty /></td>
        @if (Model.ShowCost) { <td dir="ltr" style="text-align:right;"><span class="pd-line">0</span></td> }
        <td><button type="button" class="btn-sm btn-danger" onclick="pdRemoveRow(this)">✕</button></td>
    </tr>
</template>
<div style="display:flex;justify-content:space-between;align-items:center;">
    <button type="button" class="btn-sm" onclick="pdAddRow()" disabled="@(Model.Products.Count == 0)">➕ إضافة صنف</button>
    @if (Model.ShowCost)
    {
        <div style="font-weight:700;">الإجمالي: <span id="pdTotal">@N(Model.Items.Sum(i => i.LineTotal))</span> ج.م</div>
    }
    else
    {
        <div style="font-weight:700;">إجمالي الكميات: <span id="pdQtyTotal">@Q(Model.Items.Sum(i => i.Quantity))</span></div>
    }
</div>
