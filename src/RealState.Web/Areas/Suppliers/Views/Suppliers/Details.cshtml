@model SupplierStatementVm
@{
    ViewData["Title"] = $"كشف حساب {Model.Supplier.Name}";
    var canPay = ViewData["CanPay"] as bool? ?? false;
    string N(decimal v) => v.ToString("N0", RealState.Web.AppCulture.Ar);
    string D(DateTime d) => RealState.Web.AppCulture.When(d);   // date + time when it has one
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var detailed = ViewData["Detailed"] as bool? ?? false;
    var canDeleteAdjustment = User.Can(PermissionNames.SuppliersDeleteAdjustment);
    var back = Context.Request.Path + Context.Request.QueryString;
}
<div class="page-head">
    <div>
        <h1>كشف حساب — @Model.Supplier.Name</h1>
        <p style="color:var(--muted);margin:2px 0 0;">@Model.Supplier.Phone @(string.IsNullOrEmpty(Model.Supplier.Email) ? "" : "· " + Model.Supplier.Email)</p>
    </div>
    <div style="display:flex;gap:8px;">
        <a class="btn-sm" asp-controller="Suppliers" asp-action="Index" onclick="if (history.length > 1) { history.back(); return false; }">رجوع</a>
        @if (ViewData["CanViewInvoices"] as bool? ?? false)
        {
            <a class="btn-sm" asp-controller="PurchaseInvoices" asp-action="Index" asp-route-supplierId="@Model.Supplier.Id">فواتير المشتريات</a>
        }
        @* Payments are on the account (سند صرف) — not on a particular invoice. *@
        @if (canPay)
        {
            <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("PayForm", new { id = Model.Supplier.Id })', 'سداد دفعة للمورد')">💵 سداد</button>
        }
        @if (User.Can(PermissionNames.SuppliersAdjustBalance))
        {
            <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", "BalanceAdjustments", new { area = "Accounting", party = "supplier", id = Model.Supplier.Id })', 'تسوية رصيد المورد')">⚖️ تسوية رصيد</button>
        }
        @if (User.Can(PermissionNames.SuppliersEdit))
        {
            <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = Model.Supplier.Id })', 'تعديل المورد')">✏️ تعديل</button>
        }
        @if (User.Can(PermissionNames.SuppliersDelete))
        {
            <form asp-action="Delete" asp-route-id="@Model.Supplier.Id" method="post" style="display:inline;" data-confirm="حذف المورد «@Model.Supplier.Name»؟" data-danger>@Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">🗑 حذف المورد</button></form>
        }
    </div>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

<div class="kpi-grid" style="grid-template-columns: repeat(3, 1fr);">
    <div class="kpi k-reserve"><div class="kpi-label">إجمالي المستحقات</div><div class="kpi-value">@N(Model.TotalObligations) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@Model.InvoicesCount فاتورة</div></div>
    <div class="kpi k-collect"><div class="kpi-label">المسدَّد</div><div class="kpi-value">@N(Model.TotalPaid) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@Model.PaymentsCount دفعة</div></div>
    <div class="kpi k-alerts"><div class="kpi-label">المتبقي</div><div class="kpi-value">@N(Model.TotalRemaining) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">مستحق الدفع للمورد</div></div>
</div>

@{
    var filter = FilterBarVm.For(Url.Action("Details", new { id = Model.Supplier.Id }))
        .WithTitle("تصفية كشف الحساب")
        .DateRange(F(Model.From), F(Model.To))
        .Print(Url.Action("PrintStatement", "Suppliers", new { id = Model.Supplier.Id, from = F(Model.From), to = F(Model.To), detailed = detailed ? "true" : null }), "طباعة كشف الحساب");
}
<partial name="_FilterBar" model="filter" />

<div class="card-tile">
    <label class="stmt-detail-toggle"><input type="checkbox" data-items-all="#supLedger" data-print-key="PrintStatement" checked="@detailed" /> تفصيلي <span>— أصناف كل فاتورة تحت سطرها (وفي الطباعة)</span></label>
    <div class="list-search-bar"><input class="form-control list-search" data-target="#supLedger" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="supLedger">
        <thead><tr><th>المصدر</th><th>التاريخ</th><th>البيان</th><th>رصيد قبل</th><th>المبلغ</th><th>الرصيد</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            if (r.Kind == SupplierLedgerKind.PeriodOpening)
            {
                @* «الرصيد الافتتاحي للفترة»: the balance carried in from before the period — balance only. *@
                <tr class="period-opening" data-skip-search><td>@r.Source</td><td dir="ltr" style="text-align:right;">@D(r.Date)</td><td>@r.Statement</td><td>—</td><td>—</td><td style="font-weight:800;white-space:nowrap;">@N(r.Balance)</td></tr>
                continue;
            }
            var isPay = r.Decreases;
            var hasItems = r.Items.Count > 0;
            <tr data-items="@(hasItems ? "" : null)" data-open="@(hasItems ? (detailed ? "1" : "0") : null)">
                <td>
                    @if (r.Kind == SupplierLedgerKind.Invoice && (ViewData["CanViewInvoices"] as bool? ?? false))
                    {
                        <a asp-controller="PurchaseInvoices" asp-action="Details" asp-route-id="@r.Id" style="color:var(--series-1);text-decoration:none;font-weight:600;">@r.Source</a>
                    }
                    else if (r.Kind == SupplierLedgerKind.Order)
                    {
                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@r.Id" style="color:var(--series-1);text-decoration:none;font-weight:600;">@r.Source</a>
                    }
                    else if (r.Kind == SupplierLedgerKind.Return && User.Can(PermissionNames.PurchaseReturnsView))
                    {
                        <a asp-controller="PurchaseReturns" asp-action="Details" asp-route-id="@r.Id" style="color:var(--series-1);text-decoration:none;font-weight:600;">@r.Source</a>
                    }
                    else
                    {
                        @r.Source
                    }
                </td>
                <td dir="ltr" style="text-align:right;">@D(r.Date)</td>
                <td>
                    @r.Statement
                    @if (hasItems)
                    {
                        <button type="button" class="stmt-items-btn" data-items-toggle aria-expanded="@(detailed ? "true" : "false")">الأصناف (@r.Items.Count)</button>
                    }
                    @if (r.Kind == SupplierLedgerKind.Payment)
                    {
                        <a class="btn-sm" asp-controller="Payments" asp-action="Receipt" asp-route-id="@r.Id" target="_blank" style="margin-inline-start:8px;">🖨 طباعة</a>
                    }
                    else if (r.Kind is SupplierLedgerKind.AccountPayment or SupplierLedgerKind.AccountReceipt)
                    {
                        <a class="btn-sm" asp-action="VoucherReceipt" asp-route-id="@r.Id" target="_blank" style="margin-inline-start:8px;">🖨 طباعة</a>
                    }
                    else if (r.Kind is SupplierLedgerKind.AdjustmentUp or SupplierLedgerKind.AdjustmentDown && canDeleteAdjustment)
                    {
                        <form asp-area="Accounting" asp-controller="BalanceAdjustments" asp-action="Delete" asp-route-id="@r.Id" asp-route-returnUrl="@back" method="post" style="display:inline;margin-inline-start:8px;"
                              data-confirm="حذف @r.Source وعكس قيدها؟" data-danger>@Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">🗑</button></form>
                    }
                    else if (r.Kind == SupplierLedgerKind.Refund && User.Can(PermissionNames.PurchaseReturnsView))
                    {
                        <a class="btn-sm" asp-controller="PurchaseReturns" asp-action="RefundVoucher" asp-route-id="@r.Id" target="_blank" style="margin-inline-start:8px;">🖨 طباعة</a>
                    }
                </td>
                <td style="white-space:nowrap;color:var(--muted);">@N(r.BalanceBefore)</td>
                <td style="color:@(isPay ? "var(--good)" : "var(--critical)");white-space:nowrap;">@(isPay ? "−" : "+")@N(r.Amount)</td>
                <td style="font-weight:600;white-space:nowrap;">@N(r.Balance)</td>
            </tr>
            if (hasItems)
            {
                <partial name="_StatementItemsRow" model="r.Items" />
            }
        }
        @if (!Model.HasEntries)
        {
            <tr data-skip-search><td colspan="6" style="color:var(--muted)">لا توجد حركات في هذه الفترة.</td></tr>
        }
        <tr data-no-results data-skip-search style="display:none;"><td colspan="6" style="color:var(--muted)">لا توجد نتائج مطابقة.</td></tr>
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5" style="text-align:start;font-weight:700;">الرصيد الختامي للفترة</td>
                <td style="font-weight:800;white-space:nowrap;">@N(Model.ClosingBalance) ج.م</td>
            </tr>
        </tfoot>
    </table>
</div>

@section Scripts {
    <script src="~/js/statement-items.js" asp-append-version="true"></script>
    <script src="~/js/balance-adjust.js" asp-append-version="true"></script>
}
