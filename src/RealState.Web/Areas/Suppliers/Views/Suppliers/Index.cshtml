@model List<Supplier>
@{
    ViewData["Title"] = "الموردون والمقاولون";
}
<div class="page-head"><h1>الموردون والمقاولون</h1></div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

<div class="card-tile">
    <div class="card-head">
        <h3>قائمة الموردين</h3>
        <div style="display:flex;gap:8px;align-items:center;margin-inline-start:auto;">
            <input id="supSearch" class="form-control" style="margin:0;width:260px;" placeholder="🔍 بحث بالاسم أو رقم الهاتف..." />
            @if (User.Can(PermissionNames.SuppliersCreate))
            {
                <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'مورد جديد')">➕ مورد جديد</button>
            }
        </div>
    </div>
    <table class="rs-table" id="supTable">
        <thead><tr><th>الاسم</th><th>الهاتف</th><th>البريد الإلكتروني</th><th></th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr data-search="@(((s.Name ?? "") + " " + (s.Phone ?? "")).ToLower())">
                <td>@s.Name</td>
                <td dir="ltr" style="text-align:right;">@s.Phone</td>
                <td dir="ltr" style="text-align:right;">@s.Email</td>
                <td style="white-space:nowrap;">
                    <a class="btn-sm" asp-action="Details" asp-route-id="@s.Id">كشف حساب</a>
                    @if (User.Can(PermissionNames.SuppliersEdit))
                    {
                        <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = s.Id })', 'تعديل المورد')">تعديل</button>
                    }
                    @if (User.Can(PermissionNames.SuppliersDelete))
                    {
                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline;" data-confirm="حذف المورد «@s.Name»؟" data-danger>
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-sm btn-danger">حذف</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="4" style="color:var(--muted)">لا يوجد موردون بعد.</td></tr>
        }
        <tr id="supNoResults" style="display:none;"><td colspan="4" style="color:var(--muted)">لا توجد نتائج مطابقة للبحث.</td></tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        (function () {
            var box = document.getElementById('supSearch');
            if (!box) return;
            box.addEventListener('input', function () {
                var q = this.value.trim().toLowerCase();
                var rows = document.querySelectorAll('#supTable tbody tr[data-search]');
                var shown = 0;
                rows.forEach(function (tr) {
                    var match = tr.dataset.search.indexOf(q) >= 0;
                    tr.style.display = match ? '' : 'none';
                    if (match) shown++;
                });
                document.getElementById('supNoResults').style.display = (rows.length && shown === 0) ? '' : 'none';
            });
        })();
    </script>
}
