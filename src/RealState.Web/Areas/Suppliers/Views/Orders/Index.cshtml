@model List<OrderListItem>
@{
    ViewData["Title"] = "أوامر التوريد";
    var canCreate = ViewData["CanCreate"] as bool? ?? false;
    var canEdit = ViewData["CanEdit"] as bool? ?? false;
    var canViewInvoices = ViewData["CanViewInvoices"] as bool? ?? false;
    string D(DateTime d) => d.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture);
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    string PO(int n) => "PO-" + n.ToString("D4");
    string PI(int n) => "PI-" + n;
    string Q(decimal v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="page-head">
    <h1>أوامر التوريد</h1>
    <div style="display:flex;gap:8px;">
        @if (canCreate)
        {
            <button type="button" class="btn-new-tenant" data-quick-new onclick="appOpenModal('@Url.Action("Form")', 'أمر توريد جديد', 'xl')">➕ أمر توريد جديد</button>
        }
    </div>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

@{
    var projId = (ViewBag.ProjectId as Guid?)?.ToString();
    var projList = ViewBag.Projects as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var fFrom = F((DateTime?)ViewBag.From); var fTo = F((DateTime?)ViewBag.To);
    var filter = FilterBarVm.For(Url.Action("Index"))
        .DateRange(fFrom, fTo, "تاريخ الأمر")
        .Select("projectId", "المشروع", projList, projId)
        .Print(Url.Action("PrintList", new { from = fFrom, to = fTo, projectId = projId }));
}
<partial name="_FilterBar" model="filter" />

<div class="card-tile">
    <div class="card-head">
        <h3>الأوامر</h3>
        <span class="pill">الأوامر: <span data-live-count="#ordTable">@Model.Count</span></span>
    </div>
    <div class="list-search-bar"><input class="form-control list-search" data-target="#ordTable" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="ordTable">
        <thead>
            <tr><th>الرقم</th><th>التاريخ</th><th>المشروع</th><th>عدد الأصناف</th><th>إجمالي الكميات</th><th>فواتير المشتريات</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var o in Model)
        {
            <tr data-search="@((PO(o.Number) + " " + o.Project + " " + string.Join(" ", o.Invoices.Select(i => PI(i.Number)))).ToLower())">
                <td style="white-space:nowrap;"><span style="display:inline-flex;align-items:center;gap:6px;direction:rtl;"><a asp-action="Details" asp-route-id="@o.Id" style="color:var(--series-1);text-decoration:none;font-weight:600;">@PO(o.Number)</a>@if (o.HasAttachments) {<span title="يوجد مرفقات على هذا الأمر" style="font-size:18px;line-height:1;cursor:default;">📎</span>}</span></td>
                <td dir="ltr" style="text-align:right;">@D(o.OrderDate)</td>
                <td>@o.Project</td>
                <td>@o.ItemCount</td>
                <td dir="ltr" style="text-align:right;">@Q(o.TotalQuantity)</td>
                <td>
                    @if (o.Invoices.Count == 0)
                    {
                        <span style="color:var(--muted);">—</span>
                    }
                    else
                    {
                        <span style="display:inline-flex;flex-wrap:wrap;gap:4px 10px;">
                        @foreach (var inv in o.Invoices)
                        {
                            if (canViewInvoices)
                            {
                                <a asp-controller="PurchaseInvoices" asp-action="Details" asp-route-id="@inv.Id" dir="ltr" style="color:var(--series-1);text-decoration:none;">@PI(inv.Number)</a>
                            }
                            else
                            {
                                <span dir="ltr">@PI(inv.Number)</span>
                            }
                        }
                        </span>
                    }
                </td>
                <td style="white-space:nowrap;">
                    <a class="btn-sm" asp-action="Details" asp-route-id="@o.Id">التفاصيل</a>
                    @if (canEdit)
                    {
                        <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = o.Id })', 'تعديل أمر التوريد', 'xl')">✏️ تعديل</button>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr data-skip-search><td colspan="7" style="color:var(--muted)">لا توجد أوامر توريد بعد.</td></tr>
        }
        <tr data-no-results data-skip-search style="display:none;"><td colspan="7" style="color:var(--muted)">لا توجد نتائج مطابقة للبحث.</td></tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/purchase-doc.js" asp-append-version="true"></script>
}
