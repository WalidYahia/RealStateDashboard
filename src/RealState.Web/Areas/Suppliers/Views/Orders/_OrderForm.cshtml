@model OrderFormModel
<form id="appModalForm" asp-area="Suppliers" asp-controller="Orders" asp-action="Form" method="post" data-modal-init="pdInit">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Number" />

    <div class="form-grid">
        <div>
            <label class="form-label">رقم الأمر</label>
            <input class="form-control" value="PO-@Model.Number.ToString("D4")" dir="ltr" readonly
                   title="@(Model.Id == Guid.Empty ? "الرقم المتوقع — يُثبَّت عند الحفظ" : "")" />
        </div>
        <div>
            <label asp-for="OrderDate" class="form-label"></label>
            <input asp-for="OrderDate" class="form-control" type="date" dir="ltr" />
            <span asp-validation-for="OrderDate" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="ProjectId" class="form-label"></label>
            <select asp-for="ProjectId" class="form-control" data-searchable asp-items="Model.Projects"><option value="">— بدون مشروع —</option></select>
            <span asp-validation-for="ProjectId" class="field-validation-error"></span>
        </div>
        <div class="full">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <partial name="_DocItems" model="new DocItemsVm(Model.Items, Model.Products, false, Model.ShowCost)" />

    <button type="submit" class="btn-primary" style="margin-top:12px;" disabled="@(Model.Products.Count == 0 && Model.Items.All(i => string.IsNullOrWhiteSpace(i.LegacyName)))">💾 حفظ أمر التوريد</button>
</form>
