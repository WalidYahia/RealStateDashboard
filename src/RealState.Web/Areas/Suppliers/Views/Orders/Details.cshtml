@model SupplierOrder
@{
    ViewData["Title"] = $"أمر توريد PO-{Model.Number:D4}";
    var canViewInvoices = ViewData["CanViewInvoices"] as bool? ?? false;
    var canCreateInvoice = ViewData["CanCreateInvoice"] as bool? ?? false;
    var fullyInvoiced = ViewData["FullyInvoiced"] as bool? ?? false;
    var invoices = ViewBag.Invoices as List<InvoiceListItem> ?? new();
    string N(decimal v) => v.ToString("N2", RealState.Web.AppCulture.Ar);
    string Q(decimal v) => v.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
    string D(DateTime d) => d.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture);
    string PI(int n) => "PI-" + n;
    var total = Model.Items.Sum(i => i.LineTotal);   // legacy orders only
    var totalQty = Model.Items.Sum(i => i.Quantity);
    var invoiced = invoices.Sum(i => i.Total);
}
<div class="page-head">
    <div>
        <h1>أمر توريد <span class="proj-code">PO-@Model.Number.ToString("D4")</span></h1>
        <p style="color:var(--muted);margin:2px 0 0;">@(Model.Project?.Name ?? "بدون مشروع") · @D(Model.OrderDate)</p>
    </div>
    <div style="display:flex;gap:8px;">
        <a class="btn-sm" asp-action="Index" onclick="if (history.length > 1) { history.back(); return false; }">رجوع</a>
        @if (fullyInvoiced)
        {
            <span class="badge-state state-on" style="display:inline-flex;align-items:center;min-height:34px;" title="كل أصناف الأمر فُوترت بالكامل">✓ مُفوتَر بالكامل</span>
        }
        else if (canCreateInvoice)
        {
            <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form", "PurchaseInvoices", new { orderId = Model.Id })', 'فاتورة مشتريات جديدة', 'xl')">🧾 إنشاء فاتورة مشتريات</button>
        }
        <a class="btn-new-tenant" asp-action="PrintOrder" asp-route-id="@Model.Id" target="_blank">🖨 طباعة الأمر (PDF)</a>
        @if (User.Can(PermissionNames.SuppliersEdit))
        {
            <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = Model.Id })', 'تعديل أمر التوريد', 'xl')">✏️ تعديل</button>
        }
        @if (User.Can(PermissionNames.SuppliersDelete))
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;" data-confirm="حذف أمر التوريد PO-@Model.Number.ToString("D4")؟" data-danger>@Html.AntiForgeryToken()<button type="submit" class="btn-sm btn-danger">🗑 حذف الأمر</button></form>
        }
    </div>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

<div class="kpi-grid" style="grid-template-columns: repeat(2, 1fr);">
    <div class="kpi k-reserve"><div class="kpi-label">الأصناف المطلوبة</div><div class="kpi-value">@Model.Items.Count <span class="kpi-unit">صنف</span></div><div class="kpi-foot">إجمالي الكميات: @Q(totalQty)</div></div>
    <div class="kpi k-collect"><div class="kpi-label">المُفوتَر</div><div class="kpi-value">@N(invoiced) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@invoices.Count فاتورة مشتريات</div></div>
</div>

<div class="card-tile" style="margin-bottom:14px;">
    <div class="card-head"><h3>الأصناف</h3></div>
    <table class="rs-table">
        @* Orders are quantity-only; a legacy order (which still owns a supplier payable) also shows its costs. *@
        @* المُفوتَر / المتبقي are per product (an order may list a product on more than one line), counted in the product's
           smallest unit and shown in each line's own unit. *@
        <thead><tr><th>#</th><th>الصنف</th><th>الوحدة</th><th>الكمية</th><th>المُفوتَر</th><th>المتبقي</th>@if (Model.IsLegacy) {<th>تكلفة الوحدة</th><th>الإجمالي</th>}</tr></thead>
        <tbody>
        @{
            var n = 0;
            var invoicedQty = ViewBag.InvoicedQty as Dictionary<Guid, decimal> ?? new();
            var orderedQty = Model.Items.Where(i => i.ProductId.HasValue).GroupBy(i => i.ProductId!.Value).ToDictionary(g => g.Key, g => g.Sum(i => i.Quantity * i.UnitFactor));
        }
        @foreach (var it in Model.Items)
        {
            n++;
            var f = it.UnitFactor > 0 ? it.UnitFactor : 1m;
            var billed = it.ProductId is Guid pid ? invoicedQty.GetValueOrDefault(pid) / f : 0m;
            var left = it.ProductId is Guid pid2 ? orderedQty[pid2] / f - billed : 0m;
            <tr>
                <td>@n</td><td>@it.Name</td><td>@(it.Unit ?? "—")</td>
                <td dir="ltr" style="text-align:right;">@Q(it.Quantity)</td>
                <td dir="ltr" style="text-align:right;">@(it.ProductId.HasValue ? Q(billed) : "—")</td>
                <td dir="ltr" style="text-align:right;@(it.ProductId.HasValue && left <= 0 ? "color:var(--good);font-weight:700;" : "")">@(it.ProductId.HasValue ? (left <= 0 ? "مكتمل ✓" : Q(left)) : "—")</td>
                @if (Model.IsLegacy) {<td>@N(it.Cost)</td><td>@N(it.LineTotal)</td>}
            </tr>
        }
        </tbody>
        <tfoot><tr><th colspan="3">الإجمالي</th><th dir="ltr" style="text-align:right;">@Q(totalQty)</th><th></th><th></th>@if (Model.IsLegacy) {<th></th><th>@N(total) ج.م</th>}</tr></tfoot>
    </table>
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <p style="color:var(--muted);margin-top:10px;">ملاحظات: @Model.Notes</p>
    }
</div>

<div class="card-tile" style="margin-bottom:14px;">
    <div class="card-head"><h3>فواتير المشتريات المرتبطة</h3></div>
    <table class="rs-table">
        <thead><tr><th>رقم الفاتورة</th><th>التاريخ</th><th>المورد</th><th>عدد الأصناف</th><th>الإجمالي</th></tr></thead>
        <tbody>
        @foreach (var i in invoices)
        {
            <tr>
                <td dir="ltr" style="text-align:right;">
                    @if (canViewInvoices)
                    {
                        <a asp-controller="PurchaseInvoices" asp-action="Details" asp-route-id="@i.Id" style="color:var(--series-1);text-decoration:none;font-weight:600;">@PI(i.Number)</a>
                    }
                    else
                    {
                        @PI(i.Number)
                    }
                </td>
                <td dir="ltr" style="text-align:right;">@D(i.InvoiceDate)</td>
                <td>@i.Supplier</td>
                <td>@i.ItemCount</td>
                <td>@N(i.Total)</td>
            </tr>
        }
        @if (invoices.Count == 0)
        {
            <tr><td colspan="5" style="color:var(--muted)">لا توجد فواتير مشتريات على هذا الأمر بعد.</td></tr>
        }
        </tbody>
    </table>
</div>

@if (Model.IsLegacy)
{
    @* Orders from before the invoice stage carried the supplier + payments themselves — keep showing them. *@
    <div class="card-tile" style="margin-bottom:14px;">
        <div class="card-head"><h3>المورد والدفعات (أمر سابق لمرحلة الفواتير)</h3></div>
        <p style="margin:0 0 10px;">
            المورد: <a asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierId" style="color:var(--series-1);font-weight:600;">@Model.Supplier?.Name</a>
            · المسدَّد: @N(Model.Payments.Sum(p => p.Amount)) ج.م · المتبقي: @N(total - Model.Payments.Sum(p => p.Amount)) ج.م
        </p>
        <table class="rs-table">
            <thead><tr><th>رقم الإيصال</th><th>التاريخ</th><th>المبلغ</th><th></th></tr></thead>
            <tbody>
            @foreach (var p in Model.Payments)
            {
                <tr>
                    <td dir="ltr" style="text-align:right;">@p.ReceiptNo.ToString("D5")</td>
                    <td dir="ltr" style="text-align:right;">@D(p.PaidDate)</td>
                    <td class="tag-up">@N(p.Amount)</td>
                    <td><a class="btn-sm" asp-controller="Payments" asp-action="Receipt" asp-route-id="@p.Id" target="_blank">🖨 إيصال صرف نقدية</a></td>
                </tr>
            }
            @if (Model.Payments.Count == 0)
            {
                <tr><td colspan="4" style="color:var(--muted)">لا توجد دفعات.</td></tr>
            }
            </tbody>
        </table>
    </div>
}

@{
    var attachments = ViewBag.Attachments as List<SupplierOrderAttachment> ?? new();
    var canEditOrder = User.Can(PermissionNames.SuppliersEdit);
    string Sz(long b) => b >= 1048576 ? $"{b / 1048576.0:0.#} م.ب" : $"{b / 1024.0:0.#} ك.ب";
}
<div class="card-tile" style="margin-top:14px;">
    <div class="card-head"><h3>المرفقات</h3></div>
    @if (canEditOrder)
    {
        <form asp-action="AttachmentUpload" method="post" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center;margin-bottom:14px;flex-wrap:wrap;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" value="@Model.Id" />
            <input type="file" name="file" class="form-control" style="margin:0;max-width:360px;" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt" />
            <button type="submit" class="btn-primary" style="width:auto;">⬆ رفع مرفق</button>
            <span style="color:var(--muted);font-size:12px;">صور، PDF، Word، Excel، نصوص — حتى 15 ميجابايت</span>
        </form>
    }
    <table class="rs-table">
        <thead><tr><th>الملف</th><th>النوع</th><th>الحجم</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in attachments)
        {
            <tr>
                <td>@a.FileName</td>
                <td dir="ltr" style="text-align:right;color:var(--muted);">@a.ContentType</td>
                <td dir="ltr" style="text-align:right;">@Sz(a.Size)</td>
                <td style="white-space:nowrap;">
                    <a class="btn-sm" asp-action="AttachmentPreview" asp-route-id="@a.Id" target="_blank">👁 معاينة</a>
                    <a class="btn-sm" asp-action="AttachmentDownload" asp-route-id="@a.Id" target="_blank">تنزيل</a>
                    @if (canEditOrder)
                    {
                        <form asp-action="AttachmentDelete" method="post" style="display:inline;" data-confirm="حذف المرفق؟" data-danger>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="orderId" value="@Model.Id" />
                            <button type="submit" class="btn-sm btn-danger">حذف</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (attachments.Count == 0)
        {
            <tr><td colspan="4" style="color:var(--muted)">لا توجد مرفقات بعد.</td></tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/purchase-doc.js" asp-append-version="true"></script>
}
