@model SupplierOrder
@{
    ViewData["Title"] = $"أمر توريد PO-{Model.Number:D4}";
    var canPay = ViewData["CanPay"] as bool? ?? false;
    string N(decimal v) => v.ToString("N0", new System.Globalization.CultureInfo("ar-EG"));
    string Q(decimal v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string D(DateTime d) => d.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture);
    var total = Model.Items.Sum(i => i.LineTotal);
    var paid = Model.Payments.Sum(p => p.Amount);
    var remaining = total - paid;
}
<div class="page-head">
    <div>
        <h1>أمر توريد <span class="proj-code">PO-@Model.Number.ToString("D4")</span></h1>
        <p style="color:var(--muted);margin:2px 0 0;">@Model.Supplier?.Name · @(Model.Project?.Name ?? "بدون مشروع") · @D(Model.OrderDate)</p>
    </div>
    <div style="display:flex;gap:8px;">
        <a class="btn-sm" asp-action="Index">رجوع</a>
        @if (Model.Supplier is not null)
        {
            <a class="btn-sm" asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierId">كشف حساب المورد</a>
        }
        @if (canPay && remaining > 0)
        {
            <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Pay", new { id = Model.Id })', 'سداد دفعة على الأمر')">💵 سداد دفعة</button>
        }
        <a class="btn-new-tenant" asp-action="PrintOrder" asp-route-id="@Model.Id" target="_blank">🖨 طباعة الأمر (PDF)</a>
    </div>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

<div class="kpi-grid" style="grid-template-columns: repeat(3, 1fr);">
    <div class="kpi k-reserve"><div class="kpi-label">إجمالي الأمر</div><div class="kpi-value">@N(total) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@Model.Items.Count بند</div></div>
    <div class="kpi k-collect"><div class="kpi-label">المسدَّد</div><div class="kpi-value">@N(paid) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@Model.Payments.Count دفعة</div></div>
    <div class="kpi k-alerts"><div class="kpi-label">المتبقي</div><div class="kpi-value">@N(remaining) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">مستحق الدفع</div></div>
</div>

<div class="card-tile" style="margin-bottom:14px;">
    <div class="card-head"><h3>البنود</h3></div>
    <table class="rs-table">
        <thead><tr><th>البند</th><th>تكلفة الوحدة</th><th>الكمية</th><th>الإجمالي</th></tr></thead>
        <tbody>
        @foreach (var it in Model.Items)
        {
            <tr><td>@it.Name</td><td>@N(it.Cost)</td><td dir="ltr" style="text-align:right;">@Q(it.Quantity)</td><td>@N(it.LineTotal)</td></tr>
        }
        </tbody>
        <tfoot><tr><th colspan="3">الإجمالي</th><th>@N(total) ج.م</th></tr></tfoot>
    </table>
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <p style="color:var(--muted);margin-top:10px;">ملاحظات: @Model.Notes</p>
    }
</div>

<div class="card-tile">
    <div class="card-head"><h3>الدفعات</h3></div>
    <table class="rs-table">
        <thead><tr><th>رقم الإيصال</th><th>التاريخ</th><th>المبلغ</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model.Payments)
        {
            <tr>
                <td dir="ltr" style="text-align:right;">@p.ReceiptNo.ToString("D5")</td>
                <td dir="ltr" style="text-align:right;">@D(p.PaidDate)</td>
                <td class="tag-up">@N(p.Amount)</td>
                <td><a class="btn-sm" asp-action="Receipt" asp-route-id="@p.Id" target="_blank">🖨 إيصال صرف نقدية</a></td>
            </tr>
        }
        @if (Model.Payments.Count == 0)
        {
            <tr><td colspan="4" style="color:var(--muted)">لا توجد دفعات بعد.</td></tr>
        }
        </tbody>
    </table>
</div>

@{
    var attachments = ViewBag.Attachments as List<SupplierOrderAttachment> ?? new();
    var canEditOrder = User.Can(PermissionNames.SuppliersEdit);
    string Sz(long b) => b >= 1048576 ? $"{b / 1048576.0:0.#} م.ب" : $"{b / 1024.0:0.#} ك.ب";
}
<div class="card-tile" style="margin-top:14px;">
    <div class="card-head"><h3>المرفقات</h3></div>
    @if (canEditOrder)
    {
        <form asp-action="AttachmentUpload" method="post" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center;margin-bottom:14px;flex-wrap:wrap;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" value="@Model.Id" />
            <input type="file" name="file" class="form-control" style="margin:0;max-width:360px;" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt" />
            <button type="submit" class="btn-primary" style="width:auto;">⬆ رفع مرفق</button>
            <span style="color:var(--muted);font-size:12px;">صور، PDF، Word، Excel، نصوص — حتى 15 ميجابايت</span>
        </form>
    }
    <table class="rs-table">
        <thead><tr><th>الملف</th><th>النوع</th><th>الحجم</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in attachments)
        {
            <tr>
                <td>@a.FileName</td>
                <td dir="ltr" style="text-align:right;color:var(--muted);">@a.ContentType</td>
                <td dir="ltr" style="text-align:right;">@Sz(a.Size)</td>
                <td style="white-space:nowrap;">
                    <a class="btn-sm" asp-action="AttachmentPreview" asp-route-id="@a.Id" target="_blank">👁 معاينة</a>
                    <a class="btn-sm" asp-action="AttachmentDownload" asp-route-id="@a.Id" target="_blank">تنزيل</a>
                    @if (canEditOrder)
                    {
                        <form asp-action="AttachmentDelete" method="post" style="display:inline;" data-confirm="حذف المرفق؟" data-danger>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="orderId" value="@Model.Id" />
                            <button type="submit" class="btn-sm btn-danger">حذف</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (attachments.Count == 0)
        {
            <tr><td colspan="4" style="color:var(--muted)">لا توجد مرفقات بعد.</td></tr>
        }
        </tbody>
    </table>
</div>
