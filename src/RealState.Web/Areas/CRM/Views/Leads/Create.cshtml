@model LeadFormModel
@{
    ViewData["Title"] = "عميل محتمل جديد";
}
<div class="page-head">
    <h1>عميل محتمل جديد</h1>
    <a class="btn-sm" asp-action="Index">رجوع</a>
</div>
<div class="card-tile" style="max-width:680px;">
    <form asp-action="Create" method="post">
        <partial name="_LeadFields" model="Model" />
        <button type="submit" class="btn-primary" style="margin-top:12px;">حفظ</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
