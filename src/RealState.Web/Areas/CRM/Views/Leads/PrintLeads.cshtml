@model List<LeadRow>
@{
    Layout = null;
    var tenantId = (Guid)ViewBag.TenantId;
    var from = ViewBag.From as DateTime?;
    var to = ViewBag.To as DateTime?;
    var salesperson = ViewBag.Salesperson as string;
    var source = ViewBag.Source as string;
    string D(DateTime d) => d.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>قائمة العملاء المحتملين</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, sans-serif; padding: 24px; color: #111; }
        .brand { text-align: center; margin-bottom: 6px; } .brand img { max-height: 60px; }
        h1 { font-size: 19px; text-align: center; margin: 4px 0; }
        .sub { text-align: center; color: #666; font-size: 12px; margin-bottom: 14px; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th, td { border: 1px solid #ccc; padding: 5px 7px; text-align: start; unicode-bidi: plaintext; }
        th { background: #f2f2f2; }
        .no-print { margin-bottom: 12px; } @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="no-print"><button onclick="window.print()">🖨 طباعة / حفظ PDF</button></div>
    <div class="brand"><img src="@Url.Action("Logo", "Branding", new { area = "", id = tenantId })" alt="logo" onerror="this.style.display='none'" /></div>
    <h1>قائمة العملاء المحتملين</h1>
    <div class="sub">
        @if (from.HasValue || to.HasValue) { <text>الفترة @D(from ?? DateTime.MinValue) — @D(to ?? DateTime.MaxValue) · </text> }
        @if (!string.IsNullOrEmpty(salesperson)) { <text>المندوب: @salesperson · </text> }
        @if (!string.IsNullOrEmpty(source)) { <text>المصدر: @source · </text> }
        العدد: @Model.Count · طُبع @DateTime.Now.ToString("yyyy/MM/dd HH:mm")
    </div>

    <table>
        <thead><tr><th>#</th><th>الاسم</th><th>الهاتف</th><th>تاريخ الإنشاء</th><th>المصدر</th><th>المندوب</th><th>الحالة</th></tr></thead>
        <tbody>
        @{ var i = 1; }
        @foreach (var l in Model)
        {
            <tr>
                <td>@i</td>
                <td>@l.Name</td>
                <td>@l.Phone</td>
                <td>@D(l.CreatedOn)</td>
                <td>@l.SourceLabel</td>
                <td>@l.Salesperson</td>
                <td>@(l.Interest.HasValue ? l.Interest.Value.Ar() : "—")</td>
            </tr>
            i++;
        }
        @if (Model.Count == 0) { <tr><td colspan="7">لا يوجد عملاء محتملون.</td></tr> }
        </tbody>
    </table>

    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
</body>
</html>
