@model List<Lead>
@using RealState.Web
@{
    ViewData["Title"] = "العملاء المحتملون";
    string N(decimal v) => v.ToString("N0", new System.Globalization.CultureInfo("ar-EG"));
}
<div class="page-head">
    <h1>العملاء المحتملون (Leads)</h1>
    @if (User.Can(PermissionNames.CustomersCreate))
    {
        <a class="btn-new-tenant" asp-action="Create">➕ عميل محتمل</a>
    }
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

<div class="card-tile">
    <table class="rs-table">
        <thead>
            <tr><th>الاسم</th><th>الهاتف</th><th>المصدر</th><th>الحالة</th><th>القيمة المتوقعة</th><th>التاريخ</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.FullName</td>
                <td dir="ltr" style="text-align:right;">@l.Phone</td>
                <td>@l.Source</td>
                <td><span class="badge-role">@l.Status.Ar()</span></td>
                <td>@N(l.EstimatedValue)</td>
                <td>@l.CreatedAt.ToString("yyyy/MM/dd")</td>
                <td style="white-space:nowrap;">
                    @if (User.Can(PermissionNames.CustomersEdit))
                    {
                        <a class="btn-sm" asp-action="Edit" asp-route-id="@l.Id">تعديل</a>
                    }
                    @if (User.Can(PermissionNames.CustomersDelete))
                    {
                        <form asp-action="Delete" asp-route-id="@l.Id" method="post" style="display:inline;"
                              data-confirm="حذف «@l.FullName»؟" data-danger>
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-sm btn-danger">حذف</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" style="color:var(--muted)">لا يوجد عملاء محتملون بعد.</td></tr>
        }
        </tbody>
    </table>
</div>
