@model CustomerFormModel
<form id="appModalForm" asp-area="CRM" asp-controller="Customers" asp-action="Form" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="Id" />
    @if (Model.SalesPersons.Count == 0)
    {
        <div class="status-message" style="background:rgba(250,178,25,.12);border-color:var(--warning);color:var(--warning);">
            لا يوجد مناديب بعد. أضف مندوبًا من تبويب المناديب قبل إضافة عميل.
        </div>
    }
    <div class="form-grid">
        <div class="full">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" dir="ltr" />
            <span asp-validation-for="Phone" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" dir="ltr" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="Source" class="form-label"></label>
            <select asp-for="Source" class="form-control" asp-items="RealState.Web.ArabicLabels.CustomerSourceOptions(Model.Source)"></select>
        </div>
        <div>
            <label asp-for="SalesPersonId" class="form-label"></label> <span style="color:var(--critical)">*</span>
            <select asp-for="SalesPersonId" class="form-control" asp-items="Model.SalesPersons">
                <option value="">— اختر المندوب —</option>
            </select>
            <span asp-validation-for="SalesPersonId" class="field-validation-error"></span>
        </div>
        <div class="full">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        </div>
    </div>
    <button type="submit" class="btn-primary" style="margin-top:12px;" disabled="@(Model.SalesPersons.Count == 0)">💾 حفظ</button>
</form>
