@model List<Customer>
@{
    ViewData["Title"] = "العملاء";
    var salesNames = ViewBag.SalesNames as Dictionary<Guid, string> ?? new();
}
<div class="page-head"><h1>العملاء</h1></div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

<div class="card-tile">
    <div class="card-head">
        <h3>العملاء</h3>
        <div style="display:flex;gap:8px;align-items:center;margin-inline-start:auto;">
            <input id="custSearch" class="form-control" style="margin:0;width:260px;" placeholder="🔍 بحث بالاسم أو رقم الهاتف..." />
            @if (User.Can(PermissionNames.CustomersCreate))
            {
                <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'عميل جديد')">➕ عميل جديد</button>
            }
        </div>
    </div>
    <table class="rs-table" id="custTable">
        <thead><tr><th>الاسم</th><th>الهاتف</th><th>البريد الإلكتروني</th><th>المصدر</th><th>المندوب</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr data-search="@(((c.FullName ?? "") + " " + (c.Phone ?? "")).ToLower())">
                <td>@c.FullName</td>
                <td dir="ltr" style="text-align:right;">@c.Phone</td>
                <td dir="ltr" style="text-align:right;">@c.Email</td>
                <td>@c.Source.Ar()</td>
                <td>@(c.SalesPersonId.HasValue && salesNames.TryGetValue(c.SalesPersonId.Value, out var sn) ? sn : "—")</td>
                <td style="white-space:nowrap;">
                    <a class="btn-sm" asp-action="Details" asp-route-id="@c.Id">كشف حساب</a>
                    @if (User.Can(PermissionNames.CustomersEdit))
                    {
                        <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = c.Id })', 'تعديل العميل')">تعديل</button>
                    }
                    @if (User.Can(PermissionNames.CustomersDelete))
                    {
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" style="display:inline;" data-confirm="حذف العميل «@c.FullName»؟" data-danger>
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-sm btn-danger">حذف</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" style="color:var(--muted)">لا يوجد عملاء بعد.</td></tr>
        }
        <tr id="custNoResults" style="display:none;"><td colspan="6" style="color:var(--muted)">لا توجد نتائج مطابقة للبحث.</td></tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        (function () {
            var box = document.getElementById('custSearch');
            if (!box) return;
            box.addEventListener('input', function () {
                var q = this.value.trim().toLowerCase();
                var rows = document.querySelectorAll('#custTable tbody tr[data-search]');
                var shown = 0;
                rows.forEach(function (tr) {
                    var match = tr.dataset.search.indexOf(q) >= 0;
                    tr.style.display = match ? '' : 'none';
                    if (match) shown++;
                });
                document.getElementById('custNoResults').style.display = (rows.length && shown === 0) ? '' : 'none';
            });
        })();
    </script>
}
