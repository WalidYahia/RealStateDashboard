@model CustomerLedgerVm
@using RealState.Web.Areas.Suppliers.Models
@{
    var c = Model.Customer;
    ViewData["Title"] = $"كشف حساب {c.FullName}";
    string N(decimal v) => v.ToString("N0", RealState.Web.AppCulture.Ar);
    string D(DateTime d) => RealState.Web.AppCulture.When(d);   // date + time when it has one
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var canContracts = User.Can(PermissionNames.SalesView);
    var canInvoices = User.Can(PermissionNames.SalesInvoicesView);
    var canReturns = User.Can(PermissionNames.SalesReturnsView);
    var canIncomes = User.Can(PermissionNames.IncomesView);
    var canExpenses = User.Can(PermissionNames.ExpensesView);
    const string LinkStyle = "color:var(--series-1);text-decoration:none;font-weight:600;";
    var detailed = ViewData["Detailed"] as bool? ?? false;
}
<div class="page-head">
    <div>
        <h1>كشف حساب — @c.FullName</h1>
        <p style="color:var(--muted);margin:2px 0 0;"><span dir="ltr">@c.Phone</span> @(string.IsNullOrEmpty(c.Email) ? "" : "· " + c.Email)</p>
        @if (Model.LinkedSupplier is { } ls)
        {
            @* «عميل ومورد»: one statement for both accounts — sales (as a customer) and purchases (as a supplier). *@
            <p style="margin:6px 0 0;"><span class="badge-state state-warn">عميل ومورد</span>
                <span style="color:var(--muted);font-size:13px;">كشف حساب موحّد يشمل حسابه كمورد@(ls.Name != c.FullName ? $" «{ls.Name}»" : "") — الرصيد الموجب مستحق عليه (مدين) والسالب مستحق له (دائن).</span></p>
        }
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        @ContactLinks.Buttons(c.Phone, labeled: true)
        <a class="btn-sm" asp-action="Index" onclick="if (history.length > 1) { history.back(); return false; }">رجوع</a>
        <a class="btn-sm" asp-action="Details" asp-route-id="@c.Id">👤 البيانات</a>
        @if (canInvoices && (ViewData["ShowInvoiceActions"] as bool? ?? false))
        {
            <a class="btn-sm" asp-area="Sales" asp-controller="SalesInvoices" asp-action="Index" asp-route-customerId="@c.Id">فواتير المبيعات</a>
        }
        @* Payments are on the account (سند قبض) — not on a particular invoice. *@
        @if (ViewData["CanCollect"] as bool? ?? false)
        {
            <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("CollectForm", new { id = c.Id })', 'تحصيل دفعة من العميل')">💵 تحصيل دفعة</button>
        }
        @if (Model.LinkedSupplier is { } sup)
        {
            @if (User.Can(PermissionNames.PurchaseInvoicesView))
            {
                <a class="btn-sm" asp-area="Suppliers" asp-controller="PurchaseInvoices" asp-action="Index" asp-route-supplierId="@sup.Id">فواتير المشتريات</a>
            }
            @if (User.Can(PermissionNames.SuppliersPay))
            {
                <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("PayForm", "Suppliers", new { area = "Suppliers", id = sup.Id })', 'سداد دفعة للمورد')">💵 سداد دفعة للمورد</button>
            }
            @if (User.Can(PermissionNames.SuppliersEdit))
            {
                <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", "Suppliers", new { area = "Suppliers", id = sup.Id })', 'تعديل المورد')">✏️ بيانات المورد</button>
            }
        }
    </div>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

@if (Model.IsMerged)
{
    string Side(decimal v, string plus, string minus) => v < 0 ? minus : plus;
    <div class="kpi-grid" style="grid-template-columns: repeat(3, 1fr);">
        <div class="kpi k-reserve"><div class="kpi-label">رصيده كعميل</div><div class="kpi-value">@N(Math.Abs(Model.TotalRemaining)) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@Side(Model.TotalRemaining, "مستحق عليه — مبيعات", "مستحق له — مبيعات") · @Model.DocumentsCount عقد / فاتورة</div></div>
        <div class="kpi k-collect"><div class="kpi-label">رصيده كمورد</div><div class="kpi-value">@N(Math.Abs(Model.SupplierBalance)) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@Side(Model.SupplierBalance, "مستحق له — مشتريات", "مستحق عليه — مشتريات") · @Model.SupplierInvoicesCount فاتورة</div></div>
        <div class="kpi k-alerts"><div class="kpi-label">صافي الرصيد</div><div class="kpi-value">@N(Math.Abs(Model.NetBalance)) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@(Model.NetBalance > 0 ? "مدين — مستحق عليه" : Model.NetBalance < 0 ? "دائن — مستحق له" : "الحساب متوازن")</div></div>
    </div>
}
else
{
<div class="kpi-grid" style="grid-template-columns: repeat(3, 1fr);">
    <div class="kpi k-reserve"><div class="kpi-label">إجمالي المستحقات</div><div class="kpi-value">@N(Model.TotalObligations) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@Model.DocumentsCount عقد / فاتورة</div></div>
    <div class="kpi k-collect"><div class="kpi-label">المحصَّل</div><div class="kpi-value">@N(Model.TotalPaid) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@Model.CollectionsCount تحصيل</div></div>
    <div class="kpi k-alerts"><div class="kpi-label">@(Model.TotalRemaining < 0 ? "رصيد دائن" : "المتبقي")</div><div class="kpi-value">@N(Math.Abs(Model.TotalRemaining)) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@(Model.TotalRemaining < 0 ? "مستحق للعميل (دائن)" : "مستحق على العميل")</div></div>
</div>
}

@{
    var filter = FilterBarVm.For(Url.Action("Statement", new { id = c.Id }))
        .WithTitle("تصفية كشف الحساب")
        .DateRange(F(Model.From), F(Model.To), presets: FilterPresets.Standard().Append(FilterPresets.All()))
        .Print(Url.Action("PrintLedger", new { id = c.Id, from = F(Model.From), to = F(Model.To), detailed = detailed ? "true" : null }), "طباعة كشف الحساب");
}
<partial name="_FilterBar" model="filter" />

<div class="card-tile">
    <label class="stmt-detail-toggle"><input type="checkbox" data-items-all="#custLedger" data-print-key="PrintLedger" checked="@detailed" /> تفصيلي <span>— أصناف كل فاتورة تحت سطرها (وفي الطباعة)</span></label>
    <div class="list-search-bar"><input class="form-control list-search" data-target="#custLedger" placeholder="🔍 بحث في القائمة..." /></div>
    <table class="rs-table" id="custLedger">
        <thead><tr><th>المصدر</th><th>التاريخ</th><th>البيان</th><th>رصيد قبل</th><th>المبلغ</th><th>الرصيد</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            if (r.Kind == CustomerLedgerKind.PeriodOpening)
            {
                @* «الرصيد الافتتاحي للفترة»: the balance carried in from before the period — balance only. *@
                <tr class="period-opening" data-skip-search><td>@r.Source</td><td dir="ltr" style="text-align:right;">@D(r.Date)</td><td>@r.Statement</td><td>—</td><td>—</td><td style="font-weight:800;white-space:nowrap;">@N(r.Balance)</td></tr>
                continue;
            }
            var dec = r.Decreases;
            var hasItems = r.Items.Count > 0;
            if (r.SupplierRow is { } sr)
            {
                @* «عميل ومورد»: a movement on the linked supplier account (purchases side). *@
                <tr data-items="@(hasItems ? "" : null)" data-open="@(hasItems ? (detailed ? "1" : "0") : null)">
                    <td>
                        <span class="badge-state state-warn" style="font-size:11px;">مورد</span>
                        @if (sr.Kind == SupplierLedgerKind.Invoice && User.Can(PermissionNames.PurchaseInvoicesView))
                        {
                            <a asp-area="Suppliers" asp-controller="PurchaseInvoices" asp-action="Details" asp-route-id="@sr.Id" style="@LinkStyle">@r.Source</a>
                        }
                        else if (sr.Kind == SupplierLedgerKind.Order)
                        {
                            <a asp-area="Suppliers" asp-controller="Orders" asp-action="Details" asp-route-id="@sr.Id" style="@LinkStyle">@r.Source</a>
                        }
                        else if (sr.Kind == SupplierLedgerKind.Return && User.Can(PermissionNames.PurchaseReturnsView))
                        {
                            <a asp-area="Suppliers" asp-controller="PurchaseReturns" asp-action="Details" asp-route-id="@sr.Id" style="@LinkStyle">@r.Source</a>
                        }
                        else
                        {
                            @r.Source
                        }
                    </td>
                    <td dir="ltr" style="text-align:right;">@D(r.Date)</td>
                    <td>
                        @r.Statement
                        @if (hasItems)
                        {
                            <button type="button" class="stmt-items-btn" data-items-toggle aria-expanded="@(detailed ? "true" : "false")">الأصناف (@r.Items.Count)</button>
                        }
                        @if (sr.Kind == SupplierLedgerKind.Payment)
                        {
                            <a class="btn-sm" asp-area="Suppliers" asp-controller="Payments" asp-action="Receipt" asp-route-id="@sr.Id" target="_blank" style="margin-inline-start:8px;">🖨 طباعة</a>
                        }
                        else if (sr.Kind is SupplierLedgerKind.AccountPayment or SupplierLedgerKind.AccountReceipt)
                        {
                            <a class="btn-sm" asp-area="Suppliers" asp-controller="Suppliers" asp-action="VoucherReceipt" asp-route-id="@sr.Id" target="_blank" style="margin-inline-start:8px;">🖨 طباعة</a>
                        }
                        else if (sr.Kind == SupplierLedgerKind.Refund && User.Can(PermissionNames.PurchaseReturnsView))
                        {
                            <a class="btn-sm" asp-area="Suppliers" asp-controller="PurchaseReturns" asp-action="RefundVoucher" asp-route-id="@sr.Id" target="_blank" style="margin-inline-start:8px;">🖨 طباعة</a>
                        }
                    </td>
                    <td style="white-space:nowrap;color:var(--muted);">@N(r.BalanceBefore)</td>
                    <td style="color:@(dec ? "var(--good)" : "var(--critical)");white-space:nowrap;">@(dec ? "−" : "+")@N(r.Amount)</td>
                    <td style="font-weight:600;white-space:nowrap;">@N(r.Balance)</td>
                </tr>
                if (hasItems)
                {
                    <partial name="_StatementItemsRow" model="r.Items" />
                }
                continue;
            }
            <tr data-items="@(hasItems ? "" : null)" data-open="@(hasItems ? (detailed ? "1" : "0") : null)">
                <td>
                    @if (r.Kind is CustomerLedgerKind.Contract or CustomerLedgerKind.ContractCancel or CustomerLedgerKind.CancelFee && canContracts)
                    {
                        <a asp-area="Sales" asp-controller="Sales" asp-action="Details" asp-route-id="@r.Id" style="@LinkStyle">@r.Source</a>
                    }
                    else if (r.Kind == CustomerLedgerKind.Invoice && canInvoices)
                    {
                        <a asp-area="Sales" asp-controller="SalesInvoices" asp-action="Details" asp-route-id="@r.Id" style="@LinkStyle">@r.Source</a>
                    }
                    else if (r.Kind == CustomerLedgerKind.Return && canReturns)
                    {
                        <a asp-area="Sales" asp-controller="SalesReturns" asp-action="Details" asp-route-id="@r.Id" style="@LinkStyle">@r.Source</a>
                    }
                    else
                    {
                        @r.Source
                    }
                </td>
                <td dir="ltr" style="text-align:right;">@D(r.Date)</td>
                <td>
                    @r.Statement
                    @if (hasItems)
                    {
                        <button type="button" class="stmt-items-btn" data-items-toggle aria-expanded="@(detailed ? "true" : "false")">الأصناف (@r.Items.Count)</button>
                    }
                    @if (r.Kind is CustomerLedgerKind.AccountReceipt or CustomerLedgerKind.AccountPayment)
                    {
                        <a class="btn-sm" asp-action="VoucherReceipt" asp-route-id="@r.VoucherId" target="_blank" style="margin-inline-start:8px;">🖨 طباعة</a>
                    }
                    else if (r.VoucherId is Guid v && (r.VoucherIsExpense ? canExpenses : canIncomes))
                    {
                        <a class="btn-sm" asp-area="Accounting" asp-controller="@(r.VoucherIsExpense ? "Expenses" : "Incomes")" asp-action="PrintOne" asp-route-id="@v" target="_blank" style="margin-inline-start:8px;">🖨 طباعة</a>
                    }
                </td>
                <td style="white-space:nowrap;color:var(--muted);">@N(r.BalanceBefore)</td>
                <td style="color:@(dec ? "var(--good)" : "var(--critical)");white-space:nowrap;">@(dec ? "−" : "+")@N(r.Amount)</td>
                <td style="font-weight:600;white-space:nowrap;">@N(r.Balance)</td>
            </tr>
            if (hasItems)
            {
                <partial name="_StatementItemsRow" model="r.Items" />
            }
        }
        @if (!Model.HasEntries)
        {
            <tr data-skip-search><td colspan="6" style="color:var(--muted)">لا توجد حركات في هذه الفترة.</td></tr>
        }
        <tr data-no-results data-skip-search style="display:none;"><td colspan="6" style="color:var(--muted)">لا توجد نتائج مطابقة.</td></tr>
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5" style="text-align:start;font-weight:700;">الرصيد الختامي للفترة</td>
                <td style="font-weight:800;white-space:nowrap;">@N(Math.Abs(Model.ClosingBalance)) ج.م @(Model.ClosingBalance < 0 ? "(دائن)" : Model.ClosingBalance > 0 ? "(مدين)" : "")</td>
            </tr>
        </tfoot>
    </table>
</div>

@section Scripts {
    <script src="~/js/statement-items.js" asp-append-version="true"></script>
}
