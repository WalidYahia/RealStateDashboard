@model List<CustomerLog>
@{
    Layout = null;
    var tenantId = (Guid)ViewBag.TenantId;
    var cust = ViewBag.Customer as Customer;
    var salesName = ViewBag.SalesName as string;
    var sourceLabel = ViewBag.SourceLabel as string;
    string DT(DateTime d) => d.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>سجل التواصل — @cust?.FullName</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, sans-serif; padding: 24px; color: #111; }
        .brand { text-align: center; margin-bottom: 6px; } .brand img { max-height: 60px; }
        h1 { font-size: 19px; text-align: center; margin: 4px 0; }
        .sub { text-align: center; color: #666; font-size: 12px; margin-bottom: 14px; }
        .meta { font-size: 12px; margin: 10px 0 14px; }
        .meta span { margin-inline-end: 18px; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th, td { border: 1px solid #ccc; padding: 5px 7px; text-align: start; unicode-bidi: plaintext; }
        th { background: #f2f2f2; }
        .no-print { margin-bottom: 12px; } @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="no-print"><button onclick="window.print()">🖨 طباعة / حفظ PDF</button></div>
    <div class="brand"><img src="@Url.Action("Logo", "Branding", new { area = "", id = tenantId })" alt="logo" onerror="this.style.display='none'" /></div>
    <h1>سجل التواصل</h1>
    <div class="sub">@cust?.FullName · طُبع @DateTime.Now.ToString("yyyy/MM/dd HH:mm")</div>

    <div class="meta">
        <span>الاسم: <strong>@cust?.FullName</strong></span>
        <span>الهاتف: <strong dir="ltr">@cust?.Phone</strong></span>
        <span>المصدر: <strong>@sourceLabel</strong></span>
        <span>المندوب: <strong>@(salesName ?? "—")</strong></span>
    </div>

    <table>
        <thead><tr><th style="width:100px;">التاريخ</th><th style="width:100px;">النوع</th><th>الوصف</th><th style="width:150px;">بواسطة</th></tr></thead>
        <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@DT(log.Date)</td>
                <td>@log.Kind.Ar()</td>
                <td>@log.Description</td>
                <td>@log.ByName</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="4">لا توجد سجلات تواصل.</td></tr> }
        </tbody>
    </table>

    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
</body>
</html>
