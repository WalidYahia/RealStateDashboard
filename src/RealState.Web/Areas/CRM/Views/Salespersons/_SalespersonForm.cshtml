@model SalespersonFormModel
<form id="appModalForm" asp-area="CRM" asp-controller="Salespersons" asp-action="Form" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="Id" />
    <div class="form-grid">
        <div class="full">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" dir="ltr" />
            <span asp-validation-for="Phone" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" dir="ltr" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
    </div>
    <button type="submit" class="btn-primary" style="margin-top:12px;">💾 حفظ</button>
</form>
