@model List<Employee>
@{
    ViewData["Title"] = "المناديب";
}
<div class="page-head"><h1>المناديب</h1></div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

<div class="card-tile">
    <div class="card-head">
        <h3>المناديب</h3>
        @if (User.Can(PermissionNames.SalespersonsCreate))
        {
            <button type="button" class="btn-new-tenant" onclick="appOpenModal('@Url.Action("Form")', 'مندوب جديد')">➕ مندوب جديد</button>
        }
    </div>
    <table class="rs-table">
        <thead><tr><th>الاسم</th><th>الهاتف</th><th>البريد الإلكتروني</th><th></th></tr></thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.FullName</td>
                <td dir="ltr" style="text-align:right;">@e.Phone</td>
                <td dir="ltr" style="text-align:right;">@e.Email</td>
                <td style="white-space:nowrap;">
                    @if (User.Can(PermissionNames.SalespersonsEdit))
                    {
                        <button type="button" class="btn-sm" onclick="appOpenModal('@Url.Action("Form", new { id = e.Id })', 'تعديل المندوب')">تعديل</button>
                    }
                    @if (User.Can(PermissionNames.SalespersonsDelete))
                    {
                        <form asp-action="Delete" asp-route-id="@e.Id" method="post" style="display:inline;" data-confirm="حذف المندوب «@e.FullName»؟" data-danger>
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-sm btn-danger">حذف</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="4" style="color:var(--muted)">لا يوجد مناديب بعد.</td></tr>
        }
        </tbody>
    </table>
</div>
