@model List<Employee>
@{
    ViewData["Title"] = "المناديب";
    var deptNames = ViewBag.DeptNames as Dictionary<Guid, string> ?? new();
    var roleNames = ViewBag.RoleNames as Dictionary<Guid, string> ?? new();
}
<div class="page-head"><h1>المناديب</h1></div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="status-message">@status</div>
}

<div class="card-tile">
    <div class="card-head">
        <h3>المناديب</h3>
        <span class="pill">المندوبون فقط (الوظائف المميّزة كـ «مندوب مبيعات»)</span>
    </div>
    <table class="rs-table">
        <thead><tr><th>الاسم</th><th>الهاتف</th><th>البريد الإلكتروني</th><th>القسم</th><th>الوظيفة</th><th></th></tr></thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.FullName</td>
                <td dir="ltr" style="text-align:right;">@e.Phone</td>
                <td dir="ltr" style="text-align:right;">@e.Email</td>
                <td>@(e.DepartmentId.HasValue && deptNames.TryGetValue(e.DepartmentId.Value, out var dn) ? dn : "—")</td>
                <td>@(e.JobRoleId.HasValue && roleNames.TryGetValue(e.JobRoleId.Value, out var rn) ? rn : "—")</td>
                <td style="white-space:nowrap;">
                    <button type="button" class="btn-sm" onclick="appToast('كشف حساب المندوب — قيد التطوير', 'info')">كشف حساب</button>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" style="color:var(--muted)">لا يوجد مناديب. أضف موظفًا بوظيفة مميّزة كـ «مندوب مبيعات» من الموارد البشرية.</td></tr>
        }
        </tbody>
    </table>
</div>
