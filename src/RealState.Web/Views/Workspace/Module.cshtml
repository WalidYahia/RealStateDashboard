@model WorkspaceModuleVm
@*
    Module workspace: the module's authorized pages as cards (with small KPIs from IWorkspaceKpiService) and its primary
    create actions — each present only with its permission. Rendered from the navigation model.
*@
@{
    var m = Model.Module;
    ViewData["Title"] = m.Title;
}
<div class="ws-hero">
    <div class="ws-mod-head">
        <span class="ws-card-icon ws-module-icon ws-hero-icon">@NavIcons.Svg(m.Icon, 26)</span>
        <div class="ws-hero-text">
            <h1 class="ws-title">@m.Title</h1>
            <p class="ws-sub">@m.Description</p>
        </div>
    </div>
    @if (m.Actions.Count > 0)
    {
        <div class="ws-actions">
            @foreach (var a in m.Actions)
            {
                <a class="ws-action ws-action-primary" href="@a.Url"><span class="ws-action-ico">@NavIcons.Svg("plus", 15)</span>@a.Title</a>
            }
        </div>
    }
</div>

@if (m.Groups.Count > 0)
{
    @* Group cards (المالية / المحاسبة / العُهد …): each opens its own page of cards. *@
    <h2 class="ws-h2">الأقسام <span class="ws-count">@m.Groups.Count</span></h2>
    <div class="ws-grid ws-pages">
        @foreach (var g in m.Groups)
        {
            <partial name="_GroupCard" model="g" />
        }
    </div>
}
@if (m.LoosePages.Count > 0)
{
    <h2 class="ws-h2" style="@(m.Groups.Count > 0 ? "margin-top:22px;" : "")">الصفحات <span class="ws-count">@m.LoosePages.Count(p => !p.Soon)</span></h2>
    <div class="ws-grid ws-pages">
        @foreach (var p in m.LoosePages)
        {
            <partial name="_PageCard" model="(p, Model.Kpis.GetValueOrDefault(p.Key), Model.FavoriteKeys.Contains(p.Key))" />
        }
    </div>
}
