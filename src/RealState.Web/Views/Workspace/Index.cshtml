@model WorkspaceHomeVm
@*
    Home workspace: what THIS user can work with — authorized module cards, their favorites and recent pages (quick
    actions live in the top bar's «＋ إجراء جديد»). Rendered from the navigation model (no per-card permission checks here).
    The operational overview stays on the dashboard (لوحة التحكم).
*@
@{
    ViewData["Title"] = "مساحة العمل";
    var name = User.FindFirst("full_name")?.Value ?? User.Identity?.Name;
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "صباح الخير" : "مساء الخير";
}
<div class="ws-hero">
    <div class="ws-hero-text">
        <h1 class="ws-title">@greeting، @name</h1>
        <p class="ws-sub"><span class="ws-hero-date">@NavIcons.Svg("calendar", 14) @DateTime.Now.ToString("dddd d MMMM yyyy", RealState.Web.AppCulture.Ar)</span> · الوحدات والإجراءات المتاحة لك حسب صلاحياتك</p>
    </div>
    <button type="button" class="ws-search" data-open-palette>
        @NavIcons.Svg("search", 18)
        <span>ابحث في النظام عن صفحة أو عميل أو صنف أو فاتورة…</span>
        <kbd>Ctrl K</kbd>
    </button>
</div>

<section class="ws-section" aria-labelledby="wsModules">
    <h2 class="ws-h2" id="wsModules">الوحدات <span class="ws-count">@Model.Nav.Modules.Count</span></h2>
    <div class="ws-grid ws-modules">
        @foreach (var m in Model.Nav.Modules)
        {
            <a class="ws-module" href="@m.Url">
                <span class="ws-module-top">
                    <span class="ws-card-icon ws-module-icon">@NavIcons.Svg(m.Icon, 24)</span>
                    <span class="ws-go" aria-hidden="true">@NavIcons.Svg("chevron", 16)</span>
                </span>
                <span class="ws-card-title">@m.Title</span>
                <span class="ws-card-desc">@m.Description</span>
                <span class="ws-meta">
                    <span class="ws-pill">@m.Pages.Count صفحة</span>
                    @if (m.Actions.Count > 0) { <span class="ws-pill">@m.Actions.Count إجراء</span> }
                </span>
            </a>
        }
    </div>
    @if (Model.Nav.Modules.Count == 0)
    {
        <div class="card-tile" style="color:var(--muted)">لا توجد وحدات متاحة لحسابك بعد — تواصل مع مسؤول النظام لمنحك الصلاحيات.</div>
    }
</section>

<div class="ws-cols">
    <section class="ws-panel" aria-labelledby="wsFav">
        <div class="ws-panel-head">
            <span class="ws-panel-ico">@NavIcons.Svg("star", 16)</span>
            <h3 id="wsFav">المفضلة</h3>
            @if (Model.Favorites.Count > 0) { <span class="ws-count">@Model.Favorites.Count</span> }
        </div>
        @if (Model.Favorites.Count == 0)
        {
            <p class="ws-empty">لا توجد صفحات مفضلة بعد. اضغط النجمة على أي صفحة داخل الوحدات لإضافتها هنا.</p>
        }
        else
        {
            <ul class="ws-list">
                @foreach (var f in Model.Favorites)
                {
                    <li><a href="@f.Url"><span class="ws-list-ico">@NavIcons.Svg(f.Icon, 16)</span><span>@f.Title</span><small>@f.ModuleTitle</small></a></li>
                }
            </ul>
        }
    </section>
    <section class="ws-panel" aria-labelledby="wsRecent">
        <div class="ws-panel-head">
            <span class="ws-panel-ico">@NavIcons.Svg("history", 16)</span>
            <h3 id="wsRecent">آخر ما استخدمته</h3>
        </div>
        @if (Model.Recent.Count == 0)
        {
            <p class="ws-empty">ستظهر هنا الصفحات والسجلات التي تفتحها.</p>
        }
        else
        {
            <ul class="ws-list">
                @foreach (var r in Model.Recent)
                {
                    <li><a href="@r.Url"><span class="ws-list-ico">@NavIcons.Svg(r.Icon, 16)</span><span>@r.Title</span>@if (r.Module is not null) { <small>@r.Module</small> }</a></li>
                }
            </ul>
        }
    </section>
</div>

