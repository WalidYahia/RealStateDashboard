@model DashboardVm
@{
    ViewData["Title"] = "لوحة القيادة التنفيذية";
    string N(decimal v) => v.ToString("N0", new System.Globalization.CultureInfo("ar-EG"));
    string C(decimal v) => v >= 1_000_000 ? (v / 1_000_000m).ToString("0.#") + "M"
        : v >= 1000 ? (v / 1000m).ToString("0.#") + "K" : v.ToString("N0");
}

<!-- KPI cards -->
<div class="kpi-grid" style="grid-template-columns: repeat(5, 1fr);">
    <div class="kpi k-tasks"><div class="kpi-label">المشاريع</div><div class="kpi-value">@Model.ProjectsCount</div><div class="kpi-foot">وحدات: مباع @Model.UnitsSold / @Model.UnitsTotal</div></div>
    <div class="kpi k-sales"><div class="kpi-label">مبيعات الشهر</div><div class="kpi-value">@C(Model.MonthSales) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@Model.ContractsCount عقد إجمالًا</div></div>
    <div class="kpi k-alerts"><div class="kpi-label">مديونيات العملاء</div><div class="kpi-value">@C(Model.TotalOutstanding) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">متأخرات @C(Model.OverdueAmount)</div></div>
    <div class="kpi k-reserve"><div class="kpi-label">مستحقات الموردين</div><div class="kpi-value">@C(Model.SupplierPayables) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">أوامر توريد غير مسدَّدة</div></div>
    <div class="kpi k-collect"><div class="kpi-label">إجمالي التحصيل</div><div class="kpi-value">@C(Model.TotalCollected) <span class="kpi-unit">ج.م</span></div><div class="kpi-foot">@Model.CollectionPercent% من التعاقدات</div></div>
</div>

<!-- collections + projects -->
<div class="grid-row" style="grid-template-columns: 1fr 1.4fr;">
    <div class="card-tile">
        <div class="card-head"><h3>التحصيلات</h3><span class="pill">حتى الآن</span></div>
        <div class="donut-wrap">
            <canvas id="collDonut"></canvas>
            <div class="donut-center"><div class="big">@Model.CollectionPercent%</div><div class="sub">محصّل</div></div>
        </div>
        <ul class="legend-list">
            <li><span class="dot" style="background:var(--aqua)"></span> المحصّل <span class="val">@N(Model.TotalCollected)</span></li>
            <li><span class="dot" style="background:var(--baseline)"></span> المتبقي <span class="val">@N(Model.TotalOutstanding)</span></li>
            <li><span class="dot" style="background:transparent"></span> المحصّل هذا الشهر <span class="val">@N(Model.CollectedThisMonth)</span></li>
        </ul>
    </div>

    <div class="card-tile">
        <div class="card-head"><h3>المشاريع — نسبة البيع</h3><span class="pill">الوحدات</span></div>
        @foreach (var p in Model.Projects)
        {
            <div class="progress-item">
                <div class="pi-head"><span>@p.Name</span><span class="pct">@p.Percent.ToString("0")% (@p.Sold/@p.UnitsTotal)</span></div>
                <div class="bar"><span style="width:@p.Percent.ToString("0")%"></span></div>
            </div>
        }
        @if (Model.Projects.Count == 0)
        {
            <p style="color:var(--muted)">لا توجد مشاريع بعد.</p>
        }
    </div>
</div>

<!-- recent sales -->
<div class="card-tile">
    <div class="card-head"><h3>أحدث عقود البيع</h3><a class="btn-sm" asp-area="Sales" asp-controller="Sales" asp-action="Index">عرض الكل</a></div>
    <table class="rs-table">
        <thead><tr><th>الكود</th><th>العميل</th><th>الوحدة</th><th>القيمة</th><th>التاريخ</th></tr></thead>
        <tbody>
        @foreach (var s in Model.RecentSales)
        {
            <tr>
                <td dir="ltr" style="text-align:right;">@s.Code</td>
                <td>@s.Customer</td>
                <td>@s.Unit</td>
                <td>@N(s.Total)</td>
                <td dir="ltr" style="text-align:right;">@s.Date.ToString("yyyy/MM/dd")</td>
            </tr>
        }
        @if (Model.RecentSales.Count == 0)
        {
            <tr><td colspan="5" style="color:var(--muted)">لا توجد عقود بيع بعد.</td></tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        Chart.defaults.color = '#c3c2b7';
        Chart.defaults.font.family = 'system-ui, "Segoe UI", Tahoma, sans-serif';
        new Chart(document.getElementById('collDonut'), {
            type: 'doughnut',
            data: { datasets: [{ data: [@Model.TotalCollected, @Model.TotalOutstanding], backgroundColor: ['#199e70', '#383835'], borderColor: '#1a1a19', borderWidth: 2 }] },
            options: { maintainAspectRatio: false, cutout: '72%', plugins: { legend: { display: false } } }
        });
    </script>
}
