@using System.Security.Claims
@using RealState.Application.Common
@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    bool Can(string permission) => User?.HasClaim("permission", permission) ?? false;
    // Pass `area` when a controller name exists in more than one area (e.g. Settings lives both at the
    // root and inside Inventory) — otherwise both links would highlight at once.
    string NavActive(string controller, string? area = null) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase)
        && (area is null || string.Equals(ViewContext.RouteData.Values["area"]?.ToString() ?? "", area, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Apply the saved theme (dark = default) before first paint so pages never flash the wrong one. *@
    <script>(function () { var t = 'dark'; try { t = localStorage.getItem('appTheme') === 'light' ? 'light' : 'dark'; } catch (e) { } document.documentElement.setAttribute('data-theme', t); })();</script>
    @* Same for the side menu (wwwroot/js/sidebar.js). Navigation is the workspace (top bar + module workspaces); the
       old full side menu is hidden — switched off by NavigationCatalog.LegacySidebar (kept implemented). *@
    <script>(function () { var r = document.documentElement, legacy = false; try { legacy = @(NavigationCatalog.LegacySidebar ? Html.Raw("localStorage.getItem('appLegacyNav') === '1'") : Html.Raw("false")); if (localStorage.getItem('appSidebar') === 'collapsed') r.classList.add('sb-collapsed'); } catch (e) { } if (!legacy) r.classList.add('sb-hidden'); })();</script>
    <title>@ViewData["Title"] — لوحة القيادة التنفيذية</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="@(isAuth ? "app-shell" : "auth-shell")" data-visit-title="@ViewData["Title"]">
    @* System-wide preloader — driven by wwwroot/js/loader.js (every submit / save / delete). *@
    <div id="appLoader" class="app-loader" role="status" aria-live="polite" aria-hidden="true">
        <div class="app-loader-box">
            <div class="app-loader-spinner"></div>
            <div id="appLoaderText" class="app-loader-text">جارٍ التنفيذ…</div>
        </div>
    </div>
    @if (isAuth)
    {
        <aside class="sidebar">
            <div class="sb-head">
                @await Component.InvokeAsync("Brand")
            </div>
            @* Sits on the sidebar's inner edge (position: fixed), so the logo keeps the full header width. *@
            <button type="button" class="sb-collapse" onclick="appToggleSidebar()" title="طي / فتح القائمة الجانبية" aria-label="طي / فتح القائمة الجانبية" aria-expanded="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>
            </button>
            <nav class="side-nav">
                @if (Can(PermissionNames.DashboardView))
                {
                    <a class="nav-link @NavActive("Dashboard")" asp-area="" asp-controller="Dashboard" asp-action="Index"><span>🏠</span> الرئيسية</a>
                }
                @{
                    var curCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                    var curAction = ViewContext.RouteData.Values["action"]?.ToString();
                    var curArea = ViewContext.RouteData.Values["area"]?.ToString();
                    var projOpen = curCtrl == "Projects";
                    // "Settings" must be the ROOT one — the Inventory area has its own Settings controller
                    // and would otherwise open/highlight this group too.
                    var setOpen = curCtrl == "Account" || curCtrl == "StageDefinitions" || curCtrl == "ProjectTypes"
                        || (curCtrl == "Settings" && string.IsNullOrEmpty(curArea))
                        || curCtrl == "TxnCategories" || curCtrl == "ActivityLog";
                    var canSalespersons = Can(PermissionNames.SalespersonsView);
                    var canCustomers = Can(PermissionNames.CustomersView);
                    var canLeadsAccess = canCustomers || Can(PermissionNames.LeadsControl) || Can(PermissionNames.LeadsConvert);
                    var canSalesContracts = Can(PermissionNames.SalesView);
                    var canCollections = Can(PermissionNames.CollectionsView);
                    var canCampaigns = Can(PermissionNames.CampaignsView);
                    var canSalesInvoices = Can(PermissionNames.SalesInvoicesView);
                    var canReports = Can(PermissionNames.ReportsView);
                    var repAct = curArea == "Reports" && curCtrl == "Reports" ? curAction : null;
                    // «التعاقدات» — real-estate contracts + their collections. Parent points to the contracts summary.
                    var contractsOpen = curCtrl is "Sales" or "Collections";
                    var salesSummaryActive = curCtrl == "Sales" && (curAction == "Summary" || curAction == "SummaryPrint");
                    var salesContractsActive = curCtrl == "Sales" && !salesSummaryActive;
                    // «العملاء» — salespersons, customers and the customers report.
                    var customersOpen = curCtrl is "Salespersons" or "Customers" || repAct == "Customers";
                    // «المبيعات» — product sales invoices (+ returns, planned). Parent points to the sales-invoices summary.
                    var invSalesOpen = curCtrl is "SalesInvoices" or "SalesReturns";
                    var invSummaryActive = invSalesOpen && (curAction == "Summary" || curAction == "SummaryPrint");
                    var invReturnsActive = curCtrl == "SalesReturns";
                    // Marketing group hosts Campaigns (الحملات) and "إدارة علاقات العملاء" (the Leads page).
                    var mktOpen = curArea == "Marketing" || curCtrl == "Leads";
                }
                @if (canCampaigns || canLeadsAccess)
                {
                    <div class="nav-group @(mktOpen ? "open" : "")">
                        <div class="nav-parent">
                            <a class="nav-link @(mktOpen ? "active" : "")" href="javascript:" onclick="toggleNavGroup(this)"><span>📣</span> التسويق</a>
                            <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                        </div>
                        <div class="subnav">
                            @if (canCampaigns)
                            {
                                <a class="subnav-link @(curArea == "Marketing" && curCtrl == "Campaigns" ? "active" : "")" asp-area="Marketing" asp-controller="Campaigns" asp-action="Index">الحملات</a>
                            }
                            @if (canLeadsAccess)
                            {
                                <a class="subnav-link @(curCtrl == "Leads" ? "active" : "")" asp-area="CRM" asp-controller="Leads" asp-action="Index">إدارة علاقات العملاء</a>
                            }
                        </div>
                    </div>
                }
                @if (canSalesContracts || canCollections)
                {
                    <div class="nav-group @(contractsOpen ? "open" : "")">
                        <div class="nav-parent">
                            @if (canSalesContracts)
                            {
                                <a class="nav-link @(salesSummaryActive ? "active" : "")" asp-area="Sales" asp-controller="Sales" asp-action="Summary"><span>📝</span> التعاقدات</a>
                            }
                            else
                            {
                                <a class="nav-link" href="javascript:" onclick="toggleNavGroup(this)"><span>📝</span> التعاقدات</a>
                            }
                            <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                        </div>
                        <div class="subnav">
                            @if (canSalesContracts)
                            {
                                <a class="subnav-link @(salesContractsActive ? "active" : "")" asp-area="Sales" asp-controller="Sales" asp-action="Index">العقود</a>
                            }
                            @if (canCollections)
                            {
                                <a class="subnav-link @NavActive("Collections")" asp-area="Sales" asp-controller="Collections" asp-action="Index">التحصيلات</a>
                            }
                        </div>
                    </div>
                }
                @if (canSalespersons || canCustomers || canReports)
                {
                    <div class="nav-group @(customersOpen ? "open" : "")">
                        <div class="nav-parent">
                            <a class="nav-link @(customersOpen ? "active" : "")" href="javascript:" onclick="toggleNavGroup(this)"><span>👥</span> العملاء</a>
                            <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                        </div>
                        <div class="subnav">
                            @if (canSalespersons)
                            {
                                <a class="subnav-link @NavActive("Salespersons")" asp-area="CRM" asp-controller="Salespersons" asp-action="Index">المناديب</a>
                            }
                            @if (canCustomers)
                            {
                                <a class="subnav-link @NavActive("Customers")" asp-area="CRM" asp-controller="Customers" asp-action="Index">العملاء</a>
                            }
                            @if (canReports)
                            {
                                <a class="subnav-link @(repAct == "Customers" ? "active" : "")" asp-area="Reports" asp-controller="Reports" asp-action="Customers">تقرير العملاء</a>
                            }
                        </div>
                    </div>
                }
                @if (canSalesInvoices)
                {
                    <div class="nav-group @(invSalesOpen ? "open" : "")">
                        <div class="nav-parent">
                            <a class="nav-link @(invSummaryActive ? "active" : "")" asp-area="Sales" asp-controller="SalesInvoices" asp-action="Summary"><span>🛒</span> المبيعات</a>
                            <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                        </div>
                        <div class="subnav">
                            <a class="subnav-link @(invSalesOpen && !invSummaryActive && !invReturnsActive ? "active" : "")" asp-area="Sales" asp-controller="SalesInvoices" asp-action="Index">فواتير المبيعات</a>
                            <a class="subnav-link @(invReturnsActive ? "active" : "")" asp-area="Sales" asp-controller="SalesReturns" asp-action="Index">مرتجعات المبيعات</a>
                        </div>
                    </div>
                }
                @if (Can(PermissionNames.ProjectsView))
                {
                    <a class="nav-link @NavActive("Projects")" asp-area="Projects" asp-controller="Projects" asp-action="Index"><span>🏗️</span> المشاريع</a>
                }
                @{
                    var supArea = ViewContext.RouteData.Values["area"]?.ToString();
                    var supCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                    var canSuppliers = Can(PermissionNames.SuppliersView);
                    var canPurchaseInvoices = Can(PermissionNames.PurchaseInvoicesView);
                    // «الموردين» — the suppliers list/statements + the suppliers report.
                    var suppliersOpen = (supArea == "Suppliers" && supCtrl == "Suppliers") || repAct == "Suppliers";
                    // «المشتريات» — purchase orders, invoices (+ returns, planned).
                    var supOpen = supArea == "Suppliers" && supCtrl != "Suppliers";
                    var purReturnsActive = supOpen && supCtrl == "PurchaseReturns";
                }
                @if (canSuppliers || canReports)
                {
                    <div class="nav-group @(suppliersOpen ? "open" : "")">
                        <div class="nav-parent">
                            <a class="nav-link @(suppliersOpen ? "active" : "")" href="javascript:" onclick="toggleNavGroup(this)"><span>🏭</span> الموردين</a>
                            <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                        </div>
                        <div class="subnav">
                            @if (canSuppliers)
                            {
                                <a class="subnav-link @(supArea == "Suppliers" && supCtrl == "Suppliers" ? "active" : "")" asp-area="Suppliers" asp-controller="Suppliers" asp-action="Index">الموردين</a>
                            }
                            @if (canReports)
                            {
                                <a class="subnav-link @(repAct == "Suppliers" ? "active" : "")" asp-area="Reports" asp-controller="Reports" asp-action="Suppliers">تقرير الموردين</a>
                            }
                        </div>
                    </div>
                }
                @if (canSuppliers || canPurchaseInvoices)
                {
                    <div class="nav-group @(supOpen ? "open" : "")">
                        <div class="nav-parent">
                            <a class="nav-link @(supOpen ? "active" : "")" href="javascript:" onclick="toggleNavGroup(this)"><span>🚚</span> المشتريات</a>
                            <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                        </div>
                        <div class="subnav">
                            @if (canSuppliers)
                            {
                                <a class="subnav-link @(supOpen && supCtrl == "Orders" ? "active" : "")" asp-area="Suppliers" asp-controller="Orders" asp-action="Index">أوامر التوريد</a>
                            }
                            @if (canPurchaseInvoices)
                            {
                                <a class="subnav-link @(supOpen && supCtrl == "PurchaseInvoices" && !purReturnsActive ? "active" : "")" asp-area="Suppliers" asp-controller="PurchaseInvoices" asp-action="Index">فواتير المشتريات</a>
                                <a class="subnav-link @(purReturnsActive ? "active" : "")" asp-area="Suppliers" asp-controller="PurchaseReturns" asp-action="Index">مرتجعات المشتريات</a>
                            }
                        </div>
                    </div>
                }
                @{
                    var conArea = ViewContext.RouteData.Values["area"]?.ToString();
                    var conCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                    var conOpen = conArea == "Contracting";
                    var canContractors = Can(PermissionNames.ContractingView);
                    var canWorkOrders = Can(PermissionNames.ContractingView);
                }
                @if (canContractors || canWorkOrders)
                {
                    <div class="nav-group @(conOpen ? "open" : "")">
                        <div class="nav-parent">
                            <a class="nav-link @(conOpen ? "active" : "")" href="javascript:" onclick="toggleNavGroup(this)"><span>👷</span> المقاولات</a>
                            <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                        </div>
                        <div class="subnav">
                            @if (canContractors)
                            {
                                <a class="subnav-link @(conOpen && conCtrl == "Contractors" ? "active" : "")" asp-area="Contracting" asp-controller="Contractors" asp-action="Index">المقاولون</a>
                            }
                            @if (canWorkOrders)
                            {
                                <a class="subnav-link @(conOpen && conCtrl == "WorkOrders" ? "active" : "")" asp-area="Contracting" asp-controller="WorkOrders" asp-action="Index">أوامر الشغل</a>
                            }
                        </div>
                    </div>
                }
                @{
                    var accCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                    var accOpen = accCtrl is "Safes" or "SafeTransfers" or "Expenses" or "Incomes";
                    var canSafes = Can(PermissionNames.SafesView);
                    var canExpenses = Can(PermissionNames.ExpensesView);
                    var canIncomes = Can(PermissionNames.IncomesView);
                    var canAccounts = Can(PermissionNames.AccountsView);
                }
                @if (canSafes || canExpenses || canIncomes)
                {
                    <div class="nav-group @(accOpen ? "open" : "")">
                        <div class="nav-parent">
                            <a class="nav-link @(accOpen ? "active" : "")" href="javascript:" onclick="toggleNavGroup(this)"><span>📒</span> المالية</a>
                            <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                        </div>
                        <div class="subnav">
                            @if (canSafes)
                            {
                                <a class="subnav-link @NavActive("Safes")" asp-area="Accounting" asp-controller="Safes" asp-action="Index">الخزائن</a>
                                <a class="subnav-link @NavActive("SafeTransfers")" asp-area="Accounting" asp-controller="SafeTransfers" asp-action="Index">التحويلات بين الخزائن</a>
                            }
                            @if (canExpenses)
                            {
                                <a class="subnav-link @NavActive("Expenses")" asp-area="Accounting" asp-controller="Expenses" asp-action="Index">المصروفات</a>
                            }
                            @if (canIncomes)
                            {
                                <a class="subnav-link @NavActive("Incomes")" asp-area="Accounting" asp-controller="Incomes" asp-action="Index">الإيرادات</a>
                            }
                        </div>
                    </div>
                }
                @if (canAccounts)
                {
                    var glOpen = accCtrl is "ChartOfAccounts" or "GeneralLedger" or "AccountingReports";
                    var accAct = ViewContext.RouteData.Values["action"]?.ToString();
                    string ReportActive(string action) =>
                        accCtrl == "AccountingReports" && (accAct ?? "").StartsWith(action, StringComparison.OrdinalIgnoreCase) ? "active" : "";
                    <div class="nav-group @(glOpen ? "open" : "")">
                        <div class="nav-parent">
                            <a class="nav-link @(glOpen ? "active" : "")" href="javascript:" onclick="toggleNavGroup(this)"><span>📚</span> الحسابات العامة</a>
                            <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                        </div>
                        <div class="subnav">
                            <a class="subnav-link @NavActive("ChartOfAccounts")" asp-area="Accounting" asp-controller="ChartOfAccounts" asp-action="Index">دليل الحسابات</a>
                            <a class="subnav-link @NavActive("GeneralLedger")" asp-area="Accounting" asp-controller="GeneralLedger" asp-action="Index">دفتر الأستاذ</a>
                            <a class="subnav-link @ReportActive("IncomeStatement")" asp-area="Accounting" asp-controller="AccountingReports" asp-action="IncomeStatement">قائمة الدخل</a>
                            <a class="subnav-link @ReportActive("TrialBalance")" asp-area="Accounting" asp-controller="AccountingReports" asp-action="TrialBalance">ميزان المراجعة</a>
                        </div>
                    </div>
                }
                @if (Can(PermissionNames.InventoryView))
                {
                    var invOpen = ViewContext.RouteData.Values["area"]?.ToString() == "Inventory";
                    var canInvManage = Can(PermissionNames.InventoryManage);
                    <div class="nav-group @(invOpen ? "open" : "")">
                        <div class="nav-parent">
                            <a class="nav-link @(invOpen ? "active" : "")" href="javascript:" onclick="toggleNavGroup(this)"><span>📦</span> المخزون</a>
                            <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                        </div>
                        <div class="subnav">
                            <a class="subnav-link @NavActive("Dashboard", "Inventory")" asp-area="Inventory" asp-controller="Dashboard" asp-action="Index">لوحة المخزون</a>
                            <a class="subnav-link @NavActive("Products")" asp-area="Inventory" asp-controller="Products" asp-action="Index">الأصناف</a>
                            <a class="subnav-link @NavActive("Warehouses")" asp-area="Inventory" asp-controller="Warehouses" asp-action="Index">المخازن</a>
                            <a class="subnav-link @NavActive("GoodsReceipts")" asp-area="Inventory" asp-controller="GoodsReceipts" asp-action="Index">أذون الاستلام</a>
                            <a class="subnav-link @NavActive("GoodsIssues")" asp-area="Inventory" asp-controller="GoodsIssues" asp-action="Index">أذون الصرف</a>
                            <a class="subnav-link @NavActive("Transfers")" asp-area="Inventory" asp-controller="Transfers" asp-action="Index">التحويلات</a>
                            <a class="subnav-link @NavActive("Adjustments")" asp-area="Inventory" asp-controller="Adjustments" asp-action="Index">التسويات</a>
                            <a class="subnav-link @NavActive("StockCounts")" asp-area="Inventory" asp-controller="StockCounts" asp-action="Index">الجرد</a>
                            @if (Can(PermissionNames.InventoryReports))
                            {
                                <a class="subnav-link @NavActive("InventoryReports")" asp-area="Inventory" asp-controller="InventoryReports" asp-action="Index">التقارير</a>
                            }
                            @if (Can(PermissionNames.InventoryUpdateCost))
                            {
                                <a class="subnav-link @NavActive("CostUpdates")" asp-area="Inventory" asp-controller="CostUpdates" asp-action="Index">تحديث التكلفة</a>
                            }
                            @if (canInvManage)
                            {
                                <a class="subnav-link @NavActive("Settings", "Inventory")" asp-area="Inventory" asp-controller="Settings" asp-action="Index">الإعدادات</a>
                            }
                        </div>
                    </div>
                }
                @if (Can(PermissionNames.HrView))
                {
                    var hrArea = ViewContext.RouteData.Values["area"]?.ToString();
                    var hrCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                    var hrOpen = hrArea == "Hr";
                    <div class="nav-group @(hrOpen ? "open" : "")">
                        <div class="nav-parent">
                            <a class="nav-link @(hrOpen ? "active" : "")" href="javascript:" onclick="toggleNavGroup(this)"><span>👔</span> الموارد البشرية</a>
                            <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                        </div>
                        <div class="subnav">
                            <a class="subnav-link @(hrOpen && hrCtrl == "Hr" ? "active" : "")" asp-area="Hr" asp-controller="Hr" asp-action="Index">الإعدادات</a>
                            <a class="subnav-link @(hrOpen && hrCtrl == "Employees" ? "active" : "")" asp-area="Hr" asp-controller="Employees" asp-action="Index">الموظفون</a>
                            <a class="subnav-link @(hrOpen && hrCtrl == "Vacations" ? "active" : "")" asp-area="Hr" asp-controller="Vacations" asp-action="Index">الإجازات</a>
                            <a class="subnav-link @(hrOpen && hrCtrl == "LeaveRequests" ? "active" : "")" asp-area="Hr" asp-controller="LeaveRequests" asp-action="Index">إذن تأخير/إنصراف</a>
                            <a class="subnav-link @(hrOpen && hrCtrl == "Advances" ? "active" : "")" asp-area="Hr" asp-controller="Advances" asp-action="Index">السلف</a>
                            <a class="subnav-link @(hrOpen && hrCtrl == "Rewards" ? "active" : "")" asp-area="Hr" asp-controller="Rewards" asp-action="Index">المكافآت</a>
                        </div>
                    </div>
                }
                @if (Can(PermissionNames.ReportsView) || Can(PermissionNames.ReportsProjects))
                {
                    var repArea = ViewContext.RouteData.Values["area"]?.ToString();
                    var repAction = ViewContext.RouteData.Values["action"]?.ToString();
                    // The customers / suppliers reports live under «العملاء» / «الموردين».
                    var repOpen = repArea == "Reports" && repAction is not ("Customers" or "Suppliers");
                    <div class="nav-group @(repOpen ? "open" : "")">
                        <div class="nav-parent">
                            <a class="nav-link @(repOpen ? "active" : "")" href="javascript:" onclick="toggleNavGroup(this)"><span>📑</span> التقارير</a>
                            <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                        </div>
                        <div class="subnav">
                            @if (Can(PermissionNames.ReportsView))
                            {
                                <a class="subnav-link @(repOpen && repAction == "Daily" ? "active" : "")" asp-area="Reports" asp-controller="Reports" asp-action="Daily">التقرير اليومي</a>
                            }
                            @if (Can(PermissionNames.ReportsProjects))
                            {
                                var repCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                                <a class="subnav-link @(repOpen && repCtrl == "ProjectsReport" ? "active" : "")" asp-area="Reports" asp-controller="ProjectsReport" asp-action="Index">تقرير المشاريع</a>
                            }
                        </div>
                    </div>
                }
                @{
                    var tasksArea = ViewContext.RouteData.Values["area"]?.ToString();
                    var tasksAction = ViewContext.RouteData.Values["action"]?.ToString();
                    var tasksOpen = tasksArea == "Tasks";
                    var canTasksView = Can(PermissionNames.TasksView);
                }
                <div class="nav-group @(tasksOpen ? "open" : "")">
                    <div class="nav-parent">
                        <a class="nav-link @(tasksOpen ? "active" : "")" href="javascript:" onclick="toggleNavGroup(this)"><span>📋</span> إدارة المهام</a>
                        <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                    </div>
                    <div class="subnav">
                        @if (canTasksView)
                        {
                            <a class="subnav-link @(tasksOpen && tasksAction != "Mine" ? "active" : "")" asp-area="Tasks" asp-controller="Tasks" asp-action="Index">قائمة المهام</a>
                        }
                        <a class="subnav-link @(tasksOpen && tasksAction == "Mine" ? "active" : "")" asp-area="Tasks" asp-controller="Tasks" asp-action="Mine">مهامي</a>
                    </div>
                </div>
                @if (Can(PermissionNames.TenantsManage))
                {
                    <a class="nav-link @NavActive("Tenants")" asp-area="Admin" asp-controller="Tenants" asp-action="Index"><span>🏙️</span> المؤسسات</a>
                }
                @if (Can(PermissionNames.UsersView))
                {
                    <a class="nav-link @NavActive("Users")" asp-area="Admin" asp-controller="Users" asp-action="Index"><span>👤</span> المستخدمون</a>
                }
                <div class="nav-group @(setOpen ? "open" : "")">
                    <div class="nav-parent">
                        <a class="nav-link @(setOpen ? "active" : "")" href="javascript:" onclick="toggleNavGroup(this)"><span>⚙️</span> الإعدادات</a>
                        <button type="button" class="nav-caret" onclick="toggleNavGroup(this)">▾</button>
                    </div>
                    <div class="subnav">
                        <a class="subnav-link @NavActive("Account")" asp-area="" asp-controller="Account" asp-action="ChangePassword">تغيير كلمة المرور</a>
                        @if (Can(PermissionNames.SettingsManage))
                        {
                            <a class="subnav-link @NavActive("Settings", "")" asp-area="" asp-controller="Settings" asp-action="Branding">بيانات المؤسسة</a>
                            <a class="subnav-link @NavActive("ProjectTypes")" asp-area="Projects" asp-controller="ProjectTypes" asp-action="Index">أنواع المشاريع</a>
                            <a class="subnav-link @NavActive("StageDefinitions")" asp-area="Projects" asp-controller="StageDefinitions" asp-action="Index">مراحل المشاريع</a>
                        }
                        @if (Can(PermissionNames.TxnCategoriesManage))
                        {
                            <a class="subnav-link @NavActive("TxnCategories")" asp-area="" asp-controller="TxnCategories" asp-action="Index">بنود المصروفات والإيرادات</a>
                        }
                        @if (Can(PermissionNames.ActivityLogView))
                        {
                            <a class="subnav-link @NavActive("ActivityLog")" asp-area="Admin" asp-controller="ActivityLog" asp-action="Index">سجل النشاط</a>
                        }
                    </div>
                </div>
            </nav>
        </aside>
        <div class="sb-backdrop" aria-hidden="true"></div>
        <div class="main">
            @* Sticky app bar + page header (breadcrumb, title). *@
            <partial name="_TopNav" />
            <main class="content">
                @RenderBody()
            </main>
            <partial name="_Footer" />

            <!-- Shared add/edit modal (system-wide) -->
            <div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content mk-modal">
                        <div class="modal-header"><h5 id="appModalTitle">—</h5><button type="button" class="mk-close" data-bs-dismiss="modal">✕</button></div>
                        <div class="modal-body" id="appModalBody"></div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="auth-wrap">
            <button type="button" class="theme-toggle auth-theme-toggle" onclick="appToggleTheme(this)" title="تبديل المظهر (نهاري / ليلي)" aria-label="تبديل المظهر">
                <span class="ico-sun">☀️</span><span class="ico-moon">🌙</span>
            </button>
            @RenderBody()
            <partial name="_Footer" />
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    <script src="~/js/loader.js" asp-append-version="true"></script>
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/app-modal.js" asp-append-version="true"></script>
    <script src="~/js/grid.js" asp-append-version="true"></script>
    <script src="~/js/filter-bar.js" asp-append-version="true"></script>
    <script src="~/js/return-doc.js" asp-append-version="true"></script>
    @if (isAuth)
    {
        <script src="~/js/workspace-nav.js" asp-append-version="true"></script>
    }
    @if (TempData["ErrorMessage"] is string appErr)
    {
        <script>window.__appError = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(appErr));</script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
