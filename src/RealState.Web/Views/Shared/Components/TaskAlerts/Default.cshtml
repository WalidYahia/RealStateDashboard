@model int
<a class="tb-icon task-bell @(Model > 0 ? "has" : "")" asp-area="Tasks" asp-controller="Tasks" asp-action="Mine" title="مهامي المُسندة إليّ" aria-label="مهامي المُسندة إليّ@(Model > 0 ? $" ({Model})" : "")">
    @NavIcons.Svg("bell", 19)
    @if (Model > 0)
    {
        <span class="bell-count">@Model</span>
    }
</a>
