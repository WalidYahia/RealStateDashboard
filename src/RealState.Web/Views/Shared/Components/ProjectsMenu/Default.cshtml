@model List<RealState.Web.Components.ProjectMenuItem>
@{
    var currentId = ViewContext.RouteData.Values["id"]?.ToString();
}
@foreach (var p in Model)
{
    <a class="subnav-link @(string.Equals(currentId, p.Id.ToString(), StringComparison.OrdinalIgnoreCase) ? "active" : "")"
       asp-area="Projects" asp-controller="Projects" asp-action="Details" asp-route-id="@p.Id">
        <span class="proj-code">#@p.Code</span> @p.Name
    </a>
}
@if (Model.Count == 0)
{
    <span class="subnav-empty">لا توجد مشاريع</span>
}
