@model RealState.Web.Components.BrandVm
<div class="brand">
    @if (Model.HasLogo)
    {
        <img class="brand-logo" src="@Url.Action("Logo", "Branding", new { area = "", id = Model.Id, v = Model.Version })" alt="@Model.Name" />
    }
    else
    {
        <span class="brand-fallback">@Model.Name</span>
        @* Shown instead of the name while the side menu is collapsed to an icon rail. *@
        <span class="brand-mini" aria-hidden="true">@(string.IsNullOrWhiteSpace(Model.Name) ? "" : Model.Name.Trim()[..1])</span>
    }
</div>
